# SPDX-License-Identifier: MIT
# This file is GENERATED by nixos-generate-config on the actual hardware.
# DO NOT commit your real hardware-configuration.nix — it contains device-specific paths.
# Run: nixos-generate-config --root /mnt
# This example is for documentation only.
{ config, lib, pkgs, modulesPath, ... }:

{
  imports = [ (modulesPath + "/installer/scan/not-detected.nix") ];

  boot.initrd.availableKernelModules = [ "xhci_pci" "ahci" "nvme" "usb_storage" "sd_mod" ];
  boot.initrd.kernelModules = [];
  boot.kernelModules = [ "kvm-amd" ];   # AMD CPU
  boot.extraModulePackages = [];

  # NVMe primary drive — replace with your actual device
  fileSystems."/" = {
    device = "/dev/disk/by-label/nixos";
    fsType = "ext4";
    options = [ "noatime" "nodiratime" ];
  };
  fileSystems."/boot" = {
    device = "/dev/disk/by-label/boot";
    fsType = "vfat";
  };

  swapDevices = [];

  nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";

  # AMD Ryzen — enable CPU microcode updates
  hardware.cpu.amd.updateMicrocode = lib.mkDefault config.hardware.enableRedistributableFirmware;
}
