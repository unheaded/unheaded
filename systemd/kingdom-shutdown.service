# Kingdom Shutdown — ensures clean Unheaded teardown on stop/halt/reboot

[Unit]
Description=Unheaded Kingdom Shutdown (clean teardown on stop/reboot)
Documentation=https://github.com/unheaded/unheaded
After=network-online.target
Before=shutdown.target reboot.target halt.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
ExecStop=/opt/unheaded/bin/kingdom-shutdown.sh --force

# Hardening (S-LOW-FRUIT Phase 3), partial on purpose: the stop script tears
# down docker compose as root (see kingdom-startup.service).
NoNewPrivileges=yes
ProtectSystem=full
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
