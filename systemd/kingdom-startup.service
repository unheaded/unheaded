# Kingdom Startup — start Unheaded Docker containers on boot

[Unit]
Description=Unheaded Kingdom Startup (start containers on boot)
Documentation=https://github.com/unheaded/unheaded
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/unheaded/bin/kingdom-startup.sh --force --docker-only

# Hardening (S-LOW-FRUIT Phase 3), partial on purpose: the script runs docker
# compose as root, so no ProtectHome/PrivateDevices/RestrictNamespaces/
# CapabilityBoundingSet/SystemCallFilter here.
NoNewPrivileges=yes
ProtectSystem=full
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
