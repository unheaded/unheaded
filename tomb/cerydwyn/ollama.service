#
# Systemd unit file for Ollama Local LLM Service
# Tomb of Knowledge — Cerydwyn Layer
#
# Install: sudo cp ollama.service /etc/systemd/system/
#          sudo systemctl daemon-reload
#          sudo systemctl enable --now ollama

[Unit]
Description=Ollama Local LLM Service — Tomb of Knowledge Cerydwyn
Documentation=https://github.com/unheaded/unheaded
After=network.target local-fs.target
Wants=local-fs.target

[Service]
Type=simple
User=ollama
Group=ollama

ExecStartPre=/bin/mkdir -p /var/lib/ollama/models
ExecStart=/opt/ollama/bin/ollama serve
ExecReload=/bin/kill -HUP $MAINPID

Restart=on-failure
RestartSec=10
TimeoutStartSec=60
TimeoutStopSec=30

# Environment
Environment="OLLAMA_MODELS=/var/lib/ollama/models"
Environment="OLLAMA_HOST=127.0.0.1:11434"
Environment="OLLAMA_KEEP_ALIVE=24h"
Environment="OLLAMA_NUM_PARALLEL=1"
Environment="OLLAMA_MAX_LOADED_MODELS=1"

# Resource limits (Tomb VM has limited RAM — 8GB DDR3)
LimitNOFILE=65536
LimitMEMLOCK=infinity
MemoryMax=6G
CPUQuota=90%

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ollama
ReadOnlyPaths=/opt/ollama
PrivateDevices=false
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictRealtime=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ollama

[Install]
WantedBy=multi-user.target
