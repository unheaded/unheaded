# Tomb of Knowledge -- Grafana configuration
# Managed by Ansible -- do not edit manually

[server]
http_addr = 127.0.0.1
http_port = {{ grafana_port }}
protocol = http
domain = tomb.local

[database]
type = sqlite3
path = {{ tomb_root }}/dark-mirror/grafana/grafana.db

[security]
admin_user = blackmage
admin_password = changeme-on-first-boot
disable_gravatar = true
cookie_secure = false

[auth.anonymous]
enabled = true
org_role = Viewer

[dashboards]
default_home_dashboard_path = {{ tomb_root }}/dark-mirror/grafana/dashboards/kingdom-overview.json

[paths]
data = {{ tomb_root }}/dark-mirror/grafana
logs = {{ tomb_root }}/dark-mirror/grafana/logs
plugins = {{ tomb_root }}/dark-mirror/grafana/plugins
provisioning = {{ tomb_root }}/dark-mirror/grafana/provisioning

[analytics]
reporting_enabled = false
check_for_updates = false
