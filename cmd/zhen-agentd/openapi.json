{
  "openapi": "3.0.3",
  "info": {
    "title": "zhen-agentd",
    "description": "Phase D-A agent runtime daemon. Multi-turn ReAct loop wrapping cs/vor + llama-server, gated by Champion's three-rule trust + destructive-verb defense.",
    "version": "1.0.0",
    "license": {
      "name": "GPL-3.0-or-later",
      "url": "https://www.gnu.org/licenses/gpl-3.0.html"
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:20105",
      "description": "Loopback default — production deploys behind a TLS-terminating sidecar."
    }
  ],
  "components": {
    "securitySchemes": {
      "ApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Static API key configured via AUTH_API_KEYS env. Required when AUTH_ENABLED=true."
      },
      "BearerJWT": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT signed with AUTH_JWT_KEY. Required when AUTH_ENABLED=true."
      }
    },
    "schemas": {
      "MemoryRecord": {"type": "object", "properties": {"id": {"type": "integer", "format": "int64"}, "question": {"type": "string"}, "answer": {"type": "string"}, "source": {"type": "string", "description": "Provenance: the principal that wrote the row (ui:<subject>), or 'user' for rows from the Python web app"}, "model": {"type": "string"}, "created_at": {"type": "string", "format": "date-time"}, "score": {"type": "number", "description": "Full-text rank (recall only)"}}},
      "RememberRequest": {"type": "object", "required": ["answer"], "properties": {"question": {"type": "string", "maxLength": 16384}, "answer": {"type": "string", "maxLength": 16384}, "model": {"type": "string"}, "emitted_by": {"type": "string", "description": "Audit label, e.g. zhen-cli"}, "session_id": {"type": "string"}}},
      "ModelStatus": {"type": "object", "description": "scripts/switch-model.sh --json --status", "properties": {"active": {"type": "string", "nullable": true}, "pid": {"type": "integer", "nullable": true}, "port": {"type": "integer"}, "gguf": {"type": "string", "nullable": true}, "models": {"type": "array", "items": {"type": "object", "properties": {"key": {"type": "string"}, "name": {"type": "string"}, "file": {"type": "string"}, "present": {"type": "boolean"}, "pinned": {"type": "boolean"}, "load_seconds": {"type": "number"}}}}, "fit": {"type": "object", "nullable": true}}},
      "AskRequest": {
        "type": "object",
        "required": ["goal"],
        "properties": {
          "goal": {"type": "string", "description": "User goal for the agent"},
          "project_root": {"type": "string", "description": "Project root the request targets; must be in the daemon's allow-list"},
          "session_id": {"type": "string", "description": "Audit-log correlation id; auto-generated if omitted"},
          "k": {"type": "integer", "description": "Top-K retrieval count", "minimum": 1, "default": 5},
          "max_tokens": {"type": "integer", "minimum": 1, "default": 600},
          "max_turns": {"type": "integer", "minimum": 1, "default": 8},
          "temperature": {"type": "number", "minimum": 0, "maximum": 2, "default": 0.4},
          "seed": {"type": "integer", "description": "Nonzero pins LLM sampling for reproducibility"}
        }
      },
      "AskResponse": {
        "type": "object",
        "required": ["answer", "turns_used", "budget_hit", "trace", "session_id"],
        "properties": {
          "answer": {"type": "string"},
          "turns_used": {"type": "integer"},
          "budget_hit": {"type": "boolean"},
          "session_id": {"type": "string"},
          "trace": {"type": "array", "items": {"$ref": "#/components/schemas/TraceEntry"}}
        }
      },
      "TraceEntry": {
        "type": "object",
        "properties": {
          "thought": {"type": "string"},
          "tool": {"type": "string"},
          "args": {"type": "object", "additionalProperties": true},
          "observation": {"type": "string"},
          "answer": {"type": "string"},
          "refused": {"type": "boolean"},
          "pending_confirmation": {"type": "boolean"},
          "pending_token": {"type": "string", "description": "Single-use token for /api/v1/agent/confirm; only under -ask-tokens (legacy)"},
          "queue_id": {"type": "string", "description": "Out-of-band approval queue id (zhen-claude confirm approve <id>), with -confirm-queue"}
        }
      },
      "ConfirmRequest": {
        "type": "object",
        "required": ["token"],
        "properties": {
          "token": {"type": "string"},
          "project_root": {"type": "string"}
        }
      },
      "ConfirmResponse": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {"type": "string", "enum": ["ok", "expired", "unknown", "used", "denied", "error"]},
          "result": {"description": "Tool output (shape varies by tool)"},
          "reason": {"type": "string"}
        }
      },
      "Reference": {
        "type": "object",
        "description": "Source-trust-tagged reference. Caller-supplied chain expressing what the tool call is grounded in. source_trust=\"direct-user\" is the Rule 2 escape for explicit user actions.",
        "properties": {
          "topic":        {"type": "string"},
          "category":     {"type": "string"},
          "source_kind":  {"type": "string", "enum": ["embedded", "user-custom", "user-source", "user-action"]},
          "source_trust": {"type": "string", "enum": ["canonical", "local", "external", "direct-user"]},
          "source_path":  {"type": "string"},
          "source_label": {"type": "string"}
        }
      },
      "ToolExecResponse": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status":        {"type": "string", "enum": ["ok", "denied", "pending_confirmation", "unknown", "used", "expired", "error"]},
          "result":        {"description": "Tool output on status=ok (shape varies by tool)"},
          "reason":        {"type": "string"},
          "pending_token": {"type": "string", "description": "Single-use token; redeem at /api/v1/agent/confirm"},
          "session_id":    {"type": "string"}
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {"type": "string"}
        }
      },
      "ReadyResponse": {
        "type": "object",
        "required": ["ready", "vor_reachable", "llama_reachable"],
        "properties": {
          "ready": {"type": "boolean"},
          "vor_reachable": {"type": "boolean"},
          "llama_reachable": {"type": "boolean"},
          "detail": {"type": "string"}
        }
      }
    }
  },
  "paths": {
    "/api/v1/memory/recall": {"get": {"summary": "Recall remembered answers (zhen-cli /recall)", "description": "Full-text ranked rows from unheaded_app.zhen_memories, with provenance. Needs -memory-store pg.", "security": [{"ApiKey": []}, {"BearerJWT": []}], "parameters": [{"name": "q", "in": "query", "required": true, "schema": {"type": "string", "maxLength": 512}}, {"name": "k", "in": "query", "required": false, "schema": {"type": "integer", "minimum": 1, "maximum": 20, "default": 5}}], "responses": {"200": {"description": "Ranked rows", "content": {"application/json": {"schema": {"type": "object", "properties": {"memories": {"type": "array", "items": {"$ref": "#/components/schemas/MemoryRecord"}}}}}}}, "400": {"description": "Bad q or k", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}}, "401": {"description": "Auth required"}, "503": {"description": "No memory store configured", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}}}}},
    "/api/v1/memory/remember": {"post": {"summary": "Remember an answer (zhen-cli /remember)", "description": "Writes one zhen_memories row through the Champion gate as the mutating tool memory_write: an authenticated caller's request carries a direct-user justification; Rule 3 refuses destructive verbs in the text. A request without an authenticated principal is refused. Response shapes as /api/v1/tool/exec.", "security": [{"ApiKey": []}, {"BearerJWT": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RememberRequest"}}}}, "responses": {"200": {"description": "Stored; result is {id}", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ToolExecResponse"}}}}, "400": {"description": "Missing answer or bad body", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}}, "401": {"description": "Auth required"}, "403": {"description": "Gate refused (destructive verb) or no authenticated principal", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ToolExecResponse"}}}}, "503": {"description": "No memory store configured", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}}}}},
    "/api/v1/models": {"get": {"summary": "Model selector state (zhen-cli /model)", "description": "scripts/switch-model.sh --json --status under the default project root: the key llama-server serves and the allowlisted keys with documented load times. A swap is POST /api/v1/tool/exec tool=model_switch.", "security": [{"ApiKey": []}, {"BearerJWT": []}], "responses": {"200": {"description": "Status", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ModelStatus"}}}}, "401": {"description": "Auth required"}, "502": {"description": "The script failed or printed no JSON", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}}}}},
    "/health": {
      "get": {
        "summary": "Liveness probe",
        "description": "Always returns 200 once the listener is up. Bypasses auth and rate-limit.",
        "responses": {
          "200": {
            "description": "Daemon is alive",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {"status": {"type": "string", "example": "ok"}}
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "summary": "Readiness probe",
        "description": "Verifies vor and llama-server are reachable. Cached 5s. Bypasses auth and rate-limit.",
        "responses": {
          "200": {
            "description": "All backends reachable",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ReadyResponse"}}}
          },
          "503": {
            "description": "One or more backends unreachable",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ReadyResponse"}}}
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Prometheus metrics",
        "description": "Exposition format. Counters/histograms in zhen_agentd_* namespace. Bypasses auth and rate-limit.",
        "responses": {
          "200": {
            "description": "Prometheus exposition",
            "content": {"text/plain; version=0.0.4": {}}
          }
        }
      }
    },
    "/api/v1/openapi.json": {
      "get": {
        "summary": "This OpenAPI spec",
        "responses": {
          "200": {
            "description": "OpenAPI 3.0 document",
            "content": {"application/json": {}}
          }
        }
      }
    },
    "/api/v1/agent/ask": {
      "post": {
        "summary": "Run the agent loop on a user goal",
        "description": "Multi-turn ReAct loop. Returns a final answer plus per-turn trace; refused tool calls surface single-use confirmation tokens for /api/v1/agent/confirm.",
        "security": [{"ApiKey": []}, {"BearerJWT": []}],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AskRequest"}}}
        },
        "responses": {
          "200": {
            "description": "Agent run completed (gracefully or budget-hit)",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AskResponse"}}}
          },
          "400": {
            "description": "Validation error",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}
          },
          "401": {"description": "Auth required"},
          "403": {
            "description": "project_root not in allow-list",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}
          },
          "429": {
            "description": "Rate limit exceeded",
            "headers": {"Retry-After": {"schema": {"type": "string"}}}
          },
          "500": {
            "description": "Internal error (LLM unreachable, retriever errored)",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}
          }
        }
      }
    },
    "/api/v1/agent/ask/stream": {
      "post": {
        "summary": "Run the agent loop with per-turn SSE streaming",
        "description": "Same request body as /ask but streams Server-Sent Events as the loop progresses. Each turn fires an `event: turn` with the TraceEntry payload; the loop terminates with an `event: done` carrying the final answer + summary. On error, an `event: error` is emitted instead. Clients that disconnect mid-stream cause the loop to bail at the next turn boundary.",
        "security": [{"ApiKey": []}, {"BearerJWT": []}],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AskRequest"}}}
        },
        "responses": {
          "200": {
            "description": "Server-Sent Events stream — `event: turn` per agent turn, terminated by `event: done` (success) or `event: error` (failure).",
            "content": {"text/event-stream": {}}
          },
          "400": {
            "description": "Validation error",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}}
          },
          "401": {"description": "Auth required"},
          "403": {"description": "project_root not in allow-list"},
          "429": {"description": "Rate limit exceeded"}
        }
      }
    },
    "/api/v1/tool/exec": {
      "post": {
        "summary": "Direct Champion tool dispatch (no LLM)",
        "description": "WAVE15 Phase 2b mutation-path proxy. The web UI hits this when the user explicitly invokes a kingdom-altering action (e.g., 'Execute runbook X'). Bypasses the LLM entirely — caller specifies the tool + args directly. Champion's three rules still gate the request. `justification` is required for a direct caller (400 `justification required` without one); a user action sends `source_trust: \"direct-user\"` (Rule 2 escape). Agent loops (`emitted_by` zhen-agent*) cannot assert direct-user.",
        "security": [{"ApiKey": []}, {"BearerJWT": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["tool"],
                "properties": {
                  "tool":          {"type": "string", "description": "Tool name (e.g., runbook_execute, kanban_create)"},
                  "args":          {"type": "object", "additionalProperties": true},
                  "project_root":  {"type": "string"},
                  "session_id":    {"type": "string"},
                  "emitted_by":    {"type": "string"},
                  "justification": {"type": "array", "items": {"$ref": "#/components/schemas/Reference"}}
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tool ran successfully",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ToolExecResponse"}}}
          },
          "400": {"description": "Validation error"},
          "401": {"description": "Auth required"},
          "403": {
            "description": "Gate refused — either denied (status=\"denied\") or pending user confirmation (status=\"pending_confirmation\", with pending_token)",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ToolExecResponse"}}}
          },
          "429": {"description": "Rate limit exceeded"},
          "500": {
            "description": "Underlying tool execution failed (post-gate)",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ToolExecResponse"}}}
          }
        }
      }
    },
    "/api/v1/agent/confirm": {
      "post": {
        "summary": "Redeem a pending-confirmation token",
        "description": "Re-runs a tool call that was refused with pending_confirmation=true. Rule 2 (untrusted justification) is suppressed; Rules 1 (path-allowlist) and 3 (destructive verb) still fire. Tokens are single-use, 5-minute TTL, and bound to the authenticated principal whose request caused them: only that principal redeems one.",
        "security": [{"ApiKey": []}, {"BearerJWT": []}],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ConfirmRequest"}}}
        },
        "responses": {
          "200": {
            "description": "Token redeemed; tool call ran",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ConfirmResponse"}}}
          },
          "400": {
            "description": "Token unknown / used / expired",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ConfirmResponse"}}}
          },
          "401": {"description": "Auth required"},
          "403": {
            "description": "Gate refused even after confirm (destructive verb / path outside allowlist), the caller is not the principal the token was issued to, or the daemon runs without auth (no principal can confirm)",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ConfirmResponse"}}}
          },
          "429": {"description": "Rate limit exceeded"}
        }
      }
    }
  }
}
