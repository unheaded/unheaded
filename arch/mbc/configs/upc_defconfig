#
# UPC default configuration — minimal nommu boot
#
# This is the baseline defconfig for the Unheaded Protocol Computer
# running the MBC (Monad Bytecode) architecture.  It targets a nommu
# environment with a 4 MB ramdisk root filesystem.
#

# Architecture
CONFIG_MBC=y
CONFIG_CPU_MBC=y
# CONFIG_MMU is not set

# General
CONFIG_EMBEDDED=y
CONFIG_EXPERT=y
CONFIG_PRINTK=y
CONFIG_BUG=y

# Timer
CONFIG_HZ=12
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=n

# Console / TTY
CONFIG_TTY=y
CONFIG_SERIAL_MBC=y
CONFIG_SERIAL_MBC_CONSOLE=y

# Block device
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_MBC_RAMDISK=y

# File systems
CONFIG_ROMFS_FS=y
CONFIG_ROMFS_BACKED_BY_BLOCK=y

# nommu-specific
CONFIG_BINFMT_FLAT=y
CONFIG_BINFMT_FLAT_NO_DATA_START_OFFSET=y

# Memory
CONFIG_FLATMEM=y
CONFIG_FLAT_NODE_MEM_MAP=y

# Disable features not available on UPC
# CONFIG_SWAP is not set
# CONFIG_MODULES is not set
# CONFIG_SMP is not set
# CONFIG_NUMA is not set
# CONFIG_HIGHMEM is not set
# CONFIG_NET is not set
# CONFIG_SOUND is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_WIRELESS is not set
# CONFIG_INPUT is not set
