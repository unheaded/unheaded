{
  "ociVersion": "1.1.0",
  "metadata": {
    "name": "kanban",
    "description": "Kanban App - The Meta Moment (Unheaded building Unheaded)",
    "labels": {
      "io.unheaded.service": "kanban-app",
      "io.unheaded.tier": "application",
      "io.unheaded.public": "true",
      "io.unheaded.ip": "10.10.10.200"
    }
  },
  "image": {
    "ref": "ghcr.io/unheaded/kanban-app:latest"
  },
  "process": {
    "terminal": false,
    "user": {
      "uid": 1000,
      "gid": 1000
    },
    "args": ["/app/kanban-app"],
    "env": [
      "SERVICE_NAME=kanban-app",
      "KANBAN_ADDR=0.0.0.0:8080",
      "KANBAN_TIMEGURU_URL=http://10.10.10.20:8000",
      "KANBAN_PUBLIC=true",
      "WOTAN_ADDR=10.10.10.10:9090",
      "WOTAN_HTTP_ADDR=http://10.10.10.10:8080",
      "LOG_LEVEL=info",
      "METRICS_ADDR=0.0.0.0:9100",
      "GOGC=100",
      "GOMAXPROCS=2"
    ],
    "cwd": "/app",
    "noNewPrivileges": true
  },
  "root": {
    "path": "rootfs",
    "readonly": true
  },
  "mounts": [
    {
      "destination": "/data",
      "type": "bind",
      "source": "/var/lib/unheaded/kanban",
      "options": ["rbind", "rw"]
    },
    {
      "destination": "/tmp",
      "type": "tmpfs",
      "source": "tmpfs",
      "options": ["nosuid", "nodev", "noexec", "size=64m"]
    },
    {
      "destination": "/proc",
      "type": "proc",
      "source": "proc"
    }
  ],
  "linux": {
    "resources": {
      "memory": {
        "limit": 536870912
      },
      "cpu": {
        "quota": 100000,
        "period": 100000
      },
      "pids": {
        "limit": 512
      }
    },
    "namespaces": [
      { "type": "pid" },
      { "type": "ipc" },
      { "type": "uts" },
      { "type": "mount" },
      { "type": "network" }
    ],
    "maskedPaths": [
      "/proc/asound", "/proc/acpi", "/proc/kcore", "/proc/keys",
      "/proc/latency_stats", "/proc/timer_list", "/proc/timer_stats",
      "/proc/sched_debug", "/proc/scsi", "/sys/firmware"
    ],
    "readonlyPaths": [
      "/proc/bus", "/proc/fs", "/proc/irq", "/proc/sys",
      "/proc/sysrq-trigger"
    ]
  },
  "annotations": {
    "io.unheaded.healthcheck.cmd": "wget -qO- http://localhost:8080/health || exit 1",
    "io.unheaded.healthcheck.interval": "30s",
    "io.unheaded.healthcheck.timeout": "5s",
    "io.unheaded.healthcheck.retries": "3",
    "io.unheaded.ports": "8080/tcp,9100/tcp",
    "io.unheaded.network.ip": "10.10.10.200",
    "io.unheaded.network.bridge": "br-unheaded",
    "io.unheaded.restart.policy": "always",
    "io.unheaded.restart.delay": "5s",
    "io.unheaded.depends_on": "wotan,timeguru"
  }
}
