{
  "ociVersion": "1.1.0",
  "metadata": {
    "name": "wotan",
    "description": "Wotan Message Bus - gRPC + REST + Ring Buffer",
    "labels": {
      "io.unheaded.service": "wotan",
      "io.unheaded.tier": "infrastructure",
      "io.unheaded.critical": "true",
      "io.unheaded.ip": "10.10.10.10"
    }
  },
  "image": {
    "ref": "ghcr.io/unheaded/wotan:latest"
  },
  "process": {
    "terminal": false,
    "user": {
      "uid": 1000,
      "gid": 1000
    },
    "args": [
      "/app/wotan",
      "--grpc-addr=0.0.0.0:18001",
      "--http-addr=0.0.0.0:18000",
      "--metrics-addr=0.0.0.0:9100"
    ],
    "env": [
      "SERVICE_NAME=wotan",
      "WOTAN_ADDR=10.10.10.10:18001",
      "WOTAN_HTTP_ADDR=http://10.10.10.10:18000",
      "WOTAN_DATA_DIR=/data",
      "WOTAN_LOG_LEVEL=info",
      "WOTAN_RING_BUFFER_SIZE=10000",
      "WOTAN_MAX_SUBSCRIBERS=1000",
      "LOG_LEVEL=info",
      "METRICS_ADDR=0.0.0.0:9100",
      "GOGC=100",
      "GOMAXPROCS=2"
    ],
    "cwd": "/app",
    "noNewPrivileges": true
  },
  "root": {
    "path": "rootfs",
    "readonly": true
  },
  "mounts": [
    {
      "destination": "/data",
      "type": "bind",
      "source": "/var/lib/unheaded/wotan",
      "options": ["rbind", "rw"]
    },
    {
      "destination": "/tmp",
      "type": "tmpfs",
      "source": "tmpfs",
      "options": ["nosuid", "nodev", "noexec", "size=64m"]
    },
    {
      "destination": "/proc",
      "type": "proc",
      "source": "proc"
    }
  ],
  "linux": {
    "resources": {
      "memory": {
        "limit": 1073741824
      },
      "cpu": {
        "quota": 200000,
        "period": 100000
      },
      "pids": {
        "limit": 1024
      }
    },
    "namespaces": [
      { "type": "pid" },
      { "type": "ipc" },
      { "type": "uts" },
      { "type": "mount" },
      { "type": "network" }
    ],
    "seccomp": {
      "defaultAction": "SCMP_ACT_ERRNO",
      "architectures": ["SCMP_ARCH_X86_64"],
      "syscalls": [
        {
          "names": [
            "accept", "accept4", "bind", "brk", "chdir", "clock_getres",
            "clock_gettime", "clock_nanosleep", "clone", "close", "connect",
            "dup", "dup2", "dup3", "epoll_create", "epoll_create1",
            "epoll_ctl", "epoll_wait", "epoll_pwait", "eventfd", "eventfd2",
            "execve", "exit", "exit_group", "faccessat", "fadvise64",
            "fallocate", "fchmod", "fchmodat", "fchown", "fchownat",
            "fcntl", "fdatasync", "flock", "fstat", "fstatfs", "fsync",
            "ftruncate", "futex", "getcwd", "getdents", "getdents64",
            "getegid", "geteuid", "getgid", "getpeername", "getpgrp",
            "getpid", "getppid", "getpriority", "getrandom", "getrlimit",
            "getrusage", "getsockname", "getsockopt", "gettid",
            "gettimeofday", "getuid", "ioctl", "kill", "listen", "lseek",
            "madvise", "membarrier", "memfd_create", "mincore", "mkdirat",
            "mmap", "mprotect", "mremap", "msgctl", "msgget", "msgsnd",
            "msgrcv", "munmap", "nanosleep", "newfstatat", "openat",
            "pipe", "pipe2", "poll", "ppoll", "pread64", "preadv",
            "prlimit64", "pwrite64", "pwritev", "read", "readlinkat",
            "readv", "recvfrom", "recvmmsg", "recvmsg", "renameat",
            "restart_syscall", "rt_sigaction", "rt_sigprocmask",
            "rt_sigreturn", "sched_getaffinity", "sched_yield",
            "select", "sendfile", "sendmmsg", "sendmsg", "sendto",
            "set_robust_list", "set_tid_address", "setsockopt",
            "shutdown", "sigaltstack", "socket", "socketpair", "splice",
            "statfs", "statx", "sysinfo", "tgkill", "timer_create",
            "timer_delete", "timer_getoverrun", "timer_gettime",
            "timer_settime", "timerfd_create", "timerfd_gettime",
            "timerfd_settime", "umask", "uname", "unlinkat", "utimensat",
            "wait4", "waitid", "write", "writev"
          ],
          "action": "SCMP_ACT_ALLOW"
        }
      ]
    },
    "maskedPaths": [
      "/proc/asound",
      "/proc/acpi",
      "/proc/kcore",
      "/proc/keys",
      "/proc/latency_stats",
      "/proc/timer_list",
      "/proc/timer_stats",
      "/proc/sched_debug",
      "/proc/scsi",
      "/sys/firmware"
    ],
    "readonlyPaths": [
      "/proc/bus",
      "/proc/fs",
      "/proc/irq",
      "/proc/sys",
      "/proc/sysrq-trigger"
    ]
  },
  "annotations": {
    "io.unheaded.healthcheck.cmd": "wget -qO- http://localhost:18000/health || exit 1",
    "io.unheaded.healthcheck.interval": "30s",
    "io.unheaded.healthcheck.timeout": "5s",
    "io.unheaded.healthcheck.retries": "3",
    "io.unheaded.ports": "18001/tcp,18000/tcp,9100/tcp",
    "io.unheaded.network.ip": "10.10.10.10",
    "io.unheaded.network.bridge": "br-unheaded",
    "io.unheaded.restart.policy": "always",
    "io.unheaded.restart.delay": "5s"
  }
}
