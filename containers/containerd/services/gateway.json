{
  "ociVersion": "1.1.0",
  "metadata": {
    "name": "gateway",
    "description": "Gateway - nginx Reverse Proxy with TLS 1.3 and HTTP/3",
    "labels": {
      "io.unheaded.service": "gateway",
      "io.unheaded.tier": "infrastructure",
      "io.unheaded.critical": "true",
      "io.unheaded.public": "true",
      "io.unheaded.ip": "10.10.10.100"
    }
  },
  "image": {
    "ref": "ghcr.io/unheaded/gateway:latest"
  },
  "process": {
    "terminal": false,
    "user": {
      "uid": 1000,
      "gid": 1000
    },
    "args": [
      "/usr/sbin/nginx",
      "-c", "/etc/nginx/nginx.conf",
      "-g", "daemon off;"
    ],
    "env": [
      "SERVICE_NAME=gateway",
      "WOTAN_ADDR=10.10.10.10:18001",
      "WOTAN_HTTP_ADDR=http://10.10.10.10:18000",
      "LOG_LEVEL=info"
    ],
    "cwd": "/",
    "noNewPrivileges": true,
    "capabilities": {
      "bounding": ["CAP_NET_BIND_SERVICE"],
      "effective": ["CAP_NET_BIND_SERVICE"],
      "permitted": ["CAP_NET_BIND_SERVICE"]
    }
  },
  "root": {
    "path": "rootfs",
    "readonly": true
  },
  "mounts": [
    {
      "destination": "/var/lib/unheaded/gateway",
      "type": "bind",
      "source": "/var/lib/unheaded/gateway",
      "options": ["rbind", "rw"]
    },
    {
      "destination": "/var/log/unheaded/gateway",
      "type": "bind",
      "source": "/var/log/unheaded/gateway",
      "options": ["rbind", "rw"]
    },
    {
      "destination": "/etc/unheaded/tls",
      "type": "bind",
      "source": "/etc/unheaded/tls",
      "options": ["rbind", "ro"]
    },
    {
      "destination": "/etc/nginx",
      "type": "bind",
      "source": "/etc/unheaded/gateway/nginx",
      "options": ["rbind", "ro"]
    },
    {
      "destination": "/run/nginx",
      "type": "tmpfs",
      "source": "tmpfs",
      "options": ["nosuid", "nodev", "noexec", "size=16m"]
    },
    {
      "destination": "/tmp",
      "type": "tmpfs",
      "source": "tmpfs",
      "options": ["nosuid", "nodev", "noexec", "size=64m"]
    },
    {
      "destination": "/proc",
      "type": "proc",
      "source": "proc"
    }
  ],
  "linux": {
    "resources": {
      "memory": {
        "limit": 536870912
      },
      "cpu": {
        "quota": 150000,
        "period": 100000
      },
      "pids": {
        "limit": 512
      }
    },
    "namespaces": [
      { "type": "pid" },
      { "type": "ipc" },
      { "type": "uts" },
      { "type": "mount" },
      { "type": "network" }
    ],
    "maskedPaths": [
      "/proc/asound", "/proc/acpi", "/proc/kcore", "/proc/keys",
      "/proc/latency_stats", "/proc/timer_list", "/proc/timer_stats",
      "/proc/sched_debug", "/proc/scsi", "/sys/firmware"
    ],
    "readonlyPaths": [
      "/proc/bus", "/proc/fs", "/proc/irq", "/proc/sys",
      "/proc/sysrq-trigger"
    ]
  },
  "annotations": {
    "io.unheaded.healthcheck.cmd": "wget -qO- http://localhost:80/health || exit 1",
    "io.unheaded.healthcheck.interval": "30s",
    "io.unheaded.healthcheck.timeout": "5s",
    "io.unheaded.healthcheck.retries": "3",
    "io.unheaded.ports": "80/tcp,443/tcp,9100/tcp",
    "io.unheaded.network.ip": "10.10.10.100",
    "io.unheaded.network.bridge": "br-unheaded",
    "io.unheaded.restart.policy": "always",
    "io.unheaded.restart.delay": "5s",
    "io.unheaded.depends_on": "wotan,timeguru,captain,micromanager,architect,monad,sophia"
  }
}
