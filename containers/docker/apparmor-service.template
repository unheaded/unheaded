# Unheaded Service AppArmor Profile Template
# Load: sudo apparmor_parser -r /etc/apparmor.d/unheaded-SERVICE
# Verify: sudo aa-status | grep unheaded

#include <tunables/global>

profile unheaded-SERVICE flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  # Network — allow TCP/UDP for service communication
  network inet stream,
  network inet dgram,
  network inet6 stream,
  network inet6 dgram,

  # Service binary — read and execute
  /app/SERVICE mr,

  # Read-only access to configuration
  /etc/unheaded/** r,
  /etc/ssl/certs/** r,
  /etc/ca-certificates/** r,

  # Write access — logs and state only
  /var/log/unheaded/** rw,
  /var/spool/unheaded/** rw,

  # Temp files
  /tmp/** rw,

  # Go runtime needs
  /proc/sys/net/core/somaxconn r,
  /proc/self/exe r,
  /sys/kernel/mm/transparent_hugepage/hpage_pmd_size r,

  # Deny — sensitive files
  deny /etc/shadow r,
  deny /etc/gshadow r,
  deny /etc/passwd w,
  deny /root/** rwx,
  deny /home/** rwx,

  # Deny — dangerous operations
  deny mount,
  deny umount,
  deny ptrace,
  deny signal (send) set=(kill, term) peer=unconfined,
}
