#!/usr/bin/make -f
# SPDX-License-Identifier: GPL-3.0-or-later
#
# debian/rules: the source-package path builds through
# scripts/build-all-debs.sh, the one packager (S-IRON-GATE Phase 14). Its
# package table (scripts/lib/deb-packages.sh) also generates debian/control
# (`scripts/build-all-debs.sh --control > debian/control`), and it writes the
# units, sysusers lines and maintainer scripts, so nothing here repeats them
# and no debhelper is involved.
#
#   dpkg-buildpackage -b -us -uc -d     # -d: Go from /usr/local/go, not golang-go

VERSION := $(shell dpkg-parsechangelog -S Version)
OUT := $(CURDIR)/debian/out

build build-arch build-indep:
	@:

binary binary-arch binary-indep:
	rm -rf $(OUT)
	DEB_OUTPUT_DIR=$(OUT) ./scripts/build-all-debs.sh $(VERSION)
	for d in $(OUT)/*.deb; do \
		b=$$(basename $$d); mv $$d ../$$b; dpkg-distaddfile $$b admin optional; \
	done

clean:
	rm -rf $(OUT) debian/files

.PHONY: build build-arch build-indep binary binary-arch binary-indep clean
