#!/bin/sh
set -e
KEYGEN=/opt/unheaded/bin/unheaded-keygen
KEYDIR=/etc/unheaded/keys
case "$1" in
configure)
	systemd-sysusers /usr/lib/sysusers.d/unheaded-wotan.conf
	if [ ! -e "$KEYDIR/wotan.key" ]; then
		"$KEYGEN" -owner unheaded-wotan wotan
	fi
	systemctl daemon-reload
	systemctl try-restart unheaded-wotan.service || true
	;;
esac
# Generated: `deb_postinst unheaded-wotan wotan unheaded-wotan` from
# scripts/lib/deb-maintscripts.sh (the one source for every service's
# postinst; scripts/test-deb-maintscripts.sh fails when this copy drifts).
# The account comes from deploy/sysusers.d (unheaded-wotan), never a shared
# "unheaded" user; the unit is deploy/systemd/unheaded-wotan.service.

#DEBHELPER#
