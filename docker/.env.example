# docker/.env.example — Example environment configuration (copy to .env for host-specific overrides)

# Docker Compose project configuration
COMPOSE_PROJECT_NAME=unheaded

# Logging and observability
UNHEADED_LOG_LEVEL=info
UNHEADED_TRACE_ENABLED=true
UNHEADED_METRICS_ENABLED=true

# Version information
VERSION=dev
BUILD_DATE=2026-02-26T00:00:00Z
COMMIT=unknown

# Network configuration
UNHEADED_NETWORK_MTU=1380
UNHEADED_IPV6_PREFIX=fd00:dead:beef::/48

# WireGuard configuration (Host-A server)
WG_SERVERURL=auto
WG_SERVERPORT=51820
WG_PEERS=1
WG_INTERFACE=wg0

# WireGuard configuration (Host-B client)
# Uncomment and fill on Host-B only:
# WG_CLIENT_ENDPOINT=<host-a-ip-or-fqdn>:51820
# WG_CLIENT_PRIVATE_KEY=<base64-key>
# WG_CLIENT_ADDRESS=fd00:dead:beef::2/48

# vLLM/ROCm configuration
VLLM_MODEL=/models/deepseek-r1-7b-q4
VLLM_PORT=20100
VLLM_DTYPE=half
VLLM_GPU_MEMORY_UTILIZATION=0.90
VLLM_MAX_MODEL_LEN=8192
ROCM_VERSION=6.1.3
VLLM_VERSION=0.4.3

# AMD ROCm GPU configuration (gfx1101 for RX 7700 XT)
HSA_OVERRIDE_GFX_VERSION=11.0.1
PYTORCH_ROCM_ARCH=gfx1101
HIP_VISIBLE_DEVICES=0

# Container resource limits
CONTAINER_MEMORY_LIMIT=14g
CONTAINER_CPU_LIMIT=8.0
CONTAINER_SHM_SIZE=4g

# Port mappings
WIREGUARD_PORT=51820
VLLM_API_PORT=20100
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Security and compliance
COMPOSE_PROFILES=default
ENABLE_EBPF_SERVICES=true
ENABLE_SECURITY_AUDIT=true

# Host-specific (uncomment for Host-A or Host-B)
# UNHEADED_ROLE=primary        # Host-A (Forge)
# UNHEADED_ROLE=edge           # Host-B (Outpost)

# Model caching
MODEL_CACHE_DIR=/mnt/models
MODEL_CACHE_SIZE=100g

# Database configuration (if applicable)
# DB_HOST=unheaded-database
# DB_PORT=5432
# DB_NAME=unheaded
# DB_USER=unheaded
# DB_PASSWORD=<set-via-secrets>

# Registry configuration
REGISTRY=ghcr.io/stevenrbellis/unheaded
REGISTRY_USERNAME=<if-needed>
# REGISTRY_PASSWORD=<set-via-secrets>
