# docker/.env.shared — Shared environment variables for all Unheaded hosts

# Docker Compose project configuration
COMPOSE_PROJECT_NAME=unheaded

# Logging and observability
UNHEADED_LOG_LEVEL=info
UNHEADED_TRACE_ENABLED=true
UNHEADED_METRICS_ENABLED=true

# Version information
VERSION=dev
BUILD_DATE=2026-02-26T00:00:00Z

# Network configuration
UNHEADED_NETWORK_MTU=1380
UNHEADED_IPV6_PREFIX=fd00:dead:beef::/48

# WireGuard configuration
WG_SERVERURL=auto
WG_PEERS=1
WG_INTERFACE=wg0

# vLLM/ROCm configuration
VLLM_MODEL=/models/deepseek-r1-7b-q4
VLLM_PORT=20100
VLLM_DTYPE=half
VLLM_GPU_MEMORY_UTILIZATION=0.90
VLLM_MAX_MODEL_LEN=8192
ROCM_VERSION=6.1.3
VLLM_VERSION=0.4.3

# AMD ROCm GPU configuration (gfx1101 for RX 7700 XT)
HSA_OVERRIDE_GFX_VERSION=11.0.1
PYTORCH_ROCM_ARCH=gfx1101
HIP_VISIBLE_DEVICES=0

# Container resource limits
CONTAINER_MEMORY_LIMIT=14g
CONTAINER_CPU_LIMIT=8.0
CONTAINER_SHM_SIZE=4g

# Port mappings
WIREGUARD_PORT=51820
VLLM_API_PORT=20100

# Security and compliance
COMPOSE_PROFILES=default
