# Unheaded Host-B (Outpost) — Environment Variables
# Copy to .env and customize before starting
# Host: Consumer grade, 8GB RAM, no GPU

VERSION=dev
LOG_LEVEL=info

# Host identity
UNHEADED_HOST_ROLE=outpost
UNHEADED_HOST_ID=host-b

# ============================================================
# FIREWALL CONFIGURATION (IPFire + BIRD)
# ============================================================

# WAN interface (physical NIC facing upstream router)
WAN_INTERFACE=eno1

# Upstream network (from your ISP/router)
WAN_SUBNET=192.168.1.0/24
WAN_GATEWAY=192.168.1.1

# IPFire WAN IP (on macvlan WAN network)
IPFIRE_WAN_IP=192.168.1.3

# IPFire Memory & CPU allocation
IPFIRE_MEM=2048
IPFIRE_CPUS=2

# Image paths (from ~/tmp/)
IPFIRE_IMG_PATH=${HOME}/tmp/ipfire/ipfire-2.29-core199-x86_64.img.xz

# BIRD BGP Configuration
BIRD_CONF=./../../routing/bird/bird.conf
BIRD_BGP_AS=65002
BIRD_ROUTER_ID=10.20.255.2

# ============================================================
# WireGuard VPN Configuration
# ============================================================

# Generate keys with: wg genkey | tee private.key | wg pubkey > public.key
# Must match key pair in host-a configuration
WG_PRIVATE_KEY=<generate-with-wg-genkey>
WG_PUBLIC_KEY=<derive-from-private-key>
WG_PEER_PUBLIC_KEY=<host-a-public-key>
WG_ENDPOINT_HOST=<host-a-ip-or-hostname>

# IPv6 WireGuard Addressing
# host-a is ::1, host-b is ::2 within fd00:dead:beef::/48
WG_IPV6_ADDR=fd00:dead:beef::2/48

# Local hostname/IP for outbound WireGuard (typically auto-detected)
# Can also set explicitly: WG_ENDPOINT_HOST=192.168.1.100
WG_ENDPOINT_HOST=auto

# ============================================================
# Telemetry
# ============================================================

# Shorter retention on minimal host to conserve storage
PROMETHEUS_RETENTION=7d
