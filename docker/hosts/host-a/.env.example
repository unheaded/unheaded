# Unheaded Host-A (Forge) — Environment Variables
# Copy to .env and customize before starting
# Host: 16+ cores, 64GB RAM, RX 7700 XT GPU

VERSION=dev
LOG_LEVEL=info

# Host identity
UNHEADED_HOST_ROLE=forge
UNHEADED_HOST_ID=host-a

# WireGuard VPN Configuration
# Generate keys with: wg genkey | tee private.key | wg pubkey > public.key
WG_PRIVATE_KEY=<generate-with-wg-genkey>
WG_PUBLIC_KEY=<derive-from-private-key>
WG_PEER_PUBLIC_KEY=<host-b-public-key>
WG_ENDPOINT_PEER=<host-b-ip>:51820

# IPv6 WireGuard Addressing
# host-a is ::1, host-b is ::2 within fd00:dead:beef::/48
WG_IPV6_ADDR=fd00:dead:beef::1/48

# Grafana Admin Configuration
GRAFANA_ADMIN_PASSWORD=changeme
GRAFANA_SECRET_KEY=changeme32characterssecretkey!!

# Telemetry Retention
# VictoriaMetrics retention period (30d, 90d, 1y, etc.)
VM_RETENTION_PERIOD=90d

# Optional: vLLM Configuration (for LLM services on RX 7700 XT)
# VLLM_MODEL=meta-llama/Llama-2-7b
# VLLM_GPU_MEMORY_UTILIZATION=0.9
# VLLM_TENSOR_PARALLEL_SIZE=2
