# Rust build artifacts (largest dirs)
ebpf/target/

# Git history
.git/

# Test artifacts
*.test
*.out
cover.out

# IDE / OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Nix build output
result

# Rust build output for ALL crates (~1.5G) — never needed by Go image builds
crates/*/target/
**/target/

# Gitignored, never COPYed by any Dockerfile: ~1GB that every build context
# used to carry. llama.cpp/ is a local checkout (725M); bin/ and the
# root-level binaries are `go build` outputs.
llama.cpp/
bin/
/kanban-app
/trace-collector-go
/dashboard-backend
/unheaded-daemon
/sophia
/monad
/wiki-server
/huginn

# Secrets and key material, all gitignored: no image build needs them (CI
# builds from a clean checkout that has none), and `COPY . .` in the builder
# stage would otherwise put them in the build context and a cached layer.
.env
.env.*
!.env.example
**/.env
configs/keys/
configs/certs/
configs/auth/
