              "fillOpacity": 15,
              "spanNulls": false
            },
            "unit": "reqps"
          }
        },
        "options": {
          "tooltip": { "mode": "multi", "sort": "desc" },
          "legend": { "displayMode": "list", "placement": "bottom" }
        }
      },

      {
        "id": 42,
        "title": "VictoriaMetrics — Ingestion & Queries",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 8, "x": 16, "y": 31 },
        "targets": [
          {
            "expr": "rate(vm_rows_inserted_total[1m])",
            "legendFormat": "Rows inserted/s ({{type}})"
          },
          {
            "expr": "vm_active_merges",
            "legendFormat": "Active merges ({{type}})"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "palette-classic" },
            "custom": {
              "drawStyle": "line",
              "lineWidth": 2,
              "fillOpacity": 15,
              "spanNulls": false
            },
            "unit": "short"
          }
        },
        "options": {
          "tooltip": { "mode": "multi", "sort": "desc" },
          "legend": { "displayMode": "list", "placement": "bottom" }
        }
      },

      {
        "id": 50,
        "title": "GC Pause Duration by Service",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 39 },
        "targets": [{
          "expr": "rate(go_gc_duration_seconds_sum[1m])",
          "legendFormat": "{{job}}"
        }],
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "palette-classic" },
            "custom": {
              "drawStyle": "line",
              "lineWidth": 2,
              "fillOpacity": 10,
              "spanNulls": false
            },
            "unit": "s"
          }
        },
        "options": {
          "tooltip": { "mode": "multi", "sort": "desc" },
          "legend": { "displayMode": "list", "placement": "bottom" }
        }
      },

      {
        "id": 51,
        "title": "Heap Allocation Rate by Service",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 39 },
        "targets": [{
          "expr": "rate(go_memstats_alloc_bytes_total[1m])",
          "legendFormat": "{{job}}"
        }],
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "palette-classic" },
            "custom": {
              "drawStyle": "line",
              "lineWidth": 2,
              "fillOpacity": 10,
              "spanNulls": false
            },
            "unit": "Bps"
          }
        },
        "options": {
          "tooltip": { "mode": "multi", "sort": "desc" },
          "legend": { "displayMode": "list", "placement": "bottom" }
        }
      }
    ],
    "templating": { "list": [] },
    "annotations": { "list": [] },
    "links": []
  },
  "overwrite": true
}
