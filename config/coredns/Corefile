# 1053, not 53: the server runs as an unprivileged uid with no capabilities;
# the host port (COREDNS_PORT, default 5353) is mapped onto it by compose.
unheaded.local:1053 {
    log
    errors
    # Never answer UDP with more than 1232 bytes (1280 IPv6 minimum MTU - 40
    # - 8): a bigger datagram fragments, and the Kingdom drops IPv6 fragments
    # at ingress (ADR-014). Clients retry larger answers over TCP.
    bufsize 1232
    health {
        lameduck 5s
    }
    ready

    # Service discovery records
    template IN A unheaded.local {
        answer "{{ .Name }} 60 IN A 172.28.1.1"
    }

    template IN A wotan.unheaded.local {
        answer "{{ .Name }} 60 IN A 172.28.1.10"
    }

    template IN A timeguru.unheaded.local {
        answer "{{ .Name }} 60 IN A 172.28.1.20"
    }

    template IN A captain.unheaded.local {
        answer "{{ .Name }} 60 IN A 172.28.1.21"
    }

    template IN A architect.unheaded.local {
        answer "{{ .Name }} 60 IN A 172.28.1.22"
    }

    template IN A micromanager.unheaded.local {
        answer "{{ .Name }} 60 IN A 172.28.1.23"
    }

    template IN A monad.unheaded.local {
        answer "{{ .Name }} 60 IN A 172.28.1.24"
    }

    template IN A sophia.unheaded.local {
        answer "{{ .Name }} 60 IN A 172.28.1.25"
    }
}

.:1053 {
    bufsize 1232
    forward . 8.8.8.8 8.8.4.4
    log
    errors
    cache 30
}
