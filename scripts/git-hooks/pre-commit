#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# pre-commit — Unheaded minimum-viable pre-commit hook.
#
# Purpose: catch gofmt + rustfmt drift and vet errors on staged source files
# BEFORE they land. Closes Marshal CE5 (2026-05-06) for Go and the parallel
# cargo-fmt gap surfaced in Phase 8 of marshal-shift-2026-05-07 for Rust.
#
# Behavior:
#   - If no .go and no .rs files staged: exits 0 silently.
#   - If staged .go files have gofmt drift: prints offending paths, exits 1.
#   - If `go vet` fails on packages owning staged Go changes: prints output, exits 1.
#   - If any staged .go or .rs file is missing an SPDX-License-Identifier in
#     its first 5 lines: prints offending paths, exits 1. Defends the
#     1190/1190 baseline achieved 2026-05-07.
#   - If staged .rs files have rustfmt drift: prints offending paths, exits 1.
#     (rustfmt missing → soft-warn and skip the rust check; never block on a
#      missing toolchain since not every contributor will have a Rust toolchain.)
#   - All other output suppressed (terse-on-success).
#
# Bypass: `git commit --no-verify` (standard escape hatch).
#
# Install: `make install-hooks` (symlinks this file to .git/hooks/pre-commit).

set -euo pipefail

# Collect staged .go files (Added/Copied/Modified/Renamed, NUL-delimited for safety).
mapfile -d '' STAGED_GO < <(
    git diff --cached --name-only --diff-filter=ACMR -z -- '*.go' 2>/dev/null || true
)

# Collect staged .rs files (same filter).
mapfile -d '' STAGED_RS < <(
    git diff --cached --name-only --diff-filter=ACMR -z -- '*.rs' 2>/dev/null || true
)

# Nothing Go or Rust staged → nothing to do.
if [ "${#STAGED_GO[@]}" -eq 0 ] && [ "${#STAGED_RS[@]}" -eq 0 ]; then
    exit 0
fi

# Filter out staged files that no longer exist on disk (e.g. partial stage races).
EXISTING_GO=()
for f in "${STAGED_GO[@]}"; do
    [ -f "$f" ] && EXISTING_GO+=("$f")
done

EXISTING_RS=()
for f in "${STAGED_RS[@]}"; do
    [ -f "$f" ] && EXISTING_RS+=("$f")
done

# ---------- Go path ----------
if [ "${#EXISTING_GO[@]}" -gt 0 ]; then
    # 1. gofmt drift check on staged Go files.
    if ! command -v gofmt >/dev/null 2>&1; then
        echo "pre-commit: gofmt not on PATH; install Go toolchain or commit --no-verify" >&2
        exit 1
    fi

    DRIFT="$(gofmt -l "${EXISTING_GO[@]}" 2>&1 || true)"
    if [ -n "$DRIFT" ]; then
        echo "pre-commit: gofmt drift detected in staged files:" >&2
        echo "$DRIFT" | sed 's/^/  /' >&2
        echo "pre-commit: run \`gofmt -w <file>\` (or \`make fmt\`) and re-stage." >&2
        exit 1
    fi

    # 2. go vet on packages owning staged Go changes.
    if ! command -v go >/dev/null 2>&1; then
        echo "pre-commit: go not on PATH; install Go toolchain or commit --no-verify" >&2
        exit 1
    fi

    # Map staged files → unique parent dirs → ./dir form for `go vet`.
    declare -A PKG_SET=()
    for f in "${EXISTING_GO[@]}"; do
        d="$(dirname "$f")"
        PKG_SET["./$d"]=1
    done

    PKGS=()
    for p in "${!PKG_SET[@]}"; do
        PKGS+=("$p")
    done

    VET_OUT="$(go vet "${PKGS[@]}" 2>&1 || true)"
    if [ -n "$VET_OUT" ]; then
        echo "pre-commit: go vet failed for staged packages:" >&2
        echo "$VET_OUT" | sed 's/^/  /' >&2
        exit 1
    fi
fi

# ---------- SPDX coverage check (.go + .rs combined) ----------
# Defends the 100.00% (1190/1190 Go) baseline achieved 2026-05-07. Any new file
# that ships without an SPDX-License-Identifier in its first 5 lines fails.
SPDX_MISSING=""
for f in "${EXISTING_GO[@]}" "${EXISTING_RS[@]}"; do
    if ! head -n 5 "$f" 2>/dev/null | grep -q "SPDX-License-Identifier"; then
        SPDX_MISSING="${SPDX_MISSING}${f}"$'\n'
    fi
done
if [ -n "$SPDX_MISSING" ]; then
    echo "pre-commit: SPDX-License-Identifier missing in staged file(s):" >&2
    echo -n "$SPDX_MISSING" | sed 's/^/  /' >&2
    echo "pre-commit: prepend \`// SPDX-License-Identifier: GPL-3.0-or-later\` to each file's first 5 lines and re-stage." >&2
    exit 1
fi

# ---------- Rust path ----------
if [ "${#EXISTING_RS[@]}" -gt 0 ]; then
    # rustfmt soft-required: not every contributor has a Rust toolchain. If
    # rustfmt is missing, warn (so the gap is visible) but do not block.
    if ! command -v rustfmt >/dev/null 2>&1; then
        echo "pre-commit: rustfmt not on PATH — skipping Rust fmt check (install via rustup component add rustfmt)" >&2
    else
        # rustfmt --check exits non-zero if any file would change.
        # Run per-file so the error message lists offending paths.
        RS_DRIFT=""
        for f in "${EXISTING_RS[@]}"; do
            if ! rustfmt --check --edition 2021 "$f" >/dev/null 2>&1; then
                RS_DRIFT="${RS_DRIFT}${f}"$'\n'
            fi
        done
        if [ -n "$RS_DRIFT" ]; then
            echo "pre-commit: rustfmt drift detected in staged files:" >&2
            echo -n "$RS_DRIFT" | sed 's/^/  /' >&2
            echo "pre-commit: run \`cargo fmt\` in the affected workspace and re-stage." >&2
            exit 1
        fi
    fi
fi

exit 0
