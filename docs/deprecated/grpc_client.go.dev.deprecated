// Package busboyClient provides a gRPC streaming client for the Busboy message bus.
// This implementation supports bidirectional streaming, automatic reconnection,
// backpressure handling, and client-side load balancing.
package busboyClient

import (
	"context"
	"crypto/tls"
	"errors"
	"fmt"
	"math"
	"regexp"
	"strings"
	"sync"
	"sync/atomic"
	"time"

	"github.com/prometheus/client_golang/prometheus"
	"github.com/prometheus/client_golang/prometheus/promauto"
	"github.com/rs/zerolog"
	"google.golang.org/grpc"
	"google.golang.org/grpc/connectivity"
	"google.golang.org/grpc/credentials"
	"google.golang.org/grpc/credentials/insecure"
	"google.golang.org/grpc/keepalive"
	"google.golang.org/grpc/metadata"
	"google.golang.org/protobuf/proto"
	"google.golang.org/protobuf/types/known/timestamppb"
)

// ============================================================================
// PROTO DEFINITIONS (inline - would normally be in separate .proto file)
// ============================================================================

// MessageProto represents a Busboy message in protobuf format.
// In production, this would be generated from busboy.proto:
//
//	message Message {
//	    string message_id = 1;
//	    string topic = 2;
//	    string sender_id = 3;
//	    google.protobuf.Timestamp created_at = 4;
//	    int64 seq = 5;
//	    bytes payload = 6;
//	    bool deleted = 7;
//	    map<string, string> metadata = 8;
//	}
type MessageProto struct {
	MessageID string
	Topic     string
	SenderID  string
	CreatedAt *timestamppb.Timestamp
	Seq       int64
	Payload   []byte
	Deleted   bool
	Metadata  map[string]string
}

// StreamRequest represents requests sent on the bidirectional stream.
// Types: SUBSCRIBE, UNSUBSCRIBE, PUBLISH, ACK, PING
type StreamRequest struct {
	RequestID   string
	Type        StreamRequestType
	Topic       string
	Pattern     string // For wildcard subscriptions
	Payload     []byte
	FromSeq     int64 // For replay
	DisplayName string
	Metadata    map[string]string
}

// StreamRequestType defines the type of stream request
type StreamRequestType int32

const (
	StreamRequestTypeUnknown     StreamRequestType = 0
	StreamRequestTypeSubscribe   StreamRequestType = 1
	StreamRequestTypeUnsubscribe StreamRequestType = 2
	StreamRequestTypePublish     StreamRequestType = 3
	StreamRequestTypeAck         StreamRequestType = 4
	StreamRequestTypePing        StreamRequestType = 5
	StreamRequestTypeReplay      StreamRequestType = 6
)

// StreamResponse represents responses received on the bidirectional stream.
type StreamResponse struct {
	RequestID string
	Type      StreamResponseType
	Message   *MessageProto
	Error     *StreamError
	Ack       *PublishAck
	Pong      *PongResponse
}

// StreamResponseType defines the type of stream response
type StreamResponseType int32

const (
	StreamResponseTypeUnknown StreamResponseType = 0
	StreamResponseTypeMessage StreamResponseType = 1
	StreamResponseTypeError   StreamResponseType = 2
	StreamResponseTypeAck     StreamResponseType = 3
	StreamResponseTypePong    StreamResponseType = 4
	StreamResponseTypeStatus  StreamResponseType = 5
)

// StreamError represents an error in the stream
type StreamError struct {
	Code    string
	Message string
}

// PublishAck represents acknowledgment of a published message
type PublishAck struct {
	MessageID string
	Seq       int64
	Topic     string
	Timestamp *timestamppb.Timestamp
}

// PongResponse represents a keepalive response
type PongResponse struct {
	Timestamp   *timestamppb.Timestamp
	ServerTime  *timestamppb.Timestamp
	LatencyNano int64
}

// HistoryRequest represents a request for historical messages
type HistoryRequest struct {
	Topic   string
	FromSeq int64
	ToSeq   int64
	Limit   int32
}

// HistoryResponse represents historical messages
type HistoryResponse struct {
	Messages []*MessageProto
	HasMore  bool
	NextSeq  int64
}

// ============================================================================
// METRICS
// ============================================================================

var (
	grpcMessagesReceived = promauto.NewCounterVec(
		prometheus.CounterOpts{
			Namespace: "busboy",
			Subsystem: "grpc_client",
			Name:      "messages_received_total",
			Help:      "Total messages received via gRPC stream",
		},
		[]string{"topic", "client_id"},
	)

	grpcMessagesPublished = promauto.NewCounterVec(
		prometheus.CounterOpts{
			Namespace: "busboy",
			Subsystem: "grpc_client",
			Name:      "messages_published_total",
			Help:      "Total messages published via gRPC stream",
		},
		[]string{"topic", "client_id", "status"},
	)

	grpcPublishLatency = promauto.NewHistogramVec(
		prometheus.HistogramOpts{
			Namespace: "busboy",
			Subsystem: "grpc_client",
			Name:      "publish_latency_seconds",
			Help:      "Latency of publish operations",
			Buckets:   []float64{.001, .005, .01, .025, .05, .1, .25, .5, 1, 2.5, 5, 10},
		},
		[]string{"topic", "client_id"},
	)

	grpcStreamErrors = promauto.NewCounterVec(
		prometheus.CounterOpts{
			Namespace: "busboy",
			Subsystem: "grpc_client",
			Name:      "stream_errors_total",
			Help:      "Total stream errors",
		},
		[]string{"client_id", "error_type"},
	)

	grpcReconnections = promauto.NewCounterVec(
		prometheus.CounterOpts{
			Namespace: "busboy",
			Subsystem: "grpc_client",
			Name:      "reconnections_total",
			Help:      "Total reconnection attempts",
		},
		[]string{"client_id", "status"},
	)

	grpcActiveSubscriptions = promauto.NewGaugeVec(
		prometheus.GaugeOpts{
			Namespace: "busboy",
			Subsystem: "grpc_client",
			Name:      "active_subscriptions",
			Help:      "Number of active subscriptions",
		},
		[]string{"client_id"},
	)

	grpcConnectionState = promauto.NewGaugeVec(
		prometheus.GaugeOpts{
			Namespace: "busboy",
			Subsystem: "grpc_client",
			Name:      "connection_state",
			Help:      "Current connection state (0=disconnected, 1=connecting, 2=connected)",
		},
		[]string{"client_id"},
	)

	grpcBackpressure = promauto.NewCounterVec(
		prometheus.CounterOpts{
			Namespace: "busboy",
			Subsystem: "grpc_client",
			Name:      "backpressure_events_total",
			Help:      "Total backpressure events (slow consumers)",
		},
		[]string{"client_id", "topic"},
	)
)

// ============================================================================
// CONFIGURATION
// ============================================================================

// GRPCClientConfig configures the gRPC client
type GRPCClientConfig struct {
	// Target addresses for load balancing (comma-separated or slice)
	Addresses []string

	// Client identification
	ClientID    string
	DisplayName string

	// TLS configuration
	TLSConfig *tls.Config
	Insecure  bool

	// Connection settings
	ConnectTimeout      time.Duration
	KeepAliveTime       time.Duration
	KeepAliveTimeout    time.Duration
	MaxRetries          int
	InitialBackoff      time.Duration
	MaxBackoff          time.Duration
	BackoffMultiplier   float64
	ReconnectOnFailure  bool
	MaxConcurrentStream int

	// Buffer sizes
	SendBufferSize    int
	ReceiveBufferSize int
	ChannelBufferSize int

	// Backpressure settings
	BackpressureThreshold float64 // 0-1, percentage of buffer before applying backpressure
	DropOnBackpressure    bool    // Drop messages instead of blocking

	// Tracing
	EnableTracing bool

	// Logger
	Logger zerolog.Logger
}

// DefaultGRPCClientConfig returns sensible defaults
func DefaultGRPCClientConfig() *GRPCClientConfig {
	return &GRPCClientConfig{
		ConnectTimeout:        10 * time.Second,
		KeepAliveTime:         30 * time.Second,
		KeepAliveTimeout:      10 * time.Second,
		MaxRetries:            10,
		InitialBackoff:        100 * time.Millisecond,
		MaxBackoff:            30 * time.Second,
		BackoffMultiplier:     2.0,
		ReconnectOnFailure:    true,
		MaxConcurrentStream:   100,
		SendBufferSize:        1024 * 1024,    // 1MB
		ReceiveBufferSize:     1024 * 1024,    // 1MB
		ChannelBufferSize:     1000,           // 1000 messages
		BackpressureThreshold: 0.8,            // 80%
		DropOnBackpressure:    false,          // Block by default
		EnableTracing:         true,
		Logger:                zerolog.Nop(),
	}
}

// ============================================================================
// GRPC CLIENT
// ============================================================================

// GRPCClient provides gRPC streaming access to Busboy message bus
type GRPCClient struct {
	config *GRPCClientConfig
	logger zerolog.Logger

	// gRPC connection
	conn       *grpc.ClientConn
	connMu     sync.RWMutex
	connState  connectivity.State
	reconnectC chan struct{}

	// Bidirectional stream
	// In production, this would be the actual gRPC stream type:
	// stream pb.BusboyService_StreamMessagesClient
	streamMu     sync.RWMutex
	streamCtx    context.Context
	streamCancel context.CancelFunc

	// Subscriptions
	subscriptions map[string]*subscription
	subMu         sync.RWMutex

	// Pending publish acknowledgments
	pendingAcks map[string]*pendingAck
	ackMu       sync.RWMutex

	// Message channels per topic
	channels map[string]*messageChannel
	chanMu   sync.RWMutex

	// State
	clientID  string
	closed    int32
	connected int32
	lastSeq   map[string]int64
	seqMu     sync.RWMutex

	// Backpressure tracking
	inflightCount int64

	// Lifecycle
	ctx    context.Context
	cancel context.CancelFunc
	wg     sync.WaitGroup
}

// subscription tracks an active subscription
type subscription struct {
	Topic       string
	Pattern     string // For wildcards
	DisplayName string
	Status      string // pending, approved, denied
	CreatedAt   time.Time
	LastSeq     int64
}

// pendingAck tracks a pending publish acknowledgment
type pendingAck struct {
	RequestID string
	Topic     string
	Payload   []byte
	CreatedAt time.Time
	DoneC     chan *PublishAck
	ErrC      chan error
}

// messageChannel wraps a channel with backpressure tracking
type messageChannel struct {
	Topic      string
	Pattern    string
	Ch         chan *Message
	DroppedCnt int64
	CreatedAt  time.Time
}

// NewGRPCClient creates a new gRPC streaming client
func NewGRPCClient(config *GRPCClientConfig) (*GRPCClient, error) {
	if config == nil {
		config = DefaultGRPCClientConfig()
	}

	if len(config.Addresses) == 0 {
		return nil, errors.New("at least one address is required")
	}

	if config.ClientID == "" {
		config.ClientID = generateClientID()
	}

	ctx, cancel := context.WithCancel(context.Background())

	c := &GRPCClient{
		config:        config,
		logger:        config.Logger.With().Str("client_id", config.ClientID).Logger(),
		subscriptions: make(map[string]*subscription),
		pendingAcks:   make(map[string]*pendingAck),
		channels:      make(map[string]*messageChannel),
		lastSeq:       make(map[string]int64),
		clientID:      config.ClientID,
		ctx:           ctx,
		cancel:        cancel,
		reconnectC:    make(chan struct{}, 1),
	}

	// Initialize metrics
	grpcConnectionState.WithLabelValues(c.clientID).Set(0)
	grpcActiveSubscriptions.WithLabelValues(c.clientID).Set(0)

	return c, nil
}

// Connect establishes the gRPC connection and stream
func (c *GRPCClient) Connect(ctx context.Context) error {
	c.connMu.Lock()
	defer c.connMu.Unlock()

	if atomic.LoadInt32(&c.closed) == 1 {
		return errors.New("client is closed")
	}

	if c.conn != nil && c.conn.GetState() == connectivity.Ready {
		return nil // Already connected
	}

	c.logger.Info().Strs("addresses", c.config.Addresses).Msg("connecting to Busboy gRPC")
	grpcConnectionState.WithLabelValues(c.clientID).Set(1) // connecting

	// Build dial options
	opts := c.buildDialOptions()

	// Create connection with load balancing
	target := c.buildTarget()

	connectCtx, connectCancel := context.WithTimeout(ctx, c.config.ConnectTimeout)
	defer connectCancel()

	conn, err := grpc.DialContext(connectCtx, target, opts...)
	if err != nil {
		grpcConnectionState.WithLabelValues(c.clientID).Set(0)
		c.logger.Error().Err(err).Msg("failed to connect")
		return fmt.Errorf("connect to %s: %w", target, err)
	}

	c.conn = conn
	atomic.StoreInt32(&c.connected, 1)
	grpcConnectionState.WithLabelValues(c.clientID).Set(2) // connected

	c.logger.Info().Msg("connected to Busboy gRPC")

	// Start stream
	if err := c.startStream(ctx); err != nil {
		return fmt.Errorf("start stream: %w", err)
	}

	// Start background workers
	c.wg.Add(2)
	go c.connectionMonitor()
	go c.keepaliveLoop()

	return nil
}

// buildDialOptions constructs gRPC dial options
func (c *GRPCClient) buildDialOptions() []grpc.DialOption {
	opts := []grpc.DialOption{
		grpc.WithDefaultServiceConfig(`{
			"loadBalancingPolicy": "round_robin",
			"methodConfig": [{
				"name": [{"service": "busboy.BusboyService"}],
				"waitForReady": true,
				"retryPolicy": {
					"maxAttempts": 5,
					"initialBackoff": "0.1s",
					"maxBackoff": "10s",
					"backoffMultiplier": 2.0,
					"retryableStatusCodes": ["UNAVAILABLE", "RESOURCE_EXHAUSTED"]
				}
			}]
		}`),
		grpc.WithKeepaliveParams(keepalive.ClientParameters{
			Time:                c.config.KeepAliveTime,
			Timeout:             c.config.KeepAliveTimeout,
			PermitWithoutStream: true,
		}),
		grpc.WithWriteBufferSize(c.config.SendBufferSize),
		grpc.WithReadBufferSize(c.config.ReceiveBufferSize),
	}

	// TLS or insecure
	if c.config.Insecure {
		opts = append(opts, grpc.WithTransportCredentials(insecure.NewCredentials()))
	} else if c.config.TLSConfig != nil {
		opts = append(opts, grpc.WithTransportCredentials(credentials.NewTLS(c.config.TLSConfig)))
	} else {
		// Default to system TLS
		opts = append(opts, grpc.WithTransportCredentials(credentials.NewTLS(&tls.Config{})))
	}

	return opts
}

// buildTarget constructs the target string for load balancing
func (c *GRPCClient) buildTarget() string {
	if len(c.config.Addresses) == 1 {
		return c.config.Addresses[0]
	}

	// Use dns resolver for multiple addresses
	return fmt.Sprintf("dns:///%s", c.config.Addresses[0])
}

// startStream initializes the bidirectional stream
func (c *GRPCClient) startStream(ctx context.Context) error {
	c.streamMu.Lock()
	defer c.streamMu.Unlock()

	// Cancel any existing stream
	if c.streamCancel != nil {
		c.streamCancel()
	}

	c.streamCtx, c.streamCancel = context.WithCancel(ctx)

	// Add client metadata
	md := metadata.New(map[string]string{
		"client-id":    c.clientID,
		"client-name":  c.config.DisplayName,
		"client-proto": "grpc-stream-v1",
	})
	streamCtx := metadata.NewOutgoingContext(c.streamCtx, md)

	// Create bidirectional stream
	// In production, this would be generated from proto:
	// stream, err := c.client.StreamMessages(streamCtx)
	// For now, we simulate the stream interface
	_ = streamCtx // Used in production with actual gRPC client

	c.logger.Debug().Msg("bidirectional stream established")

	// Start receive loop
	c.wg.Add(1)
	go c.receiveLoop()

	return nil
}

// receiveLoop handles incoming messages from the stream
func (c *GRPCClient) receiveLoop() {
	defer c.wg.Done()

	c.logger.Debug().Msg("starting receive loop")

	for {
		select {
		case <-c.ctx.Done():
			c.logger.Debug().Msg("receive loop stopped: context cancelled")
			return
		default:
		}

		// In production, this would receive from the actual gRPC stream:
		// resp, err := c.stream.Recv()
		// For now, we simulate with a blocking select
		c.streamMu.RLock()
		if c.streamCtx == nil {
			c.streamMu.RUnlock()
			return
		}
		streamCtx := c.streamCtx
		c.streamMu.RUnlock()

		select {
		case <-streamCtx.Done():
			c.logger.Debug().Msg("receive loop stopped: stream context cancelled")
			c.handleStreamDisconnect()
			return
		case <-c.ctx.Done():
			return
		}
	}
}

// handleStreamResponse processes a received stream response
func (c *GRPCClient) handleStreamResponse(resp *StreamResponse) {
	switch resp.Type {
	case StreamResponseTypeMessage:
		c.handleMessage(resp.Message)
	case StreamResponseTypeAck:
		c.handleAck(resp.RequestID, resp.Ack)
	case StreamResponseTypeError:
		c.handleError(resp.RequestID, resp.Error)
	case StreamResponseTypePong:
		c.handlePong(resp.Pong)
	case StreamResponseTypeStatus:
		c.logger.Debug().Str("request_id", resp.RequestID).Msg("received status update")
	default:
		c.logger.Warn().Int32("type", int32(resp.Type)).Msg("unknown response type")
	}
}

// handleMessage processes an incoming message
func (c *GRPCClient) handleMessage(msgProto *MessageProto) {
	if msgProto == nil {
		return
	}

	// Convert proto to Message
	msg := &Message{
		MessageID: msgProto.MessageID,
		Topic:     msgProto.Topic,
		SenderID:  msgProto.SenderID,
		Seq:       msgProto.Seq,
		Payload:   string(msgProto.Payload),
		Deleted:   msgProto.Deleted,
	}
	if msgProto.CreatedAt != nil {
		msg.CreatedAt = msgProto.CreatedAt.AsTime()
	}

	// Update last seen sequence
	c.seqMu.Lock()
	if msg.Seq > c.lastSeq[msg.Topic] {
		c.lastSeq[msg.Topic] = msg.Seq
	}
	c.seqMu.Unlock()

	// Record metric
	grpcMessagesReceived.WithLabelValues(msg.Topic, c.clientID).Inc()

	// Deliver to subscribers
	c.deliverMessage(msg)
}

// deliverMessage delivers a message to matching channels
func (c *GRPCClient) deliverMessage(msg *Message) {
	c.chanMu.RLock()
	defer c.chanMu.RUnlock()

	for _, mc := range c.channels {
		if c.matchesTopic(msg.Topic, mc.Topic, mc.Pattern) {
			c.sendToChannel(mc, msg)
		}
	}
}

// matchesTopic checks if a message topic matches a subscription
func (c *GRPCClient) matchesTopic(msgTopic, subTopic, pattern string) bool {
	// Exact match
	if subTopic == msgTopic {
		return true
	}

	// Wildcard pattern match
	if pattern != "" {
		matched, _ := matchWildcard(pattern, msgTopic)
		return matched
	}

	return false
}

// matchWildcard matches topic against wildcard pattern
// Supports: * (single level), # (multi-level)
// Examples: "events.*" matches "events.user", "events.#" matches "events.user.created"
func matchWildcard(pattern, topic string) (bool, error) {
	// Convert MQTT-style wildcards to regex
	regexPattern := "^"
	parts := strings.Split(pattern, ".")
	for i, part := range parts {
		switch part {
		case "*":
			regexPattern += `[^.]+`
		case "#":
			if i == len(parts)-1 {
				regexPattern += `.*`
			} else {
				return false, errors.New("# wildcard must be at end")
			}
		default:
			regexPattern += regexp.QuoteMeta(part)
		}
		if i < len(parts)-1 && part != "#" {
			regexPattern += `\.`
		}
	}
	regexPattern += "$"

	re, err := regexp.Compile(regexPattern)
	if err != nil {
		return false, err
	}

	return re.MatchString(topic), nil
}

// sendToChannel sends a message to a channel with backpressure handling
func (c *GRPCClient) sendToChannel(mc *messageChannel, msg *Message) {
	// Check buffer utilization
	bufferUsage := float64(len(mc.Ch)) / float64(cap(mc.Ch))

	if bufferUsage >= c.config.BackpressureThreshold {
		grpcBackpressure.WithLabelValues(c.clientID, mc.Topic).Inc()

		if c.config.DropOnBackpressure {
			atomic.AddInt64(&mc.DroppedCnt, 1)
			c.logger.Warn().
				Str("topic", mc.Topic).
				Int64("dropped_count", atomic.LoadInt64(&mc.DroppedCnt)).
				Msg("dropping message due to backpressure")
			return
		}
	}

	// Try to send (non-blocking if full and drop enabled)
	select {
	case mc.Ch <- msg:
		// Message delivered
	default:
		if c.config.DropOnBackpressure {
			atomic.AddInt64(&mc.DroppedCnt, 1)
			c.logger.Warn().
				Str("topic", mc.Topic).
				Msg("channel full, dropping message")
		} else {
			// Block until space available
			mc.Ch <- msg
		}
	}
}

// handleAck processes a publish acknowledgment
func (c *GRPCClient) handleAck(requestID string, ack *PublishAck) {
	c.ackMu.Lock()
	pending, ok := c.pendingAcks[requestID]
	if ok {
		delete(c.pendingAcks, requestID)
	}
	c.ackMu.Unlock()

	if !ok {
		c.logger.Warn().Str("request_id", requestID).Msg("received ack for unknown request")
		return
	}

	// Record latency
	latency := time.Since(pending.CreatedAt)
	grpcPublishLatency.WithLabelValues(pending.Topic, c.clientID).Observe(latency.Seconds())
	grpcMessagesPublished.WithLabelValues(pending.Topic, c.clientID, "success").Inc()

	// Notify waiter
	select {
	case pending.DoneC <- ack:
	default:
	}
}

// handleError processes a stream error
func (c *GRPCClient) handleError(requestID string, streamErr *StreamError) {
	grpcStreamErrors.WithLabelValues(c.clientID, streamErr.Code).Inc()

	c.logger.Error().
		Str("request_id", requestID).
		Str("code", streamErr.Code).
		Str("message", streamErr.Message).
		Msg("stream error")

	// Notify pending ack if exists
	c.ackMu.Lock()
	pending, ok := c.pendingAcks[requestID]
	if ok {
		delete(c.pendingAcks, requestID)
	}
	c.ackMu.Unlock()

	if ok {
		grpcMessagesPublished.WithLabelValues(pending.Topic, c.clientID, "error").Inc()
		select {
		case pending.ErrC <- fmt.Errorf("%s: %s", streamErr.Code, streamErr.Message):
		default:
		}
	}
}

// handlePong processes a keepalive response
func (c *GRPCClient) handlePong(pong *PongResponse) {
	if pong != nil && pong.LatencyNano > 0 {
		c.logger.Debug().
			Int64("latency_ns", pong.LatencyNano).
			Msg("keepalive pong")
	}
}

// handleStreamDisconnect handles stream disconnection
func (c *GRPCClient) handleStreamDisconnect() {
	c.logger.Warn().Msg("stream disconnected")
	atomic.StoreInt32(&c.connected, 0)
	grpcConnectionState.WithLabelValues(c.clientID).Set(0)

	if c.config.ReconnectOnFailure && atomic.LoadInt32(&c.closed) == 0 {
		select {
		case c.reconnectC <- struct{}{}:
		default:
		}
	}
}

// connectionMonitor monitors connection state and handles reconnection
func (c *GRPCClient) connectionMonitor() {
	defer c.wg.Done()

	for {
		select {
		case <-c.ctx.Done():
			return
		case <-c.reconnectC:
			c.reconnectWithBackoff()
		}
	}
}

// reconnectWithBackoff attempts to reconnect with exponential backoff
func (c *GRPCClient) reconnectWithBackoff() {
	if atomic.LoadInt32(&c.closed) == 1 {
		return
	}

	backoff := c.config.InitialBackoff
	for attempt := 1; attempt <= c.config.MaxRetries; attempt++ {
		if atomic.LoadInt32(&c.closed) == 1 {
			return
		}

		c.logger.Info().
			Int("attempt", attempt).
			Dur("backoff", backoff).
			Msg("attempting reconnection")

		grpcReconnections.WithLabelValues(c.clientID, "attempt").Inc()

		// Wait for backoff
		select {
		case <-c.ctx.Done():
			return
		case <-time.After(backoff):
		}

		// Attempt to reconnect
		err := c.Connect(c.ctx)
		if err == nil {
			grpcReconnections.WithLabelValues(c.clientID, "success").Inc()
			c.logger.Info().Msg("reconnected successfully")

			// Restore subscriptions
			c.restoreSubscriptions()
			return
		}

		grpcReconnections.WithLabelValues(c.clientID, "failed").Inc()
		c.logger.Error().Err(err).Int("attempt", attempt).Msg("reconnection failed")

		// Exponential backoff with jitter
		backoff = time.Duration(float64(backoff) * c.config.BackoffMultiplier)
		if backoff > c.config.MaxBackoff {
			backoff = c.config.MaxBackoff
		}
		// Add jitter (10%)
		jitter := time.Duration(float64(backoff) * 0.1 * (0.5 - float64(time.Now().UnixNano()%100)/100))
		backoff += jitter
	}

	c.logger.Error().Int("max_retries", c.config.MaxRetries).Msg("max reconnection attempts reached")
}

// restoreSubscriptions re-subscribes to all topics after reconnection
func (c *GRPCClient) restoreSubscriptions() {
	c.subMu.RLock()
	subs := make([]*subscription, 0, len(c.subscriptions))
	for _, sub := range c.subscriptions {
		subs = append(subs, sub)
	}
	c.subMu.RUnlock()

	for _, sub := range subs {
		ctx, cancel := context.WithTimeout(c.ctx, 10*time.Second)
		if sub.Pattern != "" {
			_, err := c.SubscribePattern(ctx, sub.Pattern, sub.DisplayName)
			if err != nil {
				c.logger.Error().Err(err).Str("pattern", sub.Pattern).Msg("failed to restore pattern subscription")
			}
		} else {
			_, err := c.Subscribe(ctx, sub.Topic, sub.DisplayName)
			if err != nil {
				c.logger.Error().Err(err).Str("topic", sub.Topic).Msg("failed to restore subscription")
			}
		}
		cancel()
	}
}

// keepaliveLoop sends periodic pings to keep the connection alive
func (c *GRPCClient) keepaliveLoop() {
	defer c.wg.Done()

	ticker := time.NewTicker(c.config.KeepAliveTime)
	defer ticker.Stop()

	for {
		select {
		case <-c.ctx.Done():
			return
		case <-ticker.C:
			if atomic.LoadInt32(&c.connected) == 1 {
				c.sendPing()
			}
		}
	}
}

// sendPing sends a keepalive ping
func (c *GRPCClient) sendPing() {
	req := &StreamRequest{
		RequestID: generateRequestID(),
		Type:      StreamRequestTypePing,
	}

	c.logger.Debug().Str("request_id", req.RequestID).Msg("sending keepalive ping")

	// In production, this would send on the actual stream:
	// err := c.stream.Send(req)
	_ = req // Used in production
}

// ============================================================================
// PUBLIC API - SUBSCRIPTION
// ============================================================================

// Subscribe subscribes to a specific topic
func (c *GRPCClient) Subscribe(ctx context.Context, topic, displayName string) (*Subscriber, error) {
	if topic == "" {
		return nil, errors.New("topic cannot be empty")
	}
	if displayName == "" {
		displayName = c.config.DisplayName
	}

	// Check if already subscribed
	c.subMu.RLock()
	if existing, ok := c.subscriptions[topic]; ok {
		c.subMu.RUnlock()
		return &Subscriber{
			SubscriberID: c.clientID,
			Topic:        topic,
			DisplayName:  existing.DisplayName,
			Status:       existing.Status,
			RequestedAt:  existing.CreatedAt,
		}, nil
	}
	c.subMu.RUnlock()

	req := &StreamRequest{
		RequestID:   generateRequestID(),
		Type:        StreamRequestTypeSubscribe,
		Topic:       topic,
		DisplayName: displayName,
	}

	c.logger.Info().
		Str("topic", topic).
		Str("display_name", displayName).
		Msg("subscribing to topic")

	// Send subscribe request
	if err := c.sendStreamRequest(ctx, req); err != nil {
		return nil, fmt.Errorf("send subscribe request: %w", err)
	}

	// Store subscription
	sub := &subscription{
		Topic:       topic,
		DisplayName: displayName,
		Status:      "approved", // Assume approved for gRPC
		CreatedAt:   time.Now(),
	}

	c.subMu.Lock()
	c.subscriptions[topic] = sub
	c.subMu.Unlock()

	grpcActiveSubscriptions.WithLabelValues(c.clientID).Inc()

	return &Subscriber{
		SubscriberID: c.clientID,
		Topic:        topic,
		DisplayName:  displayName,
		Status:       "approved",
		RequestedAt:  sub.CreatedAt,
	}, nil
}

// SubscribePattern subscribes using a wildcard pattern
func (c *GRPCClient) SubscribePattern(ctx context.Context, pattern, displayName string) (*Subscriber, error) {
	if pattern == "" {
		return nil, errors.New("pattern cannot be empty")
	}
	if displayName == "" {
		displayName = c.config.DisplayName
	}

	// Validate pattern
	if !strings.Contains(pattern, "*") && !strings.Contains(pattern, "#") {
		return nil, errors.New("pattern must contain wildcard (* or #)")
	}

	req := &StreamRequest{
		RequestID:   generateRequestID(),
		Type:        StreamRequestTypeSubscribe,
		Pattern:     pattern,
		DisplayName: displayName,
	}

	c.logger.Info().
		Str("pattern", pattern).
		Str("display_name", displayName).
		Msg("subscribing to pattern")

	// Send subscribe request
	if err := c.sendStreamRequest(ctx, req); err != nil {
		return nil, fmt.Errorf("send pattern subscribe request: %w", err)
	}

	// Store subscription
	sub := &subscription{
		Topic:       pattern,
		Pattern:     pattern,
		DisplayName: displayName,
		Status:      "approved",
		CreatedAt:   time.Now(),
	}

	c.subMu.Lock()
	c.subscriptions[pattern] = sub
	c.subMu.Unlock()

	grpcActiveSubscriptions.WithLabelValues(c.clientID).Inc()

	return &Subscriber{
		SubscriberID: c.clientID,
		Topic:        pattern,
		DisplayName:  displayName,
		Status:       "approved",
		RequestedAt:  sub.CreatedAt,
	}, nil
}

// Unsubscribe removes a subscription
func (c *GRPCClient) Unsubscribe(ctx context.Context, topic string) error {
	if topic == "" {
		return errors.New("topic cannot be empty")
	}

	c.subMu.Lock()
	_, ok := c.subscriptions[topic]
	if !ok {
		c.subMu.Unlock()
		return nil // Not subscribed
	}
	delete(c.subscriptions, topic)
	c.subMu.Unlock()

	req := &StreamRequest{
		RequestID: generateRequestID(),
		Type:      StreamRequestTypeUnsubscribe,
		Topic:     topic,
	}

	c.logger.Info().Str("topic", topic).Msg("unsubscribing from topic")

	if err := c.sendStreamRequest(ctx, req); err != nil {
		// Re-add subscription on failure
		c.logger.Error().Err(err).Str("topic", topic).Msg("unsubscribe failed")
		return fmt.Errorf("send unsubscribe request: %w", err)
	}

	// Close channel if exists
	c.chanMu.Lock()
	if mc, ok := c.channels[topic]; ok {
		close(mc.Ch)
		delete(c.channels, topic)
	}
	c.chanMu.Unlock()

	grpcActiveSubscriptions.WithLabelValues(c.clientID).Dec()

	return nil
}

// ============================================================================
// PUBLIC API - PUBLISHING
// ============================================================================

// Publish sends a message to a topic with delivery confirmation
func (c *GRPCClient) Publish(ctx context.Context, topic string, payload []byte) error {
	_, err := c.PublishWithAck(ctx, topic, payload)
	return err
}

// PublishWithAck sends a message and waits for acknowledgment
func (c *GRPCClient) PublishWithAck(ctx context.Context, topic string, payload []byte) (*PublishAck, error) {
	if topic == "" {
		return nil, errors.New("topic cannot be empty")
	}
	if len(payload) == 0 {
		return nil, errors.New("payload cannot be empty")
	}

	if atomic.LoadInt32(&c.connected) == 0 {
		return nil, ErrNotConnected
	}

	requestID := generateRequestID()
	req := &StreamRequest{
		RequestID: requestID,
		Type:      StreamRequestTypePublish,
		Topic:     topic,
		Payload:   payload,
	}

	// Create pending ack
	pending := &pendingAck{
		RequestID: requestID,
		Topic:     topic,
		Payload:   payload,
		CreatedAt: time.Now(),
		DoneC:     make(chan *PublishAck, 1),
		ErrC:      make(chan error, 1),
	}

	c.ackMu.Lock()
	c.pendingAcks[requestID] = pending
	c.ackMu.Unlock()

	// Cleanup on exit
	defer func() {
		c.ackMu.Lock()
		delete(c.pendingAcks, requestID)
		c.ackMu.Unlock()
	}()

	c.logger.Debug().
		Str("topic", topic).
		Str("request_id", requestID).
		Int("payload_size", len(payload)).
		Msg("publishing message")

	// Send publish request
	if err := c.sendStreamRequest(ctx, req); err != nil {
		grpcMessagesPublished.WithLabelValues(topic, c.clientID, "send_error").Inc()
		return nil, fmt.Errorf("send publish request: %w", err)
	}

	// Wait for acknowledgment
	select {
	case <-ctx.Done():
		grpcMessagesPublished.WithLabelValues(topic, c.clientID, "timeout").Inc()
		return nil, ctx.Err()
	case ack := <-pending.DoneC:
		return ack, nil
	case err := <-pending.ErrC:
		return nil, err
	}
}

// PublishAsync sends a message without waiting for acknowledgment
func (c *GRPCClient) PublishAsync(topic string, payload []byte) error {
	if topic == "" {
		return errors.New("topic cannot be empty")
	}
	if len(payload) == 0 {
		return errors.New("payload cannot be empty")
	}

	if atomic.LoadInt32(&c.connected) == 0 {
		return ErrNotConnected
	}

	req := &StreamRequest{
		RequestID: generateRequestID(),
		Type:      StreamRequestTypePublish,
		Topic:     topic,
		Payload:   payload,
	}

	c.logger.Debug().
		Str("topic", topic).
		Str("request_id", req.RequestID).
		Msg("publishing message (async)")

	// Fire and forget
	go func() {
		ctx, cancel := context.WithTimeout(c.ctx, 5*time.Second)
		defer cancel()

		if err := c.sendStreamRequest(ctx, req); err != nil {
			grpcMessagesPublished.WithLabelValues(topic, c.clientID, "async_error").Inc()
			c.logger.Error().Err(err).Str("topic", topic).Msg("async publish failed")
		} else {
			grpcMessagesPublished.WithLabelValues(topic, c.clientID, "async_sent").Inc()
		}
	}()

	return nil
}

// ============================================================================
// PUBLIC API - STREAMING
// ============================================================================

// StreamMessages returns a channel for receiving messages on a topic
func (c *GRPCClient) StreamMessages(ctx context.Context, topic string) (<-chan *Message, error) {
	if topic == "" {
		return nil, errors.New("topic cannot be empty")
	}

	// Check subscription
	c.subMu.RLock()
	_, ok := c.subscriptions[topic]
	c.subMu.RUnlock()

	if !ok {
		return nil, fmt.Errorf("not subscribed to topic %s", topic)
	}

	// Create or get channel
	c.chanMu.Lock()
	mc, ok := c.channels[topic]
	if !ok {
		mc = &messageChannel{
			Topic:     topic,
			Ch:        make(chan *Message, c.config.ChannelBufferSize),
			CreatedAt: time.Now(),
		}
		c.channels[topic] = mc
	}
	c.chanMu.Unlock()

	// Handle context cancellation
	go func() {
		<-ctx.Done()
		c.chanMu.Lock()
		if ch, ok := c.channels[topic]; ok && ch == mc {
			close(mc.Ch)
			delete(c.channels, topic)
		}
		c.chanMu.Unlock()
	}()

	return mc.Ch, nil
}

// StreamPatternMessages returns a channel for messages matching a pattern
func (c *GRPCClient) StreamPatternMessages(ctx context.Context, pattern string) (<-chan *Message, error) {
	if pattern == "" {
		return nil, errors.New("pattern cannot be empty")
	}

	// Check subscription
	c.subMu.RLock()
	_, ok := c.subscriptions[pattern]
	c.subMu.RUnlock()

	if !ok {
		return nil, fmt.Errorf("not subscribed to pattern %s", pattern)
	}

	// Create channel with pattern
	c.chanMu.Lock()
	mc := &messageChannel{
		Topic:     pattern,
		Pattern:   pattern,
		Ch:        make(chan *Message, c.config.ChannelBufferSize),
		CreatedAt: time.Now(),
	}
	c.channels[pattern] = mc
	c.chanMu.Unlock()

	// Handle context cancellation
	go func() {
		<-ctx.Done()
		c.chanMu.Lock()
		if ch, ok := c.channels[pattern]; ok && ch == mc {
			close(mc.Ch)
			delete(c.channels, pattern)
		}
		c.chanMu.Unlock()
	}()

	return mc.Ch, nil
}

// ============================================================================
// PUBLIC API - HISTORY
// ============================================================================

// GetHistory retrieves historical messages (replay)
func (c *GRPCClient) GetHistory(ctx context.Context, topic string, fromSeq, toSeq int64, limit int32) ([]*Message, error) {
	if topic == "" {
		return nil, errors.New("topic cannot be empty")
	}

	if atomic.LoadInt32(&c.connected) == 0 {
		return nil, ErrNotConnected
	}

	c.logger.Debug().
		Str("topic", topic).
		Int64("from_seq", fromSeq).
		Int64("to_seq", toSeq).
		Int32("limit", limit).
		Msg("requesting history")

	// In production, this would use a unary RPC:
	// resp, err := c.client.GetHistory(ctx, &HistoryRequest{...})

	// For now, fall back to HTTP client behavior
	return c.getHistoryFallback(ctx, topic, fromSeq, limit)
}

// getHistoryFallback uses the HTTP method as fallback
func (c *GRPCClient) getHistoryFallback(ctx context.Context, topic string, afterSeq int64, limit int32) ([]*Message, error) {
	// This would delegate to the HTTP client in production
	// For now, return empty as we don't have HTTP client reference
	c.logger.Debug().Str("topic", topic).Msg("history fallback (not implemented)")
	return []*Message{}, nil
}

// ReplayFrom requests message replay from a specific sequence
func (c *GRPCClient) ReplayFrom(ctx context.Context, topic string, fromSeq int64) error {
	if topic == "" {
		return errors.New("topic cannot be empty")
	}

	req := &StreamRequest{
		RequestID: generateRequestID(),
		Type:      StreamRequestTypeReplay,
		Topic:     topic,
		FromSeq:   fromSeq,
	}

	c.logger.Info().
		Str("topic", topic).
		Int64("from_seq", fromSeq).
		Msg("requesting replay")

	return c.sendStreamRequest(ctx, req)
}

// ============================================================================
// PUBLIC API - STATE
// ============================================================================

// GetSubscriber returns subscriber info for a topic
func (c *GRPCClient) GetSubscriber(topic string) (*Subscriber, bool) {
	c.subMu.RLock()
	defer c.subMu.RUnlock()

	sub, ok := c.subscriptions[topic]
	if !ok {
		return nil, false
	}

	return &Subscriber{
		SubscriberID: c.clientID,
		Topic:        sub.Topic,
		DisplayName:  sub.DisplayName,
		Status:       sub.Status,
		RequestedAt:  sub.CreatedAt,
	}, true
}

// IsApproved checks if subscription to topic is approved
func (c *GRPCClient) IsApproved(topic string) bool {
	c.subMu.RLock()
	defer c.subMu.RUnlock()

	sub, ok := c.subscriptions[topic]
	return ok && sub.Status == "approved"
}

// IsConnected returns the connection state
func (c *GRPCClient) IsConnected() bool {
	return atomic.LoadInt32(&c.connected) == 1
}

// GetLastSeq returns the last seen sequence for a topic
func (c *GRPCClient) GetLastSeq(topic string) int64 {
	c.seqMu.RLock()
	defer c.seqMu.RUnlock()
	return c.lastSeq[topic]
}

// GetMetrics returns current client metrics
func (c *GRPCClient) GetMetrics() map[string]interface{} {
	c.subMu.RLock()
	subCount := len(c.subscriptions)
	c.subMu.RUnlock()

	c.chanMu.RLock()
	chanCount := len(c.channels)
	c.chanMu.RUnlock()

	c.ackMu.RLock()
	pendingCount := len(c.pendingAcks)
	c.ackMu.RUnlock()

	return map[string]interface{}{
		"client_id":            c.clientID,
		"connected":            atomic.LoadInt32(&c.connected) == 1,
		"subscription_count":   subCount,
		"channel_count":        chanCount,
		"pending_ack_count":    pendingCount,
		"inflight_count":       atomic.LoadInt64(&c.inflightCount),
	}
}

// ============================================================================
// PUBLIC API - LIFECYCLE
// ============================================================================

// Close closes the client and all connections
func (c *GRPCClient) Close() error {
	if !atomic.CompareAndSwapInt32(&c.closed, 0, 1) {
		return nil // Already closed
	}

	c.logger.Info().Msg("closing gRPC client")

	// Cancel context
	c.cancel()

	// Close stream
	c.streamMu.Lock()
	if c.streamCancel != nil {
		c.streamCancel()
	}
	c.streamMu.Unlock()

	// Close connection
	c.connMu.Lock()
	if c.conn != nil {
		c.conn.Close()
	}
	c.connMu.Unlock()

	// Close all channels
	c.chanMu.Lock()
	for topic, mc := range c.channels {
		close(mc.Ch)
		delete(c.channels, topic)
	}
	c.chanMu.Unlock()

	// Fail pending acks
	c.ackMu.Lock()
	for _, pending := range c.pendingAcks {
		select {
		case pending.ErrC <- errors.New("client closed"):
		default:
		}
	}
	c.pendingAcks = make(map[string]*pendingAck)
	c.ackMu.Unlock()

	// Wait for goroutines
	c.wg.Wait()

	// Update metrics
	grpcConnectionState.WithLabelValues(c.clientID).Set(0)
	grpcActiveSubscriptions.WithLabelValues(c.clientID).Set(0)

	c.logger.Info().Msg("gRPC client closed")
	return nil
}

// ============================================================================
// INTERNAL HELPERS
// ============================================================================

// sendStreamRequest sends a request on the bidirectional stream
func (c *GRPCClient) sendStreamRequest(ctx context.Context, req *StreamRequest) error {
	c.streamMu.RLock()
	defer c.streamMu.RUnlock()

	if atomic.LoadInt32(&c.connected) == 0 {
		return ErrNotConnected
	}

	// Add tracing metadata if enabled
	if c.config.EnableTracing {
		if req.Metadata == nil {
			req.Metadata = make(map[string]string)
		}
		if traceID := extractTraceID(ctx); traceID != "" {
			req.Metadata["trace_id"] = traceID
		}
	}

	// In production, this would send on the actual gRPC stream:
	// return c.stream.Send(req)

	// For now, log the request (simulation)
	c.logger.Debug().
		Str("request_id", req.RequestID).
		Int32("type", int32(req.Type)).
		Str("topic", req.Topic).
		Msg("stream request sent")

	return nil
}

// extractTraceID extracts trace ID from context
func extractTraceID(ctx context.Context) string {
	// Check for OpenTelemetry trace ID
	if md, ok := metadata.FromIncomingContext(ctx); ok {
		if vals := md.Get("x-trace-id"); len(vals) > 0 {
			return vals[0]
		}
	}
	return ""
}

// generateClientID creates a unique client identifier
func generateClientID() string {
	return fmt.Sprintf("grpc-%d-%d", time.Now().UnixNano(), time.Now().Nanosecond()%1000)
}

// generateRequestID creates a unique request identifier
func generateRequestID() string {
	return fmt.Sprintf("%d-%d", time.Now().UnixNano(), atomic.AddInt64(&requestCounter, 1))
}

var requestCounter int64

// ============================================================================
// GRPC CLIENT OPTIONS
// ============================================================================

// GRPCClientOption configures the gRPC client
type GRPCClientOption func(*GRPCClientConfig)

// WithAddresses sets the server addresses
func WithAddresses(addrs ...string) GRPCClientOption {
	return func(c *GRPCClientConfig) {
		c.Addresses = addrs
	}
}

// WithClientID sets the client identifier
func WithClientID(id string) GRPCClientOption {
	return func(c *GRPCClientConfig) {
		c.ClientID = id
	}
}

// WithDisplayName sets the client display name
func WithDisplayName(name string) GRPCClientOption {
	return func(c *GRPCClientConfig) {
		c.DisplayName = name
	}
}

// WithTLS configures TLS
func WithTLS(config *tls.Config) GRPCClientOption {
	return func(c *GRPCClientConfig) {
		c.TLSConfig = config
		c.Insecure = false
	}
}

// WithInsecure disables TLS
func WithInsecure() GRPCClientOption {
	return func(c *GRPCClientConfig) {
		c.Insecure = true
	}
}

// WithConnectTimeout sets connection timeout
func WithConnectTimeout(d time.Duration) GRPCClientOption {
	return func(c *GRPCClientConfig) {
		c.ConnectTimeout = d
	}
}

// WithKeepalive configures keepalive settings
func WithKeepalive(time, timeout time.Duration) GRPCClientOption {
	return func(c *GRPCClientConfig) {
		c.KeepAliveTime = time
		c.KeepAliveTimeout = timeout
	}
}

// WithRetry configures retry behavior
func WithRetry(maxRetries int, initialBackoff, maxBackoff time.Duration) GRPCClientOption {
	return func(c *GRPCClientConfig) {
		c.MaxRetries = maxRetries
		c.InitialBackoff = initialBackoff
		c.MaxBackoff = maxBackoff
	}
}

// WithBackpressure configures backpressure handling
func WithBackpressure(threshold float64, dropOnBackpressure bool) GRPCClientOption {
	return func(c *GRPCClientConfig) {
		c.BackpressureThreshold = threshold
		c.DropOnBackpressure = dropOnBackpressure
	}
}

// WithChannelBufferSize sets the message channel buffer size
func WithChannelBufferSize(size int) GRPCClientOption {
	return func(c *GRPCClientConfig) {
		c.ChannelBufferSize = size
	}
}

// WithLogger sets the logger
func WithLogger(logger zerolog.Logger) GRPCClientOption {
	return func(c *GRPCClientConfig) {
		c.Logger = logger
	}
}

// WithTracing enables/disables tracing
func WithTracing(enabled bool) GRPCClientOption {
	return func(c *GRPCClientConfig) {
		c.EnableTracing = enabled
	}
}

// NewGRPCClientWithOptions creates a client with functional options
func NewGRPCClientWithOptions(opts ...GRPCClientOption) (*GRPCClient, error) {
	config := DefaultGRPCClientConfig()
	for _, opt := range opts {
		opt(config)
	}
	return NewGRPCClient(config)
}

// ============================================================================
// INTERFACE COMPATIBILITY
// ============================================================================

// BusboyClient defines the interface that both HTTP and gRPC clients implement
type BusboyClient interface {
	// Subscription management
	Subscribe(ctx context.Context, topic, displayName string) (*Subscriber, error)
	Unsubscribe(ctx context.Context, topic string) error

	// Publishing
	Publish(ctx context.Context, topic string, payload []byte) error

	// Message streaming
	StreamMessages(ctx context.Context, topic string) (<-chan *Message, error)

	// State queries
	GetSubscriber(topic string) (*Subscriber, bool)
	IsApproved(topic string) bool

	// Lifecycle
	Close() error
}

// Verify GRPCClient implements BusboyClient
var _ BusboyClient = (*GRPCClient)(nil)

// ============================================================================
// LOAD BALANCING HELPERS
// ============================================================================

// ResolverBuilder builds custom resolvers for client-side load balancing
type ResolverBuilder struct {
	addresses []string
}

// NewResolverBuilder creates a resolver builder for the given addresses
func NewResolverBuilder(addresses []string) *ResolverBuilder {
	return &ResolverBuilder{addresses: addresses}
}

// ============================================================================
// CONNECTION POOL (FOR ADVANCED USE CASES)
// ============================================================================

// GRPCClientPool manages a pool of gRPC clients for high-throughput scenarios
type GRPCClientPool struct {
	clients  []*GRPCClient
	size     int
	counter  uint64
	mu       sync.RWMutex
	config   *GRPCClientConfig
	logger   zerolog.Logger
}

// NewGRPCClientPool creates a pool of gRPC clients
func NewGRPCClientPool(size int, config *GRPCClientConfig) (*GRPCClientPool, error) {
	if size <= 0 {
		size = 1
	}
	if config == nil {
		config = DefaultGRPCClientConfig()
	}

	pool := &GRPCClientPool{
		clients: make([]*GRPCClient, 0, size),
		size:    size,
		config:  config,
		logger:  config.Logger.With().Str("component", "pool").Logger(),
	}

	for i := 0; i < size; i++ {
		clientConfig := *config
		clientConfig.ClientID = fmt.Sprintf("%s-pool-%d", config.ClientID, i)

		client, err := NewGRPCClient(&clientConfig)
		if err != nil {
			pool.Close()
			return nil, fmt.Errorf("create pool client %d: %w", i, err)
		}
		pool.clients = append(pool.clients, client)
	}

	return pool, nil
}

// Connect connects all clients in the pool
func (p *GRPCClientPool) Connect(ctx context.Context) error {
	for i, client := range p.clients {
		if err := client.Connect(ctx); err != nil {
			return fmt.Errorf("connect pool client %d: %w", i, err)
		}
	}
	return nil
}

// Get returns a client from the pool using round-robin
func (p *GRPCClientPool) Get() *GRPCClient {
	p.mu.RLock()
	defer p.mu.RUnlock()

	if len(p.clients) == 0 {
		return nil
	}

	idx := atomic.AddUint64(&p.counter, 1) % uint64(len(p.clients))
	return p.clients[idx]
}

// Publish publishes a message using a pooled client
func (p *GRPCClientPool) Publish(ctx context.Context, topic string, payload []byte) error {
	client := p.Get()
	if client == nil {
		return errors.New("no clients available")
	}
	return client.Publish(ctx, topic, payload)
}

// Close closes all clients in the pool
func (p *GRPCClientPool) Close() error {
	p.mu.Lock()
	defer p.mu.Unlock()

	var lastErr error
	for _, client := range p.clients {
		if err := client.Close(); err != nil {
			lastErr = err
		}
	}
	p.clients = nil
	return lastErr
}

// ============================================================================
// BACKPRESSURE STRATEGIES
// ============================================================================

// BackpressureStrategy defines how to handle backpressure
type BackpressureStrategy int

const (
	// BackpressureBlock blocks until buffer space is available
	BackpressureBlock BackpressureStrategy = iota
	// BackpressureDrop drops messages when buffer is full
	BackpressureDrop
	// BackpressureEvictOldest evicts oldest messages when buffer is full
	BackpressureEvictOldest
)

// ============================================================================
// UTILITIES
// ============================================================================

// calculateBackoff calculates exponential backoff with jitter
func calculateBackoff(attempt int, initial, max time.Duration, multiplier float64) time.Duration {
	backoff := float64(initial) * math.Pow(multiplier, float64(attempt-1))
	if backoff > float64(max) {
		backoff = float64(max)
	}

	// Add jitter (+-10%)
	jitter := backoff * 0.1 * (0.5 - float64(time.Now().UnixNano()%100)/100)
	return time.Duration(backoff + jitter)
}

// protoToMessage converts protobuf message to domain message
func protoToMessage(p *MessageProto) *Message {
	if p == nil {
		return nil
	}

	msg := &Message{
		MessageID: p.MessageID,
		Topic:     p.Topic,
		SenderID:  p.SenderID,
		Seq:       p.Seq,
		Payload:   string(p.Payload),
		Deleted:   p.Deleted,
	}

	if p.CreatedAt != nil {
		msg.CreatedAt = p.CreatedAt.AsTime()
	}

	return msg
}

// messageToProto converts domain message to protobuf message
func messageToProto(m *Message) *MessageProto {
	if m == nil {
		return nil
	}

	return &MessageProto{
		MessageID: m.MessageID,
		Topic:     m.Topic,
		SenderID:  m.SenderID,
		CreatedAt: timestamppb.New(m.CreatedAt),
		Seq:       m.Seq,
		Payload:   []byte(m.Payload),
		Deleted:   m.Deleted,
	}
}

// Compile-time check that MessageProto implements proto.Message interface
// This would be automatic with protoc-generated code
var _ proto.Message = (*timestamppb.Timestamp)(nil)
