# The Well — PostgreSQL Configuration
# Copy to .env and customize for your environment

# Superuser (postgres init only)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=unheaded
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
POSTGRES_DB=postgres
POSTGRES_SSLMODE=require

# Service-role passwords: db/init.sh sets each role's password from these on
# an empty volume. Leave one empty and that role cannot log in. Generate,
# e.g. `openssl rand -base64 24`; never commit the filled-in file.

# ═══ unheaded_app — service-scoped users ═══
APP_KANBAN_PASSWORD=
APP_TIMEGURU_PASSWORD=
APP_ZHEN_PASSWORD=
# API keys (migration 036): unheaded-cli apikey, AUTH_APIKEY_STORE=well
APP_AUTH_PASSWORD=

# ═══ unheaded_ops — operations users ═══
OPS_WRITER_PASSWORD=
OPS_READER_PASSWORD=
# The retention job (migrations 042/043, cmd/well-retention)
RETENTION_RUNNER_PASSWORD=
# The log store writer (migration 048, cmd/logstore-writer)
LOG_WRITER_PASSWORD=

# ═══ unheaded_config — config users ═══
CONFIG_ADMIN_PASSWORD=
CONFIG_READER_PASSWORD=

# ═══ monitoring ═══
HUGINN_READER_PASSWORD=

# Other compose services (docker-compose.yml fails loud without them)
GRAFANA_ADMIN_PASSWORD=
CLICKHOUSE_PASSWORD=
# Vector presents it to logstore-writer; 32 bytes or more (openssl rand -hex 32)
LOGSTORE_INGEST_TOKEN=

# Compose publishes bind 127.0.0.1. A host that serves peers names the address
# for each (wiki/Port-Registry.md, Compose publishes). It must exist when the
# container starts.
# UNHEADED_P2P_BIND=192.168.13.2
# UNHEADED_OVERLAY_BIND=[fd00:dead:beef::1]
# UNHEADED_LAN_BIND=
# docker0's gateway, where VictoriaMetrics scrapes. Only if a host's docker0
# is not 172.17.0.1.
# UNHEADED_GATEWAY_BIND=172.17.0.1

# Verify the Well's certificate instead of only encrypting (default: require).
# Both or neither; a client told to verify without the CA refuses to start.
# WELL_SSLMODE=verify-full
# WELL_SSLROOTCERT=/etc/unheaded/well-tls/ca.crt
