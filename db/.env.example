# The Well — PostgreSQL Configuration
# Copy to .env and customize for your environment

# Superuser (postgres init only)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=unheaded
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
POSTGRES_DB=unheaded
POSTGRES_SSLMODE=disable

# Service-role passwords: db/init.sh sets each role's password from these on
# an empty volume. Leave one empty and that role cannot log in. Generate,
# e.g. `openssl rand -base64 24`; never commit the filled-in file.

# ═══ unheaded_app — service-scoped users ═══
APP_KANBAN_PASSWORD=
APP_TIMEGURU_PASSWORD=
APP_ZHEN_PASSWORD=

# ═══ unheaded_ops — operations users ═══
OPS_WRITER_PASSWORD=
OPS_READER_PASSWORD=

# ═══ unheaded_config — config users ═══
CONFIG_ADMIN_PASSWORD=
CONFIG_READER_PASSWORD=

# ═══ monitoring ═══
HUGINN_READER_PASSWORD=
