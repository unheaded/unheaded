# The Well — PostgreSQL Configuration
# Copy to .env and customize for your environment

# Superuser (postgres init only)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=unheaded
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
POSTGRES_DB=unheaded
POSTGRES_SSLMODE=disable

# ═══ unheaded_app — service-scoped users ═══
APP_KANBAN_PASSWORD=kanban_dev
APP_TIMEGURU_PASSWORD=timeguru_dev
APP_ZHEN_PASSWORD=zhen_dev

# ═══ unheaded_ops — operations users ═══
OPS_WRITER_PASSWORD=ops_writer_dev
OPS_READER_PASSWORD=ops_reader_dev

# ═══ unheaded_config — config users ═══
CONFIG_ADMIN_PASSWORD=config_admin_dev
CONFIG_READER_PASSWORD=config_reader_dev
