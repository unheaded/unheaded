# Install (users first: deploy/sysusers.d/unheaded.conf, see its header):
#   sudo cp deploy/systemd/unheaded-kanban.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl start unheaded-kanban    # manual only — NOT enabled on boot

[Unit]
Description=Unheaded kanban — task board (the meta moment)
Documentation=https://github.com/unheaded/unheaded/tree/main/cmd/kanban-app
After=network-online.target unheaded-wotan.service
Wants=network-online.target
Requires=unheaded-wotan.service

[Service]
Type=simple
Environment=PORT=20001
EnvironmentFile=-/etc/unheaded/kanban.env
ExecStart=/usr/local/bin/kanban-app
WorkingDirectory=/var/lib/unheaded/kanban
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s

LimitNOFILE=4096

# Service identity (ADR-103, deploy/systemd/README.md#keys-adr-103): the key
# comes from `unheaded-keygen -owner unheaded-kanban kanban-app` (root, once per host).
Environment=AUTH_KEY_FILE=/etc/unheaded/keys/kanban-app.key
Environment=AUTH_TRUST_DIR=/etc/unheaded/trust.d
# S-IRON-GATE Phase 6: reads stay open; a write needs an operator login on
# the board (pkg/bff against the host's issuer, unheaded-auth.service, which
# must list kanban-app in -audiences) or a token from these callers.
Environment=AUTH_ENABLED=true
Environment=AUTH_ISSUER_URL=https://%H:19020
Environment=AUTH_ALLOW_CALLERS=dashboard-backend,zhen-agentd,micromanager
ReadOnlyPaths=-/etc/unheaded/trust.d
# TLS (S-IRON-GATE Phase 8, ADR-105, FND-017; deploy/systemd/README.md#tls):
# TLS 1.3 with hybrid ML-KEM on the listener and every first-party link.
# Material in /etc/unheaded/tls/kanban-app/ from the Kingdom CA runbook
# (runbooks/pki/generate-kingdom-certs.yaml); key root:unheaded-kanban 0640, certs 0644.
Environment=UNHEADED_TLS_ENABLED=true
Environment=UNHEADED_TLS_CA_CERT=/etc/unheaded/tls/kanban-app/ca.pem
Environment=UNHEADED_TLS_CERT=/etc/unheaded/tls/kanban-app/kanban-app.pem
Environment=UNHEADED_TLS_KEY_FILE=/etc/unheaded/tls/kanban-app/kanban-app-key.pem
Environment=UNHEADED_TLS_MTLS_ENABLED=false
ReadOnlyPaths=-/etc/unheaded/tls/kanban-app

User=unheaded-kanban
Group=unheaded-kanban
StateDirectory=unheaded/kanban
StateDirectoryMode=0700
UMask=0077

# Sandbox (deploy/systemd/README.md#isolation). The user comes from
# deploy/sysusers.d/unheaded.conf: system account, /usr/sbin/nologin.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @reboot @module @swap
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
