# Install (users first: deploy/sysusers.d/unheaded.conf, see its header):
#   sudo cp deploy/systemd/unheaded-kanban.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl start unheaded-kanban    # manual only — NOT enabled on boot

[Unit]
Description=Unheaded kanban — task board (the meta moment)
Documentation=https://github.com/unheaded/unheaded/tree/main/cmd/kanban-app
After=network-online.target unheaded-wotan.service
Wants=network-online.target
Requires=unheaded-wotan.service

[Service]
Type=simple
Environment=PORT=20001
EnvironmentFile=-/etc/unheaded/kanban.env
ExecStart=/usr/local/bin/kanban-app
WorkingDirectory=/var/lib/unheaded/kanban
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s

LimitNOFILE=4096

User=unheaded-kanban
Group=unheaded-kanban
StateDirectory=unheaded/kanban
StateDirectoryMode=0700
UMask=0077

# Sandbox (deploy/systemd/README.md#isolation). The user comes from
# deploy/sysusers.d/unheaded.conf: system account, /usr/sbin/nologin.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @reboot @module @swap
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
