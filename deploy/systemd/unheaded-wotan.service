# Install (users first: deploy/sysusers.d/unheaded.conf, see its header):
#   sudo cp deploy/systemd/unheaded-wotan.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl start unheaded-wotan    # manual only — NOT enabled on boot

[Unit]
Description=Unheaded Wotan — message bus and distributed memory
Documentation=https://github.com/unheaded/unheaded/tree/main/services/wotan
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/unheaded/wotan.env
# WOTAN_ADMIN_API_KEY (deploy/systemd/wotan.env.example). Admin endpoints stay
# off unless ExecStart also passes --admin; --admin without the key exits.
EnvironmentFile=-/etc/unheaded/wotan/wotan.env
ExecStart=/usr/local/bin/wotan \
    --http-port 18000 \
    --grpc-port 18001 \
    --topic-config /etc/unheaded/wotan.yaml \
    --enable-tls \
    --tls-cert /etc/unheaded/tls/wotan/wotan.pem \
    --tls-key /etc/unheaded/tls/wotan/wotan-key.pem
WorkingDirectory=/var/lib/unheaded/wotan
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s

LimitNOFILE=65536

# Service identity (ADR-103, deploy/systemd/README.md#keys-adr-103): the key
# comes from `unheaded-keygen -owner unheaded-wotan wotan` (root, once per host).
Environment=AUTH_KEY_FILE=/etc/unheaded/keys/wotan.key
Environment=AUTH_TRUST_DIR=/etc/unheaded/trust.d
# S-IRON-GATE Phase 7 (ADR-103 §6): every call needs a service token for
# aud=wotan from one of these identities; auto-approve keys on its sub.
Environment=AUTH_ENABLED=true
Environment=AUTH_ALLOW_CALLERS=akira,anomaly,architect,captain,chaos-controller,dashboard-backend,gateway,heimdall,kanban-app,kev-poller,micromanager,monad,perf-benchmark,shield,sophia,sword,timeguru,trace-collector,unheaded-baseline,unheaded-cli,unheaded-daemon,zhen-agentd,zhen-claude
ReadOnlyPaths=-/etc/unheaded/trust.d
# TLS (S-IRON-GATE Phase 8, ADR-105, FND-017; deploy/systemd/README.md#tls):
# TLS 1.3 with hybrid ML-KEM on the listener and every first-party link.
# Material in /etc/unheaded/tls/wotan/ from the Kingdom CA runbook
# (runbooks/pki/generate-kingdom-certs.yaml); key root:unheaded-wotan 0640, certs 0644.
Environment=UNHEADED_TLS_ENABLED=true
Environment=UNHEADED_TLS_CA_CERT=/etc/unheaded/tls/wotan/ca.pem
Environment=UNHEADED_TLS_CERT=/etc/unheaded/tls/wotan/wotan.pem
Environment=UNHEADED_TLS_KEY_FILE=/etc/unheaded/tls/wotan/wotan-key.pem
Environment=UNHEADED_TLS_MTLS_ENABLED=false
ReadOnlyPaths=-/etc/unheaded/tls/wotan

User=unheaded-wotan
Group=unheaded-wotan
StateDirectory=unheaded/wotan
StateDirectoryMode=0700
UMask=0077

# Sandbox (deploy/systemd/README.md#isolation). The user comes from
# deploy/sysusers.d/unheaded.conf: system account, /usr/sbin/nologin.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @reboot @module @swap
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
