# Install:
#   sudo cp deploy/systemd/unheaded-akira.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl start unheaded-akira    # manual only — NOT enabled on boot

[Unit]
Description=Unheaded akira — health monitor and service sweep
Documentation=https://github.com/unheaded/unheaded/tree/main/cmd/akira
After=network-online.target unheaded-wotan.service
Wants=network-online.target
Requires=unheaded-wotan.service

[Service]
Type=simple
User=unheaded
Group=unheaded
EnvironmentFile=-/etc/unheaded/akira.env
ExecStart=/usr/local/bin/akira --port 19100
WorkingDirectory=/var/lib/unheaded/akira
Restart=on-failure
RestartSec=10s
TimeoutStopSec=15s

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/unheaded/akira
SystemCallFilter=@system-service
SystemCallFilter=~@privileged ~@resources ~@reboot ~@module ~@swap
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
