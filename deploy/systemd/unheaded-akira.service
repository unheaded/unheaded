# Install (users first: deploy/sysusers.d/unheaded.conf, see its header):
#   sudo cp deploy/systemd/unheaded-akira.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl start unheaded-akira    # manual only — NOT enabled on boot

[Unit]
Description=Unheaded akira — health monitor and service sweep
Documentation=https://github.com/unheaded/unheaded/tree/main/cmd/akira
After=network-online.target unheaded-wotan.service
Wants=network-online.target
Requires=unheaded-wotan.service

[Service]
Type=simple
EnvironmentFile=-/etc/unheaded/akira.env
ExecStart=/usr/local/bin/akira --port 19100
WorkingDirectory=/var/lib/unheaded/akira
Restart=on-failure
RestartSec=10s
TimeoutStopSec=15s

LimitNOFILE=4096

User=unheaded-akira
Group=unheaded-akira
StateDirectory=unheaded/akira
StateDirectoryMode=0700
UMask=0077

# Sandbox (deploy/systemd/README.md#isolation). The user comes from
# deploy/sysusers.d/unheaded.conf: system account, /usr/sbin/nologin.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @reboot @module @swap
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
