# Install (users first: deploy/sysusers.d/unheaded.conf, see its header):
#   sudo cp deploy/systemd/unheaded-akira.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl start unheaded-akira    # manual only — NOT enabled on boot

[Unit]
Description=Unheaded akira — health monitor and service sweep
Documentation=https://github.com/unheaded/unheaded/tree/main/cmd/akira
After=network-online.target unheaded-wotan.service
Wants=network-online.target
Requires=unheaded-wotan.service

[Service]
Type=simple
# AKIRA_OPTS in akira.env carries host-specific flags, e.g.
# AKIRA_OPTS=--config /etc/unheaded/akira.yaml (the targets this host runs);
# unset, akira checks its built-in target list.
EnvironmentFile=-/etc/unheaded/akira.env
ExecStart=/usr/local/bin/akira --port 19100 $AKIRA_OPTS
WorkingDirectory=/var/lib/unheaded/akira
Restart=on-failure
RestartSec=10s
TimeoutStopSec=15s

LimitNOFILE=4096

# Service identity (ADR-103, deploy/systemd/README.md#keys-adr-103): the key
# comes from `unheaded-keygen -owner unheaded-akira akira` (root, once per host);
# Akira presents it to Wotan.
Environment=AUTH_KEY_FILE=/etc/unheaded/keys/akira.key
Environment=AUTH_TRUST_DIR=/etc/unheaded/trust.d
# S-IRON-GATE Phase 6 recipe: every route but /health /ready /metrics and the
# GET consensus read /api/v1/status needs a service token. No service calls
# Akira's API, so no caller is allowed (a token is 403).
Environment=AUTH_ENABLED=true
ReadOnlyPaths=-/etc/unheaded/trust.d
# TLS (S-IRON-GATE Phase 8, ADR-105, FND-017; deploy/systemd/README.md#tls):
# TLS 1.3 with hybrid ML-KEM on the listener and every first-party link.
# Material in /etc/unheaded/tls/akira/ from the Kingdom CA runbook
# (runbooks/pki/generate-kingdom-certs.yaml); key root:unheaded-akira 0640, certs 0644.
Environment=UNHEADED_TLS_ENABLED=true
Environment=UNHEADED_TLS_CA_CERT=/etc/unheaded/tls/akira/ca.pem
Environment=UNHEADED_TLS_CERT=/etc/unheaded/tls/akira/akira.pem
Environment=UNHEADED_TLS_KEY_FILE=/etc/unheaded/tls/akira/akira-key.pem
Environment=UNHEADED_TLS_MTLS_ENABLED=false
ReadOnlyPaths=-/etc/unheaded/tls/akira
# Signed health topics (S-IRON-GATE Phase 9, M-053): system.health.consensus
# and system.health.remediate take only ML-DSA-65 signed messages. Without a
# key Akira does not publish them at all (akira_signed_publish_refused_total);
# reports still go out. To sign, per host: `unheaded-keygen -algo mldsa65
# -owner unheaded-akira akira-health` (root), enrol the public key it prints
# under both prefixes in Wotan's signed_prefixes, then set in akira.env:
#   HEALTH_SIGNING_KEY_FILE=/etc/unheaded/keys/akira-health.key
# (0400 unheaded-akira; a named key that is unreadable or group/other
# readable stops Akira at start). Signed publishes go over gRPC (:18001,
# or --wotan-grpc in AKIRA_OPTS).

User=unheaded-akira
Group=unheaded-akira
StateDirectory=unheaded/akira
StateDirectoryMode=0700
UMask=0077

# Sandbox (deploy/systemd/README.md#isolation). The user comes from
# deploy/sysusers.d/unheaded.conf: system account, /usr/sbin/nologin.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @reboot @module @swap
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
