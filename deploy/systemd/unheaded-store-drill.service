# SPDX-License-Identifier: GPL-3.0-or-later
# ClickHouse and VictoriaMetrics: the weekly restore drill (ADR-147 decision
# 6, S-SEE-AND-SURVIVE Phase 9). scripts/backup/store-drill.sh restores the
# newest set of each into a throwaway container (scratch under
# /srv/backups/.drill-*), compares counts and removes it; both run every
# time. Root for the docker socket and to own the scratch for the stores'
# uids. The files it runs are root-owned copies, never the repo's.
# Install (S-SEE-AND-SURVIVE Phase 13; the three store-backup units together):
#   sudo install -d -m 0755 /usr/local/lib/unheaded/backup
#   sudo install -m 0755 scripts/backup/{lib-disks,clickhouse-backup,clickhouse-drill,victoria-backup,victoria-drill,store-drill}.sh /usr/local/lib/unheaded/backup/
#   sudo install -m 0644 config/clickhouse/backups.xml /usr/local/lib/unheaded/backup/clickhouse-backups.xml
#   sudo install -d -m 0700 -o 16707 -g 16707 /srv/backups/unheaded-clickhouse
#   sudo install -d -m 0700 /srv/backups/unheaded-victoria
#   sudo cp deploy/systemd/unheaded-{clickhouse-backup,victoria-backup,store-drill}.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now unheaded-clickhouse-backup.timer unheaded-victoria-backup.timer unheaded-store-drill.timer

[Unit]
Description=ClickHouse and VictoriaMetrics: weekly restore drill (ADR-147)
After=docker.service unheaded-clickhouse-backup.service unheaded-victoria-backup.service
Requires=docker.service

[Service]
Type=oneshot
Environment=CH_BACKUP_DIR=/srv/backups/unheaded-clickhouse
Environment=VM_BACKUP_DIR=/srv/backups/unheaded-victoria
Environment=STORE_METRICS_DIR=/var/lib/unheaded/textfile
Environment=DOCKER_CONFIG=/run/unheaded-store-drill
RuntimeDirectory=unheaded-store-drill
ExecStart=/usr/local/lib/unheaded/backup/store-drill.sh
TimeoutStartSec=45min
Nice=10
IOSchedulingClass=idle
UMask=0077

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/backups /var/lib/unheaded/textfile
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_CHOWN CAP_FOWNER
