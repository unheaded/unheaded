# Native syslog relay (ADR-124). RFC 5424 and RFC 3164 over UDP and TCP in,
# the journal's native protocol out, so Vector's journald source ships it.
# west only; Pi-hole sends here, LAN devices after D7.
#
# Port 514 comes from unheaded-syslog-relay.socket (socket activation, answer
# #18 of 2026-11-09): systemd binds it and passes the sockets, so the relay
# holds no capability. Each --listen below must match one socket there, or
# the relay refuses to start.
#
# Install (users first: deploy/sysusers.d/unheaded.conf, see its header), by
# hand or as the unheaded-syslog-relay .deb:
#   sudo install -m 0755 syslog-relay /usr/local/bin/
#   sudo install -D -m 0644 config/logging/sources.yaml /etc/unheaded/log-sources.yaml
#   sudo cp deploy/systemd/unheaded-syslog-relay.service deploy/systemd/unheaded-syslog-relay.socket /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now unheaded-syslog-relay.socket unheaded-syslog-relay.service
#
# A new sender: add its row to the sources file, then systemctl reload. A LAN
# listener (D7) also needs its socket and subnet in the .socket unit, its
# --listen and subnet here, and the firewall rule, which is Stevie's.

[Unit]
Description=Unheaded syslog relay: syslog in, journal out
Documentation=https://github.com/unheaded/unheaded/blob/develop/docs/adr/ADR-124-native-syslog-relay.md
After=network-online.target
Wants=network-online.target
# The 514 sockets (FreeBind there, so lxdbr0 need not be up yet).
Requires=unheaded-syslog-relay.socket
After=unheaded-syslog-relay.socket
# [fd00:dead:beef::1] is wg0's; the metrics listener retries until it exists.
After=snap.lxd.daemon.service wg-quick@wg0.service

[Service]
Type=simple
# --metrics twice: Prometheus runs in a container and cannot reach loopback,
# so it scrapes the overlay address; loopback is for the host (Appendix A2).
ExecStart=/usr/local/bin/syslog-relay --listen udp://10.10.20.1:514 --listen tcp://10.10.20.1:514 --sources /etc/unheaded/log-sources.yaml --metrics 127.0.0.1:9599 --metrics [fd00:dead:beef::1]:9599
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=30s
TimeoutStopSec=15s

LimitNOFILE=1024
MemoryMax=128M
MemoryHigh=115M
Environment=GOMEMLIMIT=115MiB

User=unheaded-syslog-relay
Group=unheaded-syslog-relay
UMask=0077

# No capability: systemd binds 514 (unheaded-syslog-relay.socket).
CapabilityBoundingSet=
# Its own user namespace: no other uid is visible, and none of the host's
# capabilities apply. Passed sockets work across it.
PrivateUsers=yes

# Sandbox (deploy/systemd/README.md#isolation). The user comes from
# deploy/sysusers.d/unheaded.conf: system account, /usr/sbin/nologin.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
# Hides /proc/stat: process_start_time_seconds is simply absent.
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @reboot @module @swap
SystemCallErrorNumber=EPERM

# It binds only its metrics port itself (514 arrives bound), and talks to
# nothing else. Enforced in the kernel, in front of the relay's own allowlist.
# The IP list below covers the sockets this service opens; the .socket unit
# carries its own for 514. Both name lxdbr0, so a connection accepted on the
# passed TCP socket passes whichever list the kernel applies to it.
SocketBindDeny=any
SocketBindAllow=tcp:9599
IPAddressDeny=any
IPAddressAllow=localhost
IPAddressAllow=10.10.20.0/24
IPAddressAllow=fd00:dead:beef::/48
# The scrapes arrive from the container networks' own addresses:
# Prometheus (monitoring stack) and VictoriaMetrics (scrape network, ADR-117).
IPAddressAllow=fd00:d0c0:e703::/64
IPAddressAllow=fd00:d0c0:e706::/64

[Install]
WantedBy=multi-user.target
Also=unheaded-syslog-relay.socket
