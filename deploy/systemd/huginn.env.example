# huginn.env — environment for huginn.service
# Copy to /etc/huginn.env and set values for this host.

# VictoriaMetrics push target.
# EAST: push to WEST over P2P link
# HUGINN_VM=http://192.168.13.1:8428
# WEST: push to local victoria (Docker)
# HUGINN_VM=http://localhost:8428
HUGINN_VM=http://localhost:8428

# Host label used in Prometheus series (defaults to hostname if unset).
# HUGINN_HOST=east
