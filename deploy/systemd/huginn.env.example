# huginn.env — environment for huginn.service
# Copy to /etc/huginn.env (root:root 0600: systemd reads it as root) and set
# values for this host.

# VictoriaMetrics push target.
# EAST: push to WEST over P2P link (192.168.13.1 is east itself)
# HUGINN_VM=http://192.168.13.2:8428
# WEST: push to local victoria (Docker)
# HUGINN_VM=http://localhost:8428
HUGINN_VM=http://localhost:8428

# Host label used in Prometheus series (defaults to hostname if unset).
# HUGINN_HOST=east

# The Well: huginn_reader's password (only where /etc/huginn.yaml lists
# databases). The DSNs there carry no password; lib/pq reads this one.
# PGPASSWORD=
