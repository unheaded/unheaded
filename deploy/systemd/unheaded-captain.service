# Install (users first: deploy/sysusers.d/unheaded.conf, see its header):
#   sudo cp deploy/systemd/unheaded-captain.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl start unheaded-captain    # manual only — NOT enabled on boot

[Unit]
Description=Unheaded captain — strategy service
Documentation=https://github.com/unheaded/unheaded/tree/main/cmd/captain
After=network-online.target unheaded-wotan.service
Wants=network-online.target
Requires=unheaded-wotan.service

[Service]
Type=simple
Environment=HTTP_ADDR=0.0.0.0:19002
EnvironmentFile=-/etc/unheaded/captain.env
ExecStart=/usr/local/bin/captain
WorkingDirectory=/var/lib/unheaded/captain
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s

LimitNOFILE=4096

# Service identity (ADR-103, deploy/systemd/README.md#keys-adr-103): the key
# comes from `unheaded-keygen -owner unheaded-captain captain` (root, once per host).
Environment=AUTH_KEY_FILE=/etc/unheaded/keys/captain.key
Environment=AUTH_TRUST_DIR=/etc/unheaded/trust.d
# S-IRON-GATE Phase 6: every route but /health /ready /metrics needs a
# service token from one of these callers (none calls the API today).
Environment=AUTH_ENABLED=true
Environment=AUTH_ALLOW_CALLERS=architect,micromanager,dashboard-backend
ReadOnlyPaths=-/etc/unheaded/trust.d
# TLS (S-IRON-GATE Phase 8, ADR-105, FND-017; deploy/systemd/README.md#tls):
# TLS 1.3 with hybrid ML-KEM on the listener and every first-party link.
# Material in /etc/unheaded/tls/captain/ from the Kingdom CA runbook
# (runbooks/pki/generate-kingdom-certs.yaml); key root:unheaded-captain 0640, certs 0644.
Environment=UNHEADED_TLS_ENABLED=true
Environment=UNHEADED_TLS_CA_CERT=/etc/unheaded/tls/captain/ca.pem
Environment=UNHEADED_TLS_CERT=/etc/unheaded/tls/captain/captain.pem
Environment=UNHEADED_TLS_KEY_FILE=/etc/unheaded/tls/captain/captain-key.pem
Environment=UNHEADED_TLS_MTLS_ENABLED=false
ReadOnlyPaths=-/etc/unheaded/tls/captain

User=unheaded-captain
Group=unheaded-captain
StateDirectory=unheaded/captain
StateDirectoryMode=0700
UMask=0077

# Sandbox (deploy/systemd/README.md#isolation). The user comes from
# deploy/sysusers.d/unheaded.conf: system account, /usr/sbin/nologin.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @reboot @module @swap
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
