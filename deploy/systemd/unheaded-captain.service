# Install:
#   sudo cp deploy/systemd/unheaded-captain.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl start unheaded-captain    # manual only — NOT enabled on boot

[Unit]
Description=Unheaded captain — strategy service
Documentation=https://github.com/unheaded/unheaded/tree/main/cmd/captain
After=network-online.target unheaded-wotan.service
Wants=network-online.target
Requires=unheaded-wotan.service

[Service]
Type=simple
User=unheaded
Group=unheaded
Environment=HTTP_ADDR=0.0.0.0:19002
EnvironmentFile=-/etc/unheaded/captain.env
ExecStart=/usr/local/bin/captain
WorkingDirectory=/var/lib/unheaded/captain
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/unheaded/captain
SystemCallFilter=@system-service
SystemCallFilter=~@privileged ~@resources ~@reboot ~@module ~@swap
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
