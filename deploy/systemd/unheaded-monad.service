# Install:
#   sudo cp deploy/systemd/unheaded-monad.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl start unheaded-monad    # manual only — NOT enabled on boot

[Unit]
Description=Unheaded monad — unified state management service
Documentation=https://github.com/unheaded/unheaded/tree/main/cmd/monad
After=network-online.target unheaded-wotan.service
Wants=network-online.target
Requires=unheaded-wotan.service

[Service]
Type=simple
User=unheaded
Group=unheaded
EnvironmentFile=-/etc/unheaded/monad.env
ExecStart=/usr/local/bin/monad --listen :19004
WorkingDirectory=/var/lib/unheaded/monad
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/unheaded/monad
SystemCallFilter=@system-service
SystemCallFilter=~@privileged ~@resources ~@reboot ~@module ~@swap
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
