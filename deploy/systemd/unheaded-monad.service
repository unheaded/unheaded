# Install (users first: deploy/sysusers.d/unheaded.conf, see its header):
#   sudo cp deploy/systemd/unheaded-monad.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl start unheaded-monad    # manual only — NOT enabled on boot

[Unit]
Description=Unheaded monad — unified state management service
Documentation=https://github.com/unheaded/unheaded/tree/main/cmd/monad
After=network-online.target unheaded-wotan.service
Wants=network-online.target
Requires=unheaded-wotan.service

[Service]
Type=simple
EnvironmentFile=-/etc/unheaded/monad.env
ExecStart=/usr/local/bin/monad --listen :19004
WorkingDirectory=/var/lib/unheaded/monad
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s

LimitNOFILE=4096

# Service identity (ADR-103, deploy/systemd/README.md#keys-adr-103): the key
# comes from `unheaded-keygen -owner unheaded-monad monad` (root, once per host).
Environment=AUTH_KEY_FILE=/etc/unheaded/keys/monad.key
Environment=AUTH_TRUST_DIR=/etc/unheaded/trust.d
ReadOnlyPaths=-/etc/unheaded/trust.d

User=unheaded-monad
Group=unheaded-monad
StateDirectory=unheaded/monad
StateDirectoryMode=0700
UMask=0077

# Sandbox (deploy/systemd/README.md#isolation). The user comes from
# deploy/sysusers.d/unheaded.conf: system account, /usr/sbin/nologin.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @reboot @module @swap
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
