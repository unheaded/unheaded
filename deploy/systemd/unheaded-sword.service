# SPDX-License-Identifier: GPL-3.0-or-later
# Sword, the deploy service (S-REAL-STEEL Phase 8): deployments into LXD
# through Cuirass, canary analysis, rollbacks. The host path for D-09's
# fallback (when a compose container cannot reach lxdbr0 instance IPs);
# the compose service "sword" is the default. Not installed anywhere yet.
#
# Install (users first: deploy/sysusers.d/unheaded.conf, see its header):
#   sudo install -m 0755 sword /usr/local/bin/
#   sudo install -d -m 0750 -o root -g unheaded-sword /etc/unheaded/sword
#   sudo install -m 0640 -o root -g unheaded-sword observability/alerting/policy.yaml /etc/unheaded/sword/policy.yaml
#   # /etc/unheaded/sword/sword.env (0640 root:unheaded-sword) holds
#   # CUIRASS_API_KEY and AUTH_API_KEYS; never in the repo. For the history in
#   # The Well (migration 039) it also sets WELL_DB=unheaded_ops,
#   # WELL_HOST=127.0.0.1, WELL_PASSWORD (ops_writer) and KINGDOM_NODE; without
#   # WELL_DB the history stays in /var/lib/unheaded/sword/sword.json.
#   sudo cp deploy/systemd/unheaded-sword.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now unheaded-sword

[Unit]
Description=Unheaded Sword — deploys through Cuirass
After=network-online.target
Wants=network-online.target
After=unheaded-daemon.service unheaded-wotan.service

[Service]
Type=simple
EnvironmentFile=/etc/unheaded/sword/sword.env
Environment=HTTP_ADDR=:19011
Environment=AUTH_ENABLED=true
Environment=SWORD_DATA_DIR=/var/lib/unheaded/sword
Environment=SWORD_SLO_POLICY=/etc/unheaded/sword/policy.yaml
ExecStart=/usr/local/bin/sword
WorkingDirectory=/var/lib/unheaded/sword
Restart=on-failure
RestartSec=10s
TimeoutStopSec=15s

LimitNOFILE=1024
MemoryMax=128M

# Service identity (ADR-103, deploy/systemd/README.md#keys-adr-103): the key
# comes from `unheaded-keygen -owner unheaded-sword sword` (root, once per host).
Environment=AUTH_KEY_FILE=/etc/unheaded/keys/sword.key
Environment=AUTH_TRUST_DIR=/etc/unheaded/trust.d
# S-IRON-GATE Phase 6: deployments need a service token from one of these
# callers, or a key from sword.env's AUTH_API_KEYS.
Environment=AUTH_ALLOW_CALLERS=unheaded-cli,dashboard-backend
ReadOnlyPaths=-/etc/unheaded/trust.d
# TLS (S-IRON-GATE Phase 8, ADR-105, FND-017; deploy/systemd/README.md#tls):
# TLS 1.3 with hybrid ML-KEM on the listener and every first-party link.
# Material in /etc/unheaded/tls/sword/ from the Kingdom CA runbook
# (runbooks/pki/generate-kingdom-certs.yaml); key root:unheaded-sword 0640, certs 0644.
Environment=UNHEADED_TLS_ENABLED=true
Environment=UNHEADED_TLS_CA_CERT=/etc/unheaded/tls/sword/ca.pem
Environment=UNHEADED_TLS_CERT=/etc/unheaded/tls/sword/sword.pem
Environment=UNHEADED_TLS_KEY_FILE=/etc/unheaded/tls/sword/sword-key.pem
Environment=UNHEADED_TLS_MTLS_ENABLED=false
ReadOnlyPaths=-/etc/unheaded/tls/sword

User=unheaded-sword
Group=unheaded-sword
StateDirectory=unheaded/sword
StateDirectoryMode=0700
UMask=0077

# Sandbox (deploy/systemd/README.md#isolation). The user comes from
# deploy/sysusers.d/unheaded.conf: system account, /usr/sbin/nologin.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @reboot @module @swap
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
