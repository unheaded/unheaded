# Install (users first: deploy/sysusers.d/unheaded.conf, see its header):
#   sudo cp deploy/systemd/unheaded-dashboard.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl start unheaded-dashboard    # manual only — NOT enabled on boot

[Unit]
Description=Unheaded dashboard — metrics and WebSocket backend
Documentation=https://github.com/unheaded/unheaded/tree/main/cmd/dashboard-backend
After=network-online.target unheaded-wotan.service
Wants=network-online.target
Requires=unheaded-wotan.service

[Service]
Type=simple
EnvironmentFile=-/etc/unheaded/dashboard.env
ExecStart=/usr/local/bin/dashboard-backend --listen :20000
WorkingDirectory=/var/lib/unheaded/dashboard
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s

LimitNOFILE=8192

User=unheaded-dashboard
Group=unheaded-dashboard
StateDirectory=unheaded/dashboard
StateDirectoryMode=0700
UMask=0077

# Sandbox (deploy/systemd/README.md#isolation). The user comes from
# deploy/sysusers.d/unheaded.conf: system account, /usr/sbin/nologin.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @reboot @module @swap
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
