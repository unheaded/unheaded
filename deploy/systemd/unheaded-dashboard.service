# Install:
#   sudo cp deploy/systemd/unheaded-dashboard.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl start unheaded-dashboard    # manual only — NOT enabled on boot

[Unit]
Description=Unheaded dashboard — metrics and WebSocket backend
Documentation=https://github.com/unheaded/unheaded/tree/main/cmd/dashboard-backend
After=network-online.target unheaded-wotan.service
Wants=network-online.target
Requires=unheaded-wotan.service

[Service]
Type=simple
User=unheaded
Group=unheaded
EnvironmentFile=-/etc/unheaded/dashboard.env
ExecStart=/usr/local/bin/dashboard-backend --listen :20000
WorkingDirectory=/var/lib/unheaded/dashboard
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/unheaded/dashboard
SystemCallFilter=@system-service
SystemCallFilter=~@privileged ~@resources ~@reboot ~@module ~@swap
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
