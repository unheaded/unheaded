# Install (users first: deploy/sysusers.d/unheaded.conf, see its header):
#   sudo cp deploy/systemd/unheaded-dashboard.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl start unheaded-dashboard    # manual only — NOT enabled on boot

[Unit]
Description=Unheaded dashboard — metrics and WebSocket backend
Documentation=https://github.com/unheaded/unheaded/tree/main/cmd/dashboard-backend
After=network-online.target unheaded-wotan.service
Wants=network-online.target
Requires=unheaded-wotan.service

[Service]
Type=simple
EnvironmentFile=-/etc/unheaded/dashboard.env
ExecStart=/usr/local/bin/dashboard-backend --listen :20000
WorkingDirectory=/var/lib/unheaded/dashboard
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s

LimitNOFILE=8192

# Service identity (ADR-103, deploy/systemd/README.md#keys-adr-103): the key
# comes from `unheaded-keygen -owner unheaded-dashboard dashboard-backend` (root, once per host).
Environment=AUTH_KEY_FILE=/etc/unheaded/keys/dashboard-backend.key
Environment=AUTH_TRUST_DIR=/etc/unheaded/trust.d
# S-IRON-GATE Phase 6: the browser's backend-for-frontend (pkg/bff, ADR-103
# section 4): login against the host's issuer (unheaded-auth.service, which must
# list dashboard-backend in -audiences), HttpOnly session cookie; unheaded-cli
# may call with its service token.
Environment=AUTH_ENABLED=true
Environment=AUTH_ISSUER_URL=https://%H:19020
Environment=AUTH_ALLOW_CALLERS=unheaded-cli
ReadOnlyPaths=-/etc/unheaded/trust.d

User=unheaded-dashboard
Group=unheaded-dashboard
StateDirectory=unheaded/dashboard
StateDirectoryMode=0700
UMask=0077

# Sandbox (deploy/systemd/README.md#isolation). The user comes from
# deploy/sysusers.d/unheaded.conf: system account, /usr/sbin/nologin.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @reboot @module @swap
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
