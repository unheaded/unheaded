# /etc/unheaded/wotan/wotan.env: environment for Wotan (systemd unit
# unheaded-wotan.service and the compose service `wotan` both read it).
# Install 0600, owned by root, and fill the key on the host only:
#   sudo install -d -m 0750 /etc/unheaded/wotan
#   sudo install -m 0600 -o root -g root deploy/systemd/wotan.env.example /etc/unheaded/wotan/wotan.env
#   then set the key line below to the output of: openssl rand -hex 32
#
# WOTAN_ADMIN_API_KEY guards /api/v1/admin/* (pending/approve/approve-all/deny).
# Send it as `X-Admin-API-Key: <key>` or `Authorization: Bearer <key>`.
# The endpoints exist only when Wotan runs with --admin (default off); --admin
# with this empty makes Wotan exit at startup. Never put the key in a flag,
# the unit file or the compose YAML.
WOTAN_ADMIN_API_KEY=
