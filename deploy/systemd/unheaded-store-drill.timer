# SPDX-License-Identifier: GPL-3.0-or-later
# ClickHouse and VictoriaMetrics: weekly restore drill (ADR-147 decision 6). Persistent=, so a run missed while west
# was off starts soon after boot; the alerts in rules/backups.yml wait 45m.

[Unit]
Description=ClickHouse and VictoriaMetrics: weekly restore drill

[Timer]
OnCalendar=Sun *-*-* 05:40:00
Persistent=true

[Install]
WantedBy=timers.target
