# /etc/zhen-agentd.env — environment for zhen-agentd
# Copy to /etc/zhen-agentd.env and edit. systemd loads this via the
# unit's EnvironmentFile= directive. Mode 0600 owned by root recommended:
#   sudo install -m 0600 -o root -g root deploy/systemd/zhen-agentd.env.example /etc/zhen-agentd.env

# --- Backends ---
VOR_URL=http://127.0.0.1:9876
LLAMA_URL=http://127.0.0.1:8081
RAG_MODEL=qwen2.5-coder-7b-instruct

# --- The Well (PostgreSQL audit log) ---
# DSN format: host=H port=P user=U password=P dbname=D sslmode=require
# Use sslmode=verify-full in production.
# e.g. host=well-pg.internal port=5432 user=zhen password=<from the Well's .env> dbname=unheaded_app sslmode=require
WELL_DSN=

# --- Auth ---
# Required: zhen-agentd exits 2 ("no auth token set") unless AUTH_ENABLED=true
# and at least one of AUTH_API_KEYS, AUTH_API_KEY_FILE, or a trust directory
# (AUTH_TRUST_DIR, default /etc/unheaded/trust.d) is set.
# (-no-auth exists for a loopback dev listener only; never in this unit.)
# /health, /ready, /metrics and /api/v1/openapi.json always bypass.
AUTH_ENABLED=true

# Static API keys, comma-separated; callers send X-API-Key. Generate with
# openssl rand -hex 32. Or use a key file (one key per line, first is current):
#   AUTH_API_KEY_FILE=/etc/zhen/api-keys
AUTH_API_KEYS=

# Service tokens (ADR-103): Ed25519, verified against the public keys in
# AUTH_TRUST_DIR; only the callers listed here are let in (others get 403).
# AUTH_ALLOW_CALLERS=dashboard-backend
# User tokens from an OIDC issuer's JWKS (EdDSA keys):
# AUTH_OIDC_ISSUER_URL=https://auth.example
# AUTH_JWT_KEY (the shared HMAC key) is retired: with AUTH_ENABLED=true
# zhen-agentd refuses to start if it is set.
