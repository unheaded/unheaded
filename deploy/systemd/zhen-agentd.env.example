# /etc/zhen-agentd.env — environment for zhen-agentd
# Copy to /etc/zhen-agentd.env and edit. systemd loads this via the
# unit's EnvironmentFile= directive. Mode 0600 owned by root recommended:
#   sudo install -m 0600 -o root -g root deploy/systemd/zhen-agentd.env.example /etc/zhen-agentd.env

# --- Backends ---
VOR_URL=http://127.0.0.1:9876
LLAMA_URL=http://127.0.0.1:8081
RAG_MODEL=qwen2.5-coder-7b-instruct

# --- The Well (PostgreSQL audit log) ---
# DSN format: host=H port=P user=U password=P dbname=D sslmode=require
# Use sslmode=verify-full in production.
# e.g. host=well-pg.internal port=5432 user=zhen password=<from the Well's .env> dbname=unheaded_app sslmode=require
WELL_DSN=

# --- Scheduler (-scheduler, S-CHAMPION-HARDENING Phase 8) ---
# Run records: zhen_agent_runs (mode scheduled, migration 037) as app_zhen.
# Unset or unreachable: runs are kept in memory only (logged).
# e.g. host=127.0.0.1 port=5432 user=app_zhen password=<APP_ZHEN_PASSWORD> dbname=unheaded_app sslmode=verify-full
WELL_APP_ZHEN_DSN=
# One Kanban card per run needs a role that may INSERT kanban_tasks: the
# board's own writer, app_kanban (app_zhen may not). Unset: -kanban-store=pg
# uses WELL_DSN, cards fail (zhen_scheduler_record_failures_total{what="card"})
# and run rows stay in memory (their foreign key needs the card).
WELL_KANBAN_DSN=
# The schedule file. The unit passes -schedules explicitly, which wins over
# this; set it only when running the binary by hand.
# ZHEN_SCHEDULES=/etc/unheaded/zhen/schedules.yaml
# /metrics alone on the WireGuard address, for Prometheus job zhen-agentd
# (the API stays on 127.0.0.1). West: [fd00:dead:beef::1]:20105.
ZHEN_METRICS_ADDR=

# --- Auth ---
# Required: zhen-agentd exits 2 ("no auth token set") unless AUTH_ENABLED=true
# and at least one of AUTH_API_KEYS, AUTH_API_KEY_FILE, or a trust directory
# (AUTH_TRUST_DIR, default /etc/unheaded/trust.d) is set.
# (-no-auth exists for a loopback dev listener only; never in this unit.)
# /health, /ready, /metrics and /api/v1/openapi.json always bypass.
AUTH_ENABLED=true

# Static API keys, comma-separated; callers send X-API-Key. Generate with
# openssl rand -hex 32. Or use a key file (one key per line, first is current):
#   AUTH_API_KEY_FILE=/etc/zhen/api-keys
AUTH_API_KEYS=

# Service tokens (ADR-103): Ed25519, verified against the public keys in
# AUTH_TRUST_DIR; only the callers listed here are let in (others get 403).
# The unit sets AUTH_ALLOW_CALLERS=unheaded-cli,dashboard-backend; set it here
# only to change that list.
# AUTH_ALLOW_CALLERS=unheaded-cli,dashboard-backend
# User tokens from an OIDC issuer's JWKS (EdDSA keys):
# AUTH_OIDC_ISSUER_URL=https://auth.example
# AUTH_JWT_KEY (the shared HMAC key) is retired: with AUTH_ENABLED=true
# zhen-agentd refuses to start if it is set.

# --- Overnight worker (zhen-agentd-overnight.service + .timer; NOT enabled) ---
# The first unattended night is Stevie's call (E2, S-CHAMPION-HARDENING
# Phase 13). The night's limits are flags in that unit (-window 01:00-07:00,
# -max-cards 5, -claude fake); these environment values feed it:
# ANTHROPIC_API_KEY=                 # only for -claude live; never in the repo
# ZHEN_MEM_FLOOR_BYTES=              # raise the memory floor (swap is never counted)
# GPU_LOCK=/run/unheaded/gpu.lock    # must be the lease switch-model.sh uses too
# WELL_APP_ZHEN_DSN=                 # runs recorded in the Well (else memory-only)
# WELL_KANBAN_DSN=                   # cards read/updated as app_kanban
# Kill switch: runbooks/observe/zhen-overnight-abort.yaml. Morning report:
# scripts/zhen-morning-report.sh (reads /var/lib/zhen-agentd/zhen-reports).
