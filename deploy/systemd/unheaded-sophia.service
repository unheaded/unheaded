# Install (users first: deploy/sysusers.d/unheaded.conf, see its header):
#   sudo cp deploy/systemd/unheaded-sophia.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl start unheaded-sophia    # manual only — NOT enabled on boot

[Unit]
Description=Unheaded sophia — knowledge graph and microcode ROM service
Documentation=https://github.com/unheaded/unheaded/tree/main/cmd/sophia
After=network-online.target unheaded-wotan.service
Wants=network-online.target
Requires=unheaded-wotan.service

[Service]
Type=simple
EnvironmentFile=-/etc/unheaded/sophia.env
ExecStart=/usr/local/bin/sophia --listen :19005
WorkingDirectory=/var/lib/unheaded/sophia
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s

LimitNOFILE=4096

# Service identity (ADR-103, deploy/systemd/README.md#keys-adr-103): the key
# comes from `unheaded-keygen -owner unheaded-sophia sophia` (root, once per host).
Environment=AUTH_KEY_FILE=/etc/unheaded/keys/sophia.key
Environment=AUTH_TRUST_DIR=/etc/unheaded/trust.d
# S-IRON-GATE Phase 6: every route but /health /ready /metrics needs a
# service token from one of these callers (none calls the API today).
Environment=AUTH_ENABLED=true
Environment=AUTH_ALLOW_CALLERS=unheaded-cli,dashboard-backend
ReadOnlyPaths=-/etc/unheaded/trust.d

User=unheaded-sophia
Group=unheaded-sophia
StateDirectory=unheaded/sophia
StateDirectoryMode=0700
UMask=0077

# Sandbox (deploy/systemd/README.md#isolation). The user comes from
# deploy/sysusers.d/unheaded.conf: system account, /usr/sbin/nologin.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @reboot @module @swap
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
