# Install:
#   sudo cp deploy/systemd/unheaded-sophia.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl start unheaded-sophia    # manual only — NOT enabled on boot

[Unit]
Description=Unheaded sophia — knowledge graph and microcode ROM service
Documentation=https://github.com/unheaded/unheaded/tree/main/cmd/sophia
After=network-online.target unheaded-wotan.service
Wants=network-online.target
Requires=unheaded-wotan.service

[Service]
Type=simple
User=unheaded
Group=unheaded
EnvironmentFile=-/etc/unheaded/sophia.env
ExecStart=/usr/local/bin/sophia --grpc-port 19005
WorkingDirectory=/var/lib/unheaded/sophia
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/unheaded/sophia
SystemCallFilter=@system-service
SystemCallFilter=~@privileged ~@resources ~@reboot ~@module ~@swap
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
