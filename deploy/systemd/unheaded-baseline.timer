# Runs the baseline agent every 5 minutes (ADR-098: drift detected in <= 5 min).

[Unit]
Description=Unheaded host baseline agent every 5 minutes

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
RandomizedDelaySec=30s
AccuracySec=30s

[Install]
WantedBy=timers.target
