# /etc/unheaded/zhen-app.env: environment for unheaded-zhen-app.service.
#
# Do not copy this file and fill it in by hand: scripts/write-zhen-app-env.sh
# writes the real one (0640 root:unheaded-zhen-app) and takes the password
# from /etc/unheaded/compose.env without showing it. This file lists the keys.
# No value here is a secret, and none goes in the repo.

# The Well's password for the role app_zhen (compose.env: APP_ZHEN_PASSWORD).
# Empty: the app logs "The Well not available" and runs without memory, the
# conversation log and the live Kanban context.
ZHEN_DB_PASSWORD=
# Where the Well listens for this host. The unit allows loopback only; a Well
# on another address needs that address in a drop-in's IPAddressAllow.
ZHEN_DB_HOST=
ZHEN_DB_PORT=5432
# The Well accepts TLS only. verify-full checks the server's name against the
# CA below.
ZHEN_DB_SSLMODE=verify-full
ZHEN_DB_SSLROOTCERT=/etc/unheaded/well-tls/ca.crt
# Names or addresses browsers use past loopback, comma separated. The app
# answers 403 to any other Host. Empty: loopback only.
ZHEN_ALLOWED_HOSTS=
# The memory embedder's pin (scripts/lib/model-pins.sh). With it set the app
# refuses to start when the cached weights are not the pinned file.
ZHEN_EMBEDDER_SHA256=
ZHEN_EMBEDDER_REVISION=
