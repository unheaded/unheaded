# Install (users first: deploy/sysusers.d/unheaded.conf, see its header):
#   sudo cp deploy/systemd/unheaded-daemon.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl start unheaded-daemon    # manual only — NOT enabled on boot

[Unit]
Description=Unheaded daemon — control plane (drift detection + reconciliation)
Documentation=https://github.com/unheaded/unheaded/tree/main/cmd/unheaded-daemon
After=network-online.target unheaded-wotan.service
Wants=network-online.target
Requires=unheaded-wotan.service

[Service]
Type=simple
Environment=HTTP_ADDR=:17000
Environment=GRPC_ADDR=:17001
# desired.json lives in the unit's StateDirectory (ProtectSystem=strict)
Environment=CUIRASS_STATE_DIR=/var/lib/unheaded/daemon
EnvironmentFile=-/etc/unheaded/daemon.env
ExecStart=/usr/local/bin/unheaded-daemon
WorkingDirectory=/var/lib/unheaded/daemon
Restart=on-failure
RestartSec=10s
TimeoutStopSec=30s

LimitNOFILE=4096

# Service identity (ADR-103, deploy/systemd/README.md#keys-adr-103): the key
# comes from `unheaded-keygen -owner unheaded-daemon unheaded-daemon` (root, once per host).
Environment=AUTH_KEY_FILE=/etc/unheaded/keys/unheaded-daemon.key
Environment=AUTH_TRUST_DIR=/etc/unheaded/trust.d
# S-IRON-GATE Phase 5: container writes and reconcile need a service token
# from one of these callers; reads under /api/v1/info and /api/v1/state stay open.
Environment=AUTH_ENABLED=true
Environment=AUTH_ALLOW_CALLERS=sword,unheaded-cli,dashboard-backend
ReadOnlyPaths=-/etc/unheaded/trust.d
# TLS (S-IRON-GATE Phase 8, ADR-105, FND-017; deploy/systemd/README.md#tls):
# TLS 1.3 with hybrid ML-KEM on the listener and every first-party link.
# Material in /etc/unheaded/tls/unheaded-daemon/ from the Kingdom CA runbook
# (runbooks/pki/generate-kingdom-certs.yaml); key root:unheaded-daemon 0640, certs 0644.
Environment=UNHEADED_TLS_ENABLED=true
Environment=UNHEADED_TLS_CA_CERT=/etc/unheaded/tls/unheaded-daemon/ca.pem
Environment=UNHEADED_TLS_CERT=/etc/unheaded/tls/unheaded-daemon/unheaded-daemon.pem
Environment=UNHEADED_TLS_KEY_FILE=/etc/unheaded/tls/unheaded-daemon/unheaded-daemon-key.pem
Environment=UNHEADED_TLS_MTLS_ENABLED=false
ReadOnlyPaths=-/etc/unheaded/tls/unheaded-daemon

User=unheaded-daemon
Group=unheaded-daemon
StateDirectory=unheaded/daemon unheaded/state
StateDirectoryMode=0700
UMask=0077

# Sandbox (deploy/systemd/README.md#isolation). The user comes from
# deploy/sysusers.d/unheaded.conf: system account, /usr/sbin/nologin.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @reboot @module @swap
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
