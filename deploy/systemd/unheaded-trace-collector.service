# SPDX-License-Identifier: GPL-3.0-or-later
# trace-collector-go: loads the packet-marker (XDP), flow-tracker (TC) and
# latency-probe (kprobe) eBPF programs and publishes their events to Wotan
# (traces.* and the ebpf.*.events mirrors).
#
# Install (users first: deploy/sysusers.d/unheaded.conf):
#   go build -o /tmp/trace-collector-go ./cmd/trace-collector-go
#   sudo install -m 0755 /tmp/trace-collector-go /usr/local/bin/
#   sudo install -d -m 0755 /usr/local/lib/unheaded/ebpf
#   sudo install -m 0644 <packet-marker flow-tracker latency-probe> /usr/local/lib/unheaded/ebpf/
#   sudo cp deploy/systemd/unheaded-trace-collector.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now unheaded-trace-collector
# East (services on the host network): TRACE_IFACE=lo in the env file.
# The interface defaults to br-unhe-data (the compose data network); set
# TRACE_IFACE in /etc/unheaded/trace-collector.env to change it.
#
# Runs as unheaded-trace-collector with CAP_BPF, CAP_PERFMON (kprobes) and
# CAP_NET_ADMIN (XDP and TC attach) only; bpf and perf_event_open are allowed
# back after the @privileged deny. The objects stay root-owned (the loader
# refuses any that are not). No map pinning (--map-pin-path=): /sys/fs/bpf is
# root 0700, and nothing reads pins from this process. Logs go to the journal,
# which rotates them; under a hand launch they went to a file nothing rotated
# (4.3 GB in ten hours while Wotan was down, 2026-10-18).
#
# Listens on loopback by default, with auth on. /health, /ready and /metrics
# stay open; /api/v1/* needs a credential (and refuses everyone on a host with
# no trust.d yet). Prometheus scrapes the overlay, so each host names it in
# /etc/unheaded/trace-collector.env:
#   TRACE_METRICS_ADDR=127.0.0.1:16671,[fd00:dead:beef::1]:16671   (west; ::2 on east)
# An address not on the host yet is served once it appears. A taken port or a
# bad address stops the collector; Restart= retries it. So does a missing
# packet-marker PACKET_EVENTS ring buffer: there is no poll fallback.
# Retries are capped (2026-11-09, Stevie): every 5 s, up to 60 tries in ten
# minutes, long enough for the compose bridge to appear after boot. After
# that the unit is `failed` and shows in `systemctl --failed`; a loop that
# never ends shows as `activating`. `systemctl reset-failed` then `start` once
# the cause is fixed; --enable-packet-marker=false runs without packet traces.
# flow-tracker's FLOW_STATS go to traces.stats every --stats-interval (10s).

[Unit]
Description=Unheaded trace collector (eBPF to Wotan)
Documentation=https://github.com/unheaded/unheaded/blob/develop/deploy/systemd/README.md
After=network-online.target systemd-sysusers.service docker.service wg-quick@wg0.service
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=60

[Service]
# Memory ceiling (S-LOW-FRUIT Phase 3): GOMEMLIMIT = MemoryHigh, so the Go GC
# works harder before the cgroup throttles or OOM-kills.
MemoryMax=512M
MemoryHigh=460M
TasksMax=512
Environment=GOMEMLIMIT=460MiB
Type=simple
Environment=TRACE_IFACE=br-unhe-data
Environment=TRACE_METRICS_ADDR=127.0.0.1:16671
Environment=AUTH_ENABLED=true
Environment=AUTH_ALLOW_CALLERS=unheaded-cli
# TLS (S-IRON-GATE Phase 8; deploy/systemd/README.md#tls): Wotan and Cuirass
# serve TLS only, so this unit dials them with the Kingdom CA. Its own
# listener stays plain HTTP: no certificate of its own here (pkg/tls.ServesTLS).
Environment=UNHEADED_TLS_ENABLED=true
Environment=UNHEADED_TLS_CA_CERT=/etc/unheaded/tls/ca.pem
ReadOnlyPaths=-/etc/unheaded/tls/ca.pem
EnvironmentFile=-/etc/unheaded/trace-collector.env
ExecStart=/usr/local/bin/trace-collector-go --unified --interface ${TRACE_IFACE} --metrics-addr ${TRACE_METRICS_ADDR} --ebpf-obj-dir /usr/local/lib/unheaded/ebpf --map-pin-path= --log-json
Restart=on-failure
RestartSec=5s

User=unheaded-trace-collector
Group=unheaded-trace-collector
UMask=0077
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_NET_ADMIN
AmbientCapabilities=CAP_BPF CAP_PERFMON CAP_NET_ADMIN

NoNewPrivileges=yes
# Writable under ProtectSystem=strict: set AUTH_AUDIT_LOG=/var/log/unheaded/trace-collector/auth-audit.log
# in the env file to keep every auth decision there (off by default).
LogsDirectory=unheaded/trace-collector
LogsDirectoryMode=0750
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @reboot @module @swap
SystemCallFilter=bpf perf_event_open
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
