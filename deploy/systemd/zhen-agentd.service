# SPDX-License-Identifier: GPL-3.0-or-later
# systemd unit for zhen-agentd — the Phase D-A agent runtime daemon.
#
# Drop-in steps:
#   sudo cp deploy/systemd/zhen-agentd.service /etc/systemd/system/
#   sudo cp deploy/systemd/zhen-agentd.env.example /etc/zhen-agentd.env
#   sudo $EDITOR /etc/zhen-agentd.env       # set AUTH_*, WELL_DSN, etc.
#   sudo install -m 0644 deploy/sysusers.d/unheaded.conf /etc/sysusers.d/ && sudo systemd-sysusers
#   sudo install -d -o zhen-agentd -g zhen-agentd -m 0700 /var/zhen/projects/default
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now zhen-agentd
#   sudo journalctl -u zhen-agentd -f       # follow logs
#
# Hardening: NoNewPrivileges, ProtectSystem=strict, ProtectHome, etc.
# Adjust ReadWritePaths to match your -allowed-roots if you change the
# default /var/zhen/projects/.

[Unit]
Description=Zhen Agent Daemon (Phase D-A — ReAct loop + Champion gate)
Documentation=https://github.com/unheaded/unheaded/tree/main/cmd/zhen-agentd
Wants=network-online.target
After=network-online.target postgresql.service
# Optionally: After=cs-vor.service llama-server.service

[Service]
Type=simple
# Service identity (ADR-103, deploy/systemd/README.md#keys-adr-103): the key
# comes from `unheaded-keygen -owner zhen-agentd zhen-agentd` (root, once per host).
Environment=AUTH_KEY_FILE=/etc/unheaded/keys/zhen-agentd.key
Environment=AUTH_TRUST_DIR=/etc/unheaded/trust.d
# S-IRON-GATE Phase 6: the listener needs auth (it exits 2 without), and
# service tokens are taken from these callers; RBAC keeps observer keys off
# the gate's writes. /etc/zhen-agentd.env (read after) may override both.
Environment=AUTH_ENABLED=true
Environment=AUTH_ALLOW_CALLERS=unheaded-cli,dashboard-backend
ReadOnlyPaths=-/etc/unheaded/trust.d

User=zhen-agentd
Group=zhen-agentd
UMask=0077

# Environment loaded from a separate file so secrets stay out of git.
EnvironmentFile=-/etc/zhen-agentd.env

# Default flags. Override per-host via /etc/zhen-agentd.env or by
# editing this unit's ExecStart.
ExecStart=/usr/local/bin/zhen-agentd \
    -port 20105 \
    -host 127.0.0.1 \
    -project-root /var/zhen/projects/default \
    -action-store=pg \
    -rate-limit 10 \
    -rate-burst 25

# Graceful shutdown — daemon waits up to 10s for in-flight requests
# before exiting; give systemd a slightly larger window.
TimeoutStopSec=20s

Restart=on-failure
RestartSec=5s

# --- Hardening (defense-in-depth on top of the in-process gate) ---
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
PrivateTmp=yes
PrivateDevices=yes
RemoveIPC=yes
# 127.0.0.1 listener + The Well over TCP.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# Capabilities: zhen-agentd binds an unprivileged port (20105) and does
# not need any capabilities. CAP_NET_BIND_SERVICE only required if you
# move the listen port below 1024.
CapabilityBoundingSet=
AmbientCapabilities=

# Filesystem access — must include the project roots from -allowed-roots.
# Default assumes /var/zhen/projects/ is the parent of all tenant roots.
ReadWritePaths=/var/zhen/projects
ReadOnlyPaths=/var/zhen/models /etc/zhen-agentd.env

# Seccomp — block privileged syscalls.
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @reboot @module @swap
SystemCallErrorNumber=EPERM

# Resource limits.
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
