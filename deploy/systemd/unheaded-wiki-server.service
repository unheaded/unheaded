[Unit]
Description=Unheaded wiki server: the wiki over TLS, behind the dashboard's login
Documentation=https://github.com/unheaded/unheaded/blob/develop/wiki/Microservices.md
After=network-online.target
Wants=network-online.target
# ADR-147 (SS3): it keeps restarting through the 15-minute boot window
# (90 starts x RestartSec 10s), then stays failed and UnitFailed mails,
# instead of restarting for ever (review 2026-11-15: 10 starts gave up
# after 100 s).
StartLimitIntervalSec=30min
StartLimitBurst=90

[Service]
Type=simple
# Loopback only here. A host that publishes the wiki adds listeners in a
# drop-in (one --listen per address, and the matching IPAddressAllow and
# SocketBindAllow). The wiki directory is the repository's wiki/ as the deb
# or the operator installs it; a checkout can be named in a drop-in with
# ProtectHome=read-only.
ExecStart=/usr/local/bin/wiki-server --listen 127.0.0.1:20002 --wiki-dir /usr/share/unheaded/wiki --vor-url http://127.0.0.1:20110
# The binary's relative defaults (./wiki) resolve here, never from /.
StateDirectory=unheaded/wiki-server
StateDirectoryMode=0750
WorkingDirectory=/var/lib/unheaded/wiki-server
Restart=always
RestartSec=10s
TimeoutStopSec=15s
LimitNOFILE=1024
MemoryMax=256M
MemoryHigh=230M
Environment=GOMEMLIMIT=200MiB
# TLS: this unit's certificate and key, the CA to reach the issuer (pkg/tls).
Environment=UNHEADED_TLS_ENABLED=true
Environment=UNHEADED_TLS_CERT=/etc/unheaded/tls/wiki-server/wiki-server.pem
Environment=UNHEADED_TLS_KEY_FILE=/etc/unheaded/tls/wiki-server/wiki-server-key.pem
Environment=UNHEADED_TLS_CA_CERT=/etc/unheaded/tls/ca.pem
Environment=UNHEADED_TLS_MTLS_ENABLED=false
# Login (ADR-103 section 4, pkg/bff): service tokens from trust.d, no key of
# its own (it mints none). AUTH_ISSUER_URL names the issuer the host can
# reach and lives in the environment file: without it reads stay open.
Environment=AUTH_ENABLED=true
Environment=AUTH_TRUST_DIR=/etc/unheaded/trust.d
EnvironmentFile=-/etc/unheaded/wiki-server.env
ReadOnlyPaths=-/etc/unheaded/tls/wiki-server
ReadOnlyPaths=-/etc/unheaded/trust.d
User=unheaded-wiki-server
Group=unheaded-wiki-server
UMask=0077
CapabilityBoundingSet=
PrivateUsers=yes
NoNewPrivileges=yes
# Writable under ProtectSystem=strict: set AUTH_AUDIT_LOG=/var/log/unheaded/wiki-server/auth-audit.log
# in the env file to keep every auth decision there (off by default). Without
# the directory the log cannot be opened and the service refuses to start.
LogsDirectory=unheaded/wiki-server
LogsDirectoryMode=0750
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @reboot @module @swap
SystemCallErrorNumber=EPERM
SocketBindDeny=any
SocketBindAllow=tcp:20002
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
