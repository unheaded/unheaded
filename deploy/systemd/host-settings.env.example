# /etc/unheaded/host-settings.env, read by unheaded-host-settings.service
# (the daily check of this host's settings against the repository) and by
# unheaded-boot-event.service (the record of each boot; its keys are at the
# end and all have defaults).
#   sudo install -m 0644 deploy/systemd/host-settings.env.example /etc/unheaded/host-settings.env
# then set HOST_SETTINGS_REPO. Holds no secret.

# The checkout whose deploy/host-settings/<host>.tsv is this host's manifest.
# Required: the unit has no default for it.
HOST_SETTINGS_REPO=/srv/unheaded

# Which manifest. Default: this host's short name (systemd's %l).
#HOST_SETTINGS_HOST=west

# Where node_exporter's textfile collector reads. Default below. If you change
# it, add ReadWritePaths= for the new directory in a drop-in
# (systemctl edit unheaded-host-settings.service).
#HOST_SETTINGS_TEXTFILE=/var/lib/unheaded/textfile

# unheaded-boot-event.service (scripts/monitoring/boot-event.sh): every key
# is optional.
# The host name in the boot record and in the digest's line ("west booted
# ..."). Default: this host's short name (systemd's %l).
#BOOT_EVENT_HOST=west
# Where huginn's textfile collector reads (host_boot.prom is written there,
# planned_stop.prom is read there). If you change it, add ReadWritePaths= for
# the new directory in a drop-in (systemctl edit unheaded-boot-event.service).
#BOOT_EVENT_TEXTFILE=/var/lib/unheaded/textfile
# The compose projects that are "the stack" in the record and in the
# digest's "stack down" / "stack up since". The monitoring project is left
# out so that the mailer started alone does not read as "stack up".
#BOOT_EVENT_STACK_PROJECTS=unheaded-dev
# Compose services that exit 0 by design and so never count as stopped.
#BOOT_EVENT_ONESHOT=volume-init clickhouse-schema
# How many boots the history keeps (1 to 500). The mailer reads the newest 64.
#BOOT_EVENT_KEEP=32
# Seconds Docker gets to answer, per project (1 to 50; the unit's start
# timeout is 60 s). Past it the boot is recorded with the stack "unknown".
#BOOT_EVENT_DOCKER_WAIT=20
