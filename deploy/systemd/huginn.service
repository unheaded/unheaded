# huginn — host metrics agent (Odin's raven; observes all Kingdom hosts)
# See: docs/adr/ADR-084-huginn-host-metrics-agent.md
#
# ALWAYS-ON: huginn runs at boot with restart-on-failure. Enable once
# (user unheaded-huginn first: deploy/sysusers.d/unheaded.conf):
#   sudo cp deploy/systemd/huginn.service /etc/systemd/system/
#   sudo cp deploy/systemd/huginn.env.example /etc/huginn.env
#   sudo $EDITOR /etc/huginn.env   # set HUGINN_VM for this host's Victoria target
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now huginn
#
# On EAST: set HUGINN_VM=http://192.168.13.2:8428 (push to WEST's VictoriaMetrics; 192.168.13.1 is east itself)
# On WEST: set HUGINN_VM=http://localhost:8428

[Unit]
Description=Huginn — Kingdom host metrics agent
Documentation=https://github.com/unheaded/unheaded/tree/main/cmd/huginn
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/huginn.env
ExecStart=/usr/local/bin/huginn \
    -listen :9110 \
    -vm ${HUGINN_VM} \
    -interval 10s
Restart=always
RestartSec=5s
TimeoutStopSec=10s

LimitNOFILE=1024

User=unheaded-huginn
Group=unheaded-huginn
UMask=0077
# Host observer: reads /proc, /sys and the textfile dir, writes nothing, so
# no StateDirectory and no ProtectProc (it reports host-wide numbers).

# Sandbox (deploy/systemd/README.md#isolation). The user comes from
# deploy/sysusers.d/unheaded.conf: system account, /usr/sbin/nologin.
NoNewPrivileges=yes
ProtectSystem=strict
# read-only, not yes: "yes" puts an empty tmpfs over /home, so a separate
# /home filesystem (the CIS layout the findings plan asks for) would drop
# out of host_disk_* without a sign. read-only keeps the real mount in
# /proc/mounts for statfs and still denies writes.
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @reboot @module @swap
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
