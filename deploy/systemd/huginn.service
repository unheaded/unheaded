# huginn — host metrics agent (Odin's raven; observes all Kingdom hosts)
# See: docs/adr/ADR-084-huginn-host-metrics-agent.md
#
# ALWAYS-ON: huginn runs at boot with restart-on-failure. Enable once:
#   sudo cp deploy/systemd/huginn.service /etc/systemd/system/
#   sudo cp deploy/systemd/huginn.env.example /etc/huginn.env
#   sudo $EDITOR /etc/huginn.env   # set HUGINN_VM for this host's Victoria target
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now huginn
#
# On EAST: set HUGINN_VM=http://192.168.13.1:8428 (push to WEST's VictoriaMetrics)
# On WEST: set HUGINN_VM=http://localhost:8428

[Unit]
Description=Huginn — Kingdom host metrics agent
Documentation=https://github.com/unheaded/unheaded/tree/main/cmd/huginn
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=unheaded
Group=unheaded
EnvironmentFile=-/etc/huginn.env
ExecStart=/usr/local/bin/huginn \
    -listen :9110 \
    -vm ${HUGINN_VM} \
    -interval 10s
Restart=always
RestartSec=5s
TimeoutStopSec=10s

NoNewPrivileges=yes
# ProtectSystem=strict would block /proc reads — huginn is a host observer.
# Use 'full' to protect /boot, /usr etc. while leaving /proc accessible.
ProtectSystem=full
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=
AmbientCapabilities=
# /proc reads are via standard open(2) — @system-service covers them.
SystemCallFilter=@system-service
SystemCallFilter=~@privileged ~@resources ~@reboot ~@module ~@swap
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
