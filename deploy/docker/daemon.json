{
    "log-driver": "json-file",
    "log-opts": {
        "max-size": "100m",
        "max-file": "5"
    },
    "storage-driver": "overlay2",
    "default-address-pools": [
        {
            "base": "172.20.0.0/16",
            "size": 24
        }
    ],
    "ipv6": true,
    "fixed-cidr-v6": "fd00:d0c0:e700::/48",
    "ip6tables": true,
    "experimental": true,
    "metrics-addr": "0.0.0.0:9323",
    "default-runtime": "runc",
    "runtimes": {},
    "dns": [
        "1.1.1.1",
        "8.8.8.8"
    ],
    "features": {
        "buildkit": true
    },
    "live-restore": true
}
