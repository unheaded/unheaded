#!/usr/sbin/nft -f
# SPDX-License-Identifier: GPL-3.0-or-later
# west: inbound default deny (ADR-098 step 6, UH-FW-01, CIS Ubuntu 24.04 4.3.8).
# One table this package owns; Docker's and LXD's tables are never touched.
# Apply only through scripts/host/nft-apply-confirm.sh (rolls back unless
# confirmed). A drop in any input base chain is final, so every path the host
# relies on must be accepted here, including LXD's DHCP/DNS.
#
# Interfaces (2026-09-30): wlp17s0 home LAN 192.168.69.128/25 + ISP IPv6;
# enp16s0 P2P to east 192.168.13.0/30; wg0 overlay (only peer: east);
# lxdbr0 LXD containers; docker0 and br-* Docker bridges.

table inet unheaded
delete table inet unheaded

table inet unheaded {
	chain input {
		type filter hook input priority filter; policy drop;

		iif "lo" accept
		ct state established,related accept
		ct state invalid drop

		# ICMP needed for IPv6 to work at all (neighbour discovery, router
		# advertisements for west's SLAAC address, path MTU); no redirects.
		icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert } accept
		ip6 saddr fe80::/10 icmpv6 type { mld-listener-query, mld-listener-report, mld2-listener-report } accept
		icmpv6 type echo-request limit rate 10/second accept
		icmp type { destination-unreachable, time-exceeded, parameter-problem } accept
		icmp type echo-request limit rate 10/second accept
		ip6 saddr fe80::/10 udp sport 547 udp dport 546 accept comment "DHCPv6 client"

		# east: the P2P link and the overlay are both ours (BGP, BFD, WireGuard,
		# apt repo on 18888, node_exporter scrapes).
		iifname "enp16s0" ip saddr 192.168.13.1 accept
		iifname "enp16s0" ip6 saddr fe80::/10 accept
		iifname "wg0" accept

		# LXD containers: DHCP and DNS from lxdbr0's dnsmasq.
		iifname "lxdbr0" udp dport { 53, 67 } accept
		iifname "lxdbr0" tcp dport 53 accept
		# Syslog relay (ADR-124): the Pi-hole container forwards its logs here.
		iifname "lxdbr0" tcp dport 514 accept
		iifname "lxdbr0" udp dport 514 accept

		# Docker bridges: the monitoring stack scrapes host ports, and
		# Prometheus remote-writes to VictoriaMetrics (8428) over the host.
		iifname "docker0" tcp dport { 8428, 9100, 9110, 9323, 16666-26666 } accept
		iifname "br-*" tcp dport { 8428, 9100, 9110, 9323, 16666-26666 } accept

		# Home LAN (Stevie 2026-11-03): ssh, the haproxy edge, the apt repo
		# (plain HTTP on 18888), and the web UIs on their direct ports. DNS
		# rides the wlp17s0 DNAT to Pi-hole, so it never reaches this chain.
		# Docker-published ports are not filtered here either: they DNAT in
		# Docker's chains. LXD's 8443 is the laptop only. Nothing else
		# (node_exporter, huginn, dockerd metrics, BGP) is offered to the LAN,
		# and nothing at all to the ISP IPv6 prefix except ssh over link-local.
		iifname "wlp17s0" ip saddr 192.168.69.128/25 tcp dport { 7375, 80, 443, 18888, 16666, 20000, 20001, 20002, 20103 } accept
		iifname "wlp17s0" ip saddr 192.168.69.132 tcp dport 8443 accept comment "LXD: Stevie's laptop only"
		iifname "wlp17s0" ip6 saddr fe80::/10 tcp dport 7375 accept

		limit rate 5/minute log prefix "unheaded-drop: " level info
		counter
	}

	# Forward (2026-11-03): west routes for its containers (lxdbr0, docker0,
	# br-*) and for east (enp16s0 -> wlp17s0, masqueraded). Containers leave
	# the P2P link and the overlay masqueraded as west's own address, so
	# east's input chain ("iifname enp2s0 ip saddr 192.168.13.2 accept")
	# cannot tell a container from the host. This chain is where that
	# distinction lives: containers reach east only for scrapes and the
	# service port range; ssh, BGP, BFD, WireGuard and the apt repo stay
	# host-to-host. Policy accept, so Docker's and LXD's own forward rules
	# (LAN, internet, container-to-container) keep working; the LAN already
	# cannot start connections to east (iptables FORWARD, replies only).
	# east's chaos-controller (19012) is dropped earlier by chaos-guard.
	chain forward {
		type filter hook forward priority filter; policy accept;

		ct state established,related accept
		ct state invalid drop

		# Docker-published ports (2026-11-04 review): DNAT skips input, so scope
		# them here. Nothing published reaches the ISP IPv6 prefix; the LAN gets
		# only the agreed UIs and Pi-hole's DNS; everything else is dropped.
		iifname "wlp17s0" ct status dnat meta nfproto ipv6 counter drop comment "no published port on the ISP prefix"
		iifname "wlp17s0" ct status dnat ip saddr 192.168.69.128/25 meta l4proto { tcp, udp } ct original proto-dst { 53, 3000, 3001, 16666, 20000, 20001, 20002, 20103 } accept
		iifname "wlp17s0" ct status dnat counter drop comment "published ports stay off the LAN unless agreed"

		iifname "lxdbr0" oifname { "enp16s0", "wg0" } jump container_to_east
		iifname "docker0" oifname { "enp16s0", "wg0" } jump container_to_east
		iifname "br-*" oifname { "enp16s0", "wg0" } jump container_to_east

		# ADR-014: TCP over the overlay never fragments inside WireGuard.
		oifname "wg0" tcp flags syn tcp option maxseg size set rt mtu
	}

	chain container_to_east {
		tcp dport { 9100, 9110, 16666-26666 } accept comment "node_exporter, huginn, services"
		limit rate 5/minute log prefix "unheaded-fwd-drop: " level info
		counter drop comment "containers are masqueraded as west; nothing else reaches east as the host"
	}
}
