#!/usr/sbin/nft -f
# SPDX-License-Identifier: GPL-3.0-or-later
# west: inbound default deny (ADR-098 step 6, UH-FW-01, CIS Ubuntu 24.04 4.3.8).
# One table this package owns; Docker's and LXD's tables are never touched.
# Apply only through scripts/host/nft-apply-confirm.sh (rolls back unless
# confirmed). A drop in any input base chain is final, so every path the host
# relies on must be accepted here, including LXD's DHCP/DNS.
#
# Another host: copy this file to <host>.nft and edit only the define block
# below. Every interface, address and port set the rules use is named there
# once; the rules below it should not need changes. The comments beside the
# rules explain west's choices and name west's values, so reword them for the
# new host. The rates are the one exception, see the end of the block.

# Interfaces (2026-09-30).
define LAN_IF = "wlp17s0"        # home LAN, 192.168.69.128/25 + ISP IPv6
define PEER_IF = "enp16s0"       # P2P link to the peer host east, 192.168.13.0/30
define OVERLAY_IF = "wg0"        # WireGuard overlay (only peer: east)
define LXD_IF = "lxdbr0"         # LXD container bridge
define DOCKER_IF = "docker0"     # Docker default bridge
define DOCKER_BR_IF = "br-*"     # Docker user-defined bridges (wildcard)

# Addresses.
define LAN_V4 = 192.168.69.128/25    # LAN prefix that is offered services
define PEER_V4 = 192.168.13.1        # east's address on the P2P link
define ADMIN_V4 = 192.168.69.132     # admin laptop: the one LAN host let in to LXD's API

# Ports, input chain.
define SSH_TCP = 7375                # sshd; also inside LAN_TCP
define LAN_TCP = { $SSH_TCP, 80, 443, 18888, 16666, 20000, 20001, 20002, 20103 }    # LAN: ssh, haproxy edge, apt repo, web UIs
define LXD_API_TCP = 8443            # LXD API, from ADMIN_V4 only
define LXD_UDP = { 53, 67 }          # containers to the LXD bridge's dnsmasq: DNS, DHCP
define LXD_DNS_TCP = 53              # containers to the LXD bridge's dnsmasq: DNS over TCP
define SYSLOG_PORT = 514             # syslog relay from containers (ADR-124), TCP and UDP
define SCRAPE_TCP = { 8428, 9100, 9110, 9323, 16666-26666 }    # Docker bridges to host: VictoriaMetrics, exporters, services

# Ports, forward chain.
define LAN_FWD_PORTS = { 53, 3000, 3001, 16666, 20000, 20001, 20002, 20103 }    # Docker-published ports the LAN may reach, TCP and UDP
define TO_PEER_TCP = { 9100, 9110, 16666-26666 }    # containers to east: node_exporter, huginn, services

# Rates stay in the rules: nft (1.1.5) takes only a literal number after
# "limit rate", not a variable. Ping is 10/second (two rules in input); the
# drop logs are 5/minute (end of input, and container_to_east).

table inet unheaded
delete table inet unheaded

table inet unheaded {
	chain input {
		type filter hook input priority filter; policy drop;

		iif "lo" accept
		ct state established,related accept
		ct state invalid drop

		# ICMP needed for IPv6 to work at all (neighbour discovery, router
		# advertisements for west's SLAAC address, path MTU); no redirects.
		icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert } accept
		ip6 saddr fe80::/10 icmpv6 type { mld-listener-query, mld-listener-report, mld2-listener-report } accept
		icmpv6 type echo-request limit rate 10/second accept
		icmp type { destination-unreachable, time-exceeded, parameter-problem } accept
		icmp type echo-request limit rate 10/second accept
		ip6 saddr fe80::/10 udp sport 547 udp dport 546 accept comment "DHCPv6 client"

		# east: the P2P link and the overlay are both ours (BGP, BFD, WireGuard,
		# apt repo on 18888, node_exporter scrapes).
		iifname $PEER_IF ip saddr $PEER_V4 accept
		iifname $PEER_IF ip6 saddr fe80::/10 accept
		iifname $OVERLAY_IF accept

		# LXD containers: DHCP and DNS from lxdbr0's dnsmasq.
		iifname $LXD_IF udp dport $LXD_UDP accept
		iifname $LXD_IF tcp dport $LXD_DNS_TCP accept
		# Syslog relay (ADR-124): the Pi-hole container forwards its logs here.
		iifname $LXD_IF tcp dport $SYSLOG_PORT accept
		iifname $LXD_IF udp dport $SYSLOG_PORT accept

		# Docker bridges: the monitoring stack scrapes host ports, and
		# Prometheus remote-writes to VictoriaMetrics (8428) over the host.
		iifname $DOCKER_IF tcp dport $SCRAPE_TCP accept
		iifname $DOCKER_BR_IF tcp dport $SCRAPE_TCP accept

		# Home LAN (Stevie 2026-11-03): ssh, the haproxy edge, the apt repo
		# (plain HTTP on 18888), and the web UIs on their direct ports. DNS
		# rides the wlp17s0 DNAT to Pi-hole, so it never reaches this chain.
		# Docker-published ports are not filtered here either: they DNAT in
		# Docker's chains. LXD's 8443 is the laptop only. Nothing else
		# (node_exporter, huginn, dockerd metrics, BGP) is offered to the LAN,
		# and nothing at all to the ISP IPv6 prefix except ssh over link-local.
		iifname $LAN_IF ip saddr $LAN_V4 tcp dport $LAN_TCP accept
		iifname $LAN_IF ip saddr $ADMIN_V4 tcp dport $LXD_API_TCP accept comment "LXD: Stevie's laptop only"
		iifname $LAN_IF ip6 saddr fe80::/10 tcp dport $SSH_TCP accept

		limit rate 5/minute log prefix "unheaded-drop: " level info
		counter
	}

	# Forward (2026-11-03): west routes for its containers (lxdbr0, docker0,
	# br-*) and for east (enp16s0 -> wlp17s0, masqueraded). Containers leave
	# the P2P link and the overlay masqueraded as west's own address, so
	# east's input chain ("iifname enp2s0 ip saddr 192.168.13.2 accept")
	# cannot tell a container from the host. This chain is where that
	# distinction lives: containers reach east only for scrapes and the
	# service port range; ssh, BGP, BFD, WireGuard and the apt repo stay
	# host-to-host. Policy accept, so Docker's and LXD's own forward rules
	# (LAN, internet, container-to-container) keep working; the LAN already
	# cannot start connections to east (iptables FORWARD, replies only).
	# east's chaos-controller (19012) is dropped earlier by chaos-guard.
	chain forward {
		type filter hook forward priority filter; policy accept;

		ct state established,related accept
		ct state invalid drop

		# Docker-published ports (2026-11-04 review): DNAT skips input, so scope
		# them here. Nothing published reaches the ISP IPv6 prefix; the LAN gets
		# only the agreed UIs and Pi-hole's DNS; everything else is dropped.
		iifname $LAN_IF ct status dnat meta nfproto ipv6 counter drop comment "no published port on the ISP prefix"
		iifname $LAN_IF ct status dnat ip saddr $LAN_V4 meta l4proto { tcp, udp } ct original proto-dst $LAN_FWD_PORTS accept
		iifname $LAN_IF ct status dnat counter drop comment "published ports stay off the LAN unless agreed"

		iifname $LXD_IF oifname { $PEER_IF, $OVERLAY_IF } jump container_to_east
		iifname $DOCKER_IF oifname { $PEER_IF, $OVERLAY_IF } jump container_to_east
		iifname $DOCKER_BR_IF oifname { $PEER_IF, $OVERLAY_IF } jump container_to_east

		# ADR-014: TCP over the overlay never fragments inside WireGuard.
		oifname $OVERLAY_IF tcp flags syn tcp option maxseg size set rt mtu
	}

	chain container_to_east {
		tcp dport $TO_PEER_TCP accept comment "node_exporter, huginn, services"
		limit rate 5/minute log prefix "unheaded-fwd-drop: " level info
		counter drop comment "containers are masqueraded as west; nothing else reaches east as the host"
	}
}
