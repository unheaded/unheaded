// Package storage provides container storage and volume management
package storage

import (
	"context"
	"errors"
	"fmt"
	"sync"
	"time"

	
	"os"
	"unheaded/pkg/logger"
)

// ============================================================================
// ERRORS
// ============================================================================

var (
	ErrVolumeNotFound   = errors.New("volume not found")
	ErrVolumeExists     = errors.New("volume already exists")
	ErrVolumeInUse      = errors.New("volume is in use")
	ErrDriverNotFound   = errors.New("storage driver not found")
	ErrInvalidConfig    = errors.New("invalid storage configuration")
	ErrQuotaExceeded    = errors.New("storage quota exceeded")
	ErrSnapshotNotFound = errors.New("snapshot not found")
)

// ============================================================================
// TYPES
// ============================================================================

// Volume represents a storage volume
type Volume struct {
	ID         string            `json:"id"`
	Name       string            `json:"name"`
	Driver     string            `json:"driver"`
	Mountpoint string            `json:"mountpoint"`
	Labels     map[string]string `json:"labels,omitempty"`
	Options    map[string]string `json:"options,omitempty"`
	Scope      string            `json:"scope"`
	Status     VolumeStatus      `json:"status"`
	Size       int64             `json:"size,omitempty"`
	UsedSize   int64             `json:"used_size,omitempty"`
	CreatedAt  time.Time         `json:"created_at"`
	UsedBy     []string          `json:"used_by,omitempty"`
}

// VolumeStatus represents the status of a volume
type VolumeStatus string

const (
	VolumeStatusActive   VolumeStatus = "active"
	VolumeStatusInactive VolumeStatus = "inactive"
	VolumeStatusError    VolumeStatus = "error"
)

// CreateOptions configures volume creation
type CreateOptions struct {
	Driver     string            `json:"driver,omitempty"`
	Labels     map[string]string `json:"labels,omitempty"`
	Options    map[string]string `json:"options,omitempty"`
	Size       int64             `json:"size,omitempty"`
}

// ListOptions configures volume listing
type ListOptions struct {
	Filters map[string]string `json:"filters,omitempty"`
}

// PruneOptions configures volume pruning
type PruneOptions struct {
	All     bool              `json:"all,omitempty"`
	Filters map[string]string `json:"filters,omitempty"`
}

// PruneReport contains results of volume pruning
type PruneReport struct {
	VolumesDeleted []string `json:"volumes_deleted"`
	SpaceReclaimed int64    `json:"space_reclaimed"`
}

// Snapshot represents a volume snapshot
type Snapshot struct {
	ID        string            `json:"id"`
	Name      string            `json:"name"`
	VolumeID  string            `json:"volume_id"`
	Size      int64             `json:"size"`
	CreatedAt time.Time         `json:"created_at"`
	Labels    map[string]string `json:"labels,omitempty"`
}

// SnapshotOptions configures snapshot creation
type SnapshotOptions struct {
	Name   string            `json:"name,omitempty"`
	Labels map[string]string `json:"labels,omitempty"`
}

// ============================================================================
// MANAGER INTERFACE
// ============================================================================

// Manager defines the interface for volume management
type Manager interface {
	// Volume operations
	Create(ctx context.Context, name string, opts *CreateOptions) (*Volume, error)
	Delete(ctx context.Context, name string, force bool) error
	Get(ctx context.Context, name string) (*Volume, error)
	List(ctx context.Context, opts *ListOptions) ([]*Volume, error)

	// Volume usage
	Use(ctx context.Context, volumeName, containerID string) error
	Release(ctx context.Context, volumeName, containerID string) error

	// Snapshot operations
	CreateSnapshot(ctx context.Context, volumeName string, opts *SnapshotOptions) (*Snapshot, error)
	DeleteSnapshot(ctx context.Context, volumeName, snapshotName string) error
	ListSnapshots(ctx context.Context, volumeName string) ([]*Snapshot, error)
	RestoreSnapshot(ctx context.Context, volumeName, snapshotName string) error

	// Cleanup
	Prune(ctx context.Context, opts *PruneOptions) (*PruneReport, error)

	// Stats
	Stats(ctx context.Context, name string) (*VolumeStats, error)
}

// VolumeStats contains volume usage statistics
type VolumeStats struct {
	VolumeID   string    `json:"volume_id"`
	Size       int64     `json:"size"`
	UsedSize   int64     `json:"used_size"`
	InodeTotal int64     `json:"inode_total,omitempty"`
	InodeUsed  int64     `json:"inode_used,omitempty"`
	ReadOps    uint64    `json:"read_ops"`
	WriteOps   uint64    `json:"write_ops"`
	ReadBytes  uint64    `json:"read_bytes"`
	WriteBytes uint64    `json:"write_bytes"`
	Timestamp  time.Time `json:"timestamp"`
}

// ============================================================================
// DEFAULT MANAGER IMPLEMENTATION
// ============================================================================

// DefaultManager is a basic volume manager implementation
type DefaultManager struct {
	mu        sync.RWMutex
	volumes   map[string]*Volume
	snapshots map[string][]*Snapshot
	basePath  string
	logger    zerolog.Logger
}

// NewDefaultManager creates a new default volume manager
func NewDefaultManager(basePath string) *DefaultManager {
	if basePath == "" {
		basePath = "/var/lib/unheaded/volumes"
	}
	return &DefaultManager{
		volumes:   make(map[string]*Volume),
		snapshots: make(map[string][]*Snapshot),
		basePath:  basePath,
		logger:    log.With().Str("component", "volume-manager").Logger(),
	}
}

// Create creates a new volume
func (m *DefaultManager) Create(ctx context.Context, name string, opts *CreateOptions) (*Volume, error) {
	m.mu.Lock()
	defer m.mu.Unlock()

	m.logger.Info().Str("name", name).Msg("creating volume")

	if _, exists := m.volumes[name]; exists {
		return nil, ErrVolumeExists
	}

	if opts == nil {
		opts = &CreateOptions{}
	}

	driver := opts.Driver
	if driver == "" {
		driver = "local"
	}

	volume := &Volume{
		ID:         generateVolumeID(),
		Name:       name,
		Driver:     driver,
		Mountpoint: fmt.Sprintf("%s/%s", m.basePath, name),
		Labels:     opts.Labels,
		Options:    opts.Options,
		Scope:      "local",
		Status:     VolumeStatusActive,
		Size:       opts.Size,
		CreatedAt:  time.Now(),
		UsedBy:     []string{},
	}

	m.volumes[name] = volume
	m.snapshots[name] = []*Snapshot{}

	return volume, nil
}

// Delete deletes a volume
func (m *DefaultManager) Delete(ctx context.Context, name string, force bool) error {
	m.mu.Lock()
	defer m.mu.Unlock()

	m.logger.Info().Str("name", name).Bool("force", force).Msg("deleting volume")

	volume, exists := m.volumes[name]
	if !exists {
		return ErrVolumeNotFound
	}

	// Check if volume is in use
	if len(volume.UsedBy) > 0 && !force {
		return ErrVolumeInUse
	}

	delete(m.volumes, name)
	delete(m.snapshots, name)
	return nil
}

// Get retrieves a volume by name
func (m *DefaultManager) Get(ctx context.Context, name string) (*Volume, error) {
	m.mu.RLock()
	defer m.mu.RUnlock()

	volume, exists := m.volumes[name]
	if !exists {
		return nil, ErrVolumeNotFound
	}

	return volume, nil
}

// List lists all volumes
func (m *DefaultManager) List(ctx context.Context, opts *ListOptions) ([]*Volume, error) {
	m.mu.RLock()
	defer m.mu.RUnlock()

	volumes := make([]*Volume, 0, len(m.volumes))
	for _, v := range m.volumes {
		if m.matchFilters(v, opts) {
			volumes = append(volumes, v)
		}
	}

	return volumes, nil
}

// Use marks a volume as being used by a container
func (m *DefaultManager) Use(ctx context.Context, volumeName, containerID string) error {
	m.mu.Lock()
	defer m.mu.Unlock()

	volume, exists := m.volumes[volumeName]
	if !exists {
		return ErrVolumeNotFound
	}

	// Check if already in use by this container
	for _, id := range volume.UsedBy {
		if id == containerID {
			return nil
		}
	}

	volume.UsedBy = append(volume.UsedBy, containerID)
	return nil
}

// Release releases a volume from a container
func (m *DefaultManager) Release(ctx context.Context, volumeName, containerID string) error {
	m.mu.Lock()
	defer m.mu.Unlock()

	volume, exists := m.volumes[volumeName]
	if !exists {
		return ErrVolumeNotFound
	}

	// Remove container from UsedBy list
	newUsedBy := make([]string, 0, len(volume.UsedBy))
	for _, id := range volume.UsedBy {
		if id != containerID {
			newUsedBy = append(newUsedBy, id)
		}
	}
	volume.UsedBy = newUsedBy

	return nil
}

// CreateSnapshot creates a volume snapshot
func (m *DefaultManager) CreateSnapshot(ctx context.Context, volumeName string, opts *SnapshotOptions) (*Snapshot, error) {
	m.mu.Lock()
	defer m.mu.Unlock()

	m.logger.Info().Str("volume", volumeName).Msg("creating snapshot")

	volume, exists := m.volumes[volumeName]
	if !exists {
		return nil, ErrVolumeNotFound
	}

	if opts == nil {
		opts = &SnapshotOptions{}
	}

	snapshotName := opts.Name
	if snapshotName == "" {
		snapshotName = fmt.Sprintf("snap-%d", time.Now().UnixNano())
	}

	snapshot := &Snapshot{
		ID:        generateSnapshotID(),
		Name:      snapshotName,
		VolumeID:  volume.ID,
		Size:      volume.UsedSize,
		CreatedAt: time.Now(),
		Labels:    opts.Labels,
	}

	m.snapshots[volumeName] = append(m.snapshots[volumeName], snapshot)

	return snapshot, nil
}

// DeleteSnapshot deletes a volume snapshot
func (m *DefaultManager) DeleteSnapshot(ctx context.Context, volumeName, snapshotName string) error {
	m.mu.Lock()
	defer m.mu.Unlock()

	m.logger.Info().Str("volume", volumeName).Str("snapshot", snapshotName).Msg("deleting snapshot")

	snaps, exists := m.snapshots[volumeName]
	if !exists {
		return ErrVolumeNotFound
	}

	found := false
	newSnaps := make([]*Snapshot, 0, len(snaps))
	for _, s := range snaps {
		if s.Name != snapshotName {
			newSnaps = append(newSnaps, s)
		} else {
			found = true
		}
	}

	if !found {
		return ErrSnapshotNotFound
	}

	m.snapshots[volumeName] = newSnaps
	return nil
}

// ListSnapshots lists all snapshots for a volume
func (m *DefaultManager) ListSnapshots(ctx context.Context, volumeName string) ([]*Snapshot, error) {
	m.mu.RLock()
	defer m.mu.RUnlock()

	if _, exists := m.volumes[volumeName]; !exists {
		return nil, ErrVolumeNotFound
	}

	snaps := m.snapshots[volumeName]
	if snaps == nil {
		snaps = []*Snapshot{}
	}

	return snaps, nil
}

// RestoreSnapshot restores a volume from a snapshot
func (m *DefaultManager) RestoreSnapshot(ctx context.Context, volumeName, snapshotName string) error {
	m.mu.Lock()
	defer m.mu.Unlock()

	m.logger.Info().Str("volume", volumeName).Str("snapshot", snapshotName).Msg("restoring snapshot")

	snaps, exists := m.snapshots[volumeName]
	if !exists {
		return ErrVolumeNotFound
	}

	found := false
	for _, s := range snaps {
		if s.Name == snapshotName {
			found = true
			break
		}
	}

	if !found {
		return ErrSnapshotNotFound
	}

	// In a real implementation, this would restore the volume data
	return nil
}

// Prune removes unused volumes
func (m *DefaultManager) Prune(ctx context.Context, opts *PruneOptions) (*PruneReport, error) {
	m.mu.Lock()
	defer m.mu.Unlock()

	m.logger.Info().Msg("pruning volumes")

	report := &PruneReport{
		VolumesDeleted: []string{},
	}

	for name, volume := range m.volumes {
		// Skip volumes in use
		if len(volume.UsedBy) > 0 {
			continue
		}

		// Check filters
		if opts != nil && opts.Filters != nil {
			if label, ok := opts.Filters["label"]; ok {
				if volume.Labels == nil {
					continue
				}
				if _, hasLabel := volume.Labels[label]; !hasLabel {
					continue
				}
			}
		}

		report.SpaceReclaimed += volume.Size
		report.VolumesDeleted = append(report.VolumesDeleted, name)
		delete(m.volumes, name)
		delete(m.snapshots, name)
	}

	return report, nil
}

// Stats returns volume usage statistics
func (m *DefaultManager) Stats(ctx context.Context, name string) (*VolumeStats, error) {
	m.mu.RLock()
	defer m.mu.RUnlock()

	volume, exists := m.volumes[name]
	if !exists {
		return nil, ErrVolumeNotFound
	}

	return &VolumeStats{
		VolumeID:  volume.ID,
		Size:      volume.Size,
		UsedSize:  volume.UsedSize,
		Timestamp: time.Now(),
	}, nil
}

// matchFilters checks if a volume matches the given filters
func (m *DefaultManager) matchFilters(volume *Volume, opts *ListOptions) bool {
	if opts == nil || opts.Filters == nil {
		return true
	}

	for key, value := range opts.Filters {
		switch key {
		case "name":
			if volume.Name != value {
				return false
			}
		case "driver":
			if volume.Driver != value {
				return false
			}
		case "label":
			if volume.Labels == nil {
				return false
			}
			if _, ok := volume.Labels[value]; !ok {
				return false
			}
		case "dangling":
			isDangling := len(volume.UsedBy) == 0
			if value == "true" && !isDangling {
				return false
			}
			if value == "false" && isDangling {
				return false
			}
		}
	}

	return true
}

// ============================================================================
// HELPERS
// ============================================================================

// generateVolumeID generates a unique volume ID
func generateVolumeID() string {
	return fmt.Sprintf("%x", time.Now().UnixNano())
}

// generateSnapshotID generates a unique snapshot ID
func generateSnapshotID() string {
	return fmt.Sprintf("%x", time.Now().UnixNano())
}

// Ensure DefaultManager implements Manager interface
var _ Manager = (*DefaultManager)(nil)
