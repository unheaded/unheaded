# SPDX-License-Identifier: GPL-3.0-or-later
#
# Makefile.mbc — RV32I + MBC build for xv6-on-UPC.
# ASCEND-LINUX Phase 1.1.
#
# Usage (from crates/xv6-mbc/upstream/):
#   make -f ../adapters/Makefile.mbc kernel
#
# Differences from upstream/Makefile (RV64 + QEMU virt):
#   - TOOLPREFIX hardcoded to riscv64-unknown-elf- (already on WEST per Doom).
#   - CFLAGS use -march=rv32i -mabi=ilp32e (matches Doom's pipeline).
#   - OBJS replaces start.o / uart.o / virtio_disk.o with our adapters.
#   - Drops plic.o (no PLIC on UPC; trap routing via MBC IVT).
#   - Linker script kernel-mbc.ld places sections per UPC memory layout.
#   - Final step runs rv32i-to-mbc translator → kernel.mbc.

K = kernel
A = ../adapters

TOOLPREFIX = riscv64-unknown-elf-
CC = $(TOOLPREFIX)gcc
AS = $(TOOLPREFIX)as
LD = $(TOOLPREFIX)ld
OBJCOPY = $(TOOLPREFIX)objcopy
OBJDUMP = $(TOOLPREFIX)objdump

# RV32I flags — matches demos/doom/Makefile.
GCC_INCLUDE = $(shell $(CC) -print-file-name=include)
CFLAGS = -march=rv32i_zicsr_zmmul -mabi=ilp32e -nostdlib -nostdinc -static -ffreestanding \
         -fno-builtin -O2 \
         -ffixed-x16 -ffixed-x17 -ffixed-x18 -ffixed-x19 \
         -ffixed-x20 -ffixed-x21 -ffixed-x22 -ffixed-x23 \
         -ffixed-x24 -ffixed-x25 -ffixed-x26 -ffixed-x27 \
         -ffixed-x28 -ffixed-x29 -ffixed-x30 -ffixed-x31 \
         -I$(K) -I$A -isystem $(GCC_INCLUDE) \
         -DPHYSTOP=0x00800000UL \
         -DUPC_SKIP_KFREE_MEMSET -DUPC_SKIP_KALLOC_MEMSET \
         -DUPC_SKIP_KVMINIT \
         -DUPC_FLAT_TRAMPOLINE
# Phase 1.4 PHYSTOP override: upstream xv6 expects PHYSTOP at
# KERNBASE + 128 MiB = 0x88000000, but UPC's RAM_MAP has no backing
# in that range. Cap at 0x00800000 (just below the ramdisk region per
# UPC_PAGE_TABLE_LAYOUT.md); this gives kinit's freerange ~7.5 MiB of
# RAM_MAP-backed pages to walk instead of 128 MiB of phantom memory.
#
# UPC_SKIP_K{FREE,ALLOC}_MEMSET: upstream kfree+kalloc include a
# debug "fill with junk" memset over each 4 KiB page. Through the BPF
# interpreter that's ~40K BPF insns PER page; freerange's 1900-page
# walk would burn ~75M insns. Disabled on UPC — debug-fill is
# diagnostic-only and the BPF interpreter has its own safety nets.
# See references/phase14-xv6-init-loop-root-cause-2026-05-13.md.
ASFLAGS = -march=rv32i_zicsr_zmmul -mabi=ilp32e
# zicsr is needed because xv6's entry.S uses csrr (the rv32i-to-mbc translator
# rewrites these to memory-mapped loads at the 0x000_F000 region per ADR-067
# Decision 2). zmmul covers the multiply ops xv6 emits — these compile to
# MBC's MUL/MULH/MULHU at 0x03/0x39/0x3A.

LDFLAGS = -z max-page-size=4096 -melf32lriscv

OBJS = \
  $A/uentry.o \
  $A/start_mbc.o \
  $A/uconsole.o \
  $A/uprintf.o \
  $A/console-mmio.o \
  $A/syscall_shims.o \
  $A/ukalloc.o \
  $A/uspinlock.o \
  $A/ustring.o \
  $A/umain.o \
  $K/vm.o \
  $K/proc.o \
  $A/swtch_mbc.o \
  $A/trampoline_mbc.o \
  $K/trap.o \
  $A/usyscall.o \
  $A/usysproc.o \
  $A/ubio.o \
  $K/fs.o \
  $A/ulog.o \
  $A/usleeplock.o \
  $A/ufile.o \
  $A/upipe.o \
  $K/exec.o \
  $A/usysfile.o \
  $A/kernelvec_mbc.o \
  $A/blk-ramdisk.o \
  $A/libgcc_stubs.o
# DROPPED from upstream OBJS:
#   $K/start.o          → replaced by $A/start_mbc.o
#   $K/uart.o           → replaced by $A/console-mmio.o
#   $K/plic.o           → no PLIC on UPC; trap routing via IVT
#   $K/virtio_disk.o    → replaced by $A/blk-ramdisk.o
# Track 2 Phase 2.3 (ADR-081) — kernel edges are OURS:
#   $K/entry.o          → replaced by $A/uentry.o
#   $K/syscall.o        → replaced by $A/usyscall.o (runtime-dead on UPC —
#                         BPF ecall dispatch owns the syscall surface — but
#                         linked for trap.c/sysproc/sysfile; alive in 2.4)
#   $K/printf.o         → replaced by $A/uprintf.o (every kernel boot print)
#   $K/console.o        → replaced by $A/uconsole.o (top half; bottom half
#                         is console-mmio.o — console stack 100% ours)
# Track 2 Phase 2.4 (ADR-081) — kernel core becomes OURS (tranche 1):
#   $K/string.o         → replaced by $A/ustring.o (mem*/str* primitives —
#                         every TTY byte and page fill transits these)
#   $K/spinlock.o       → replaced by $A/uspinlock.o (cons.lock on every
#                         print, kmem.lock per freerange page; push_off/
#                         pop_off discipline live even single-hart)
#   $K/sleeplock.o      → replaced by $A/usleeplock.o (bio/log/inode init
#                         live; "sleep lock" inner-guard name quirk kept)
#   $K/kalloc.o         → replaced by $A/ukalloc.o (freerange ~1900-page
#                         walk; mmio_puts markers + kfree probe ladder are
#                         IN the goldens; UPC_SKIP_* memset ifdefs kept)
# Track 2 Phase 2.4 (ADR-081) — kernel core, tranche 2:
#   $K/main.o           → replaced by $A/umain.o (the boot spine; 14 init-
#                         bisection markers print INTO the goldens)
#   $K/bio.o            → replaced by $A/ubio.o (LRU buffer cache; binit +
#                         fsinit-era bread live via blk-ramdisk)
#   $K/log.o            → replaced by $A/ulog.o (redo log; recover_from_log
#                         live at fsinit; commit machinery dormant)
#   $K/file.o           → replaced by $A/ufile.o (ftable + devsw[] — the
#                         console stack's link anchor; bodies dormant)
# Track 2 Phase 2.4 (ADR-081) — kernel core, tranche 3:
#   $K/sysproc.o        → replaced by $A/usysproc.o (runtime-dead wrappers;
#                         linked via usyscall's syscalls[] table)
#   $K/sysfile.o        → replaced by $A/usysfile.o (fd/FS wrappers; BPF
#                         fs_walk owns the live surface)
#   $K/pipe.o           → replaced by $A/upipe.o (pipe(4) unimplemented in
#                         BPF dispatch; linked for fileclose/sysfile)

%.o: %.c
	$(CC) $(CFLAGS) -c -o $@ $<

%.o: %.S
	# Use $(CC) so the C preprocessor expands #include + macros (xv6's
	# trampoline.S includes memlayout.h which expands MAXVA / TRAPFRAME).
	$(CC) $(CFLAGS) -c -o $@ $<

kernel/kernel.elf: $(OBJS) $A/kernel-mbc.ld
	$(LD) $(LDFLAGS) -T $A/kernel-mbc.ld -o $@ $(OBJS)
	$(OBJDUMP) -d $@ > kernel/kernel.asm

# Final translation: RV32I ELF → MBC bytecode.
# rv32i-to-mbc lives in crates/monad-mbc/ (built separately).
target/xv6-mbc.mbc: kernel/kernel.elf
	mkdir -p target
	../../monad-mbc/target/release/rv32i-to-mbc kernel/kernel.elf -o target/xv6-mbc.mbc

kernel: target/xv6-mbc.mbc

clean:
	rm -f $K/*.o $K/*.elf $K/*.asm $A/*.o
	rm -rf target

.PHONY: clean kernel
