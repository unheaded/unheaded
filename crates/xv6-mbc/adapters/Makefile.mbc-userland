# SPDX-License-Identifier: GPL-3.0-or-later
#
# Makefile.mbc-userland — userland (init / sh / cmds) build for xv6-on-UPC.
# ASCEND-LINUX Phase 1.3 IMPL Step 8 scaffold per
# `references/battle-plan-phase13-impl-2026-05-13.md`.
#
# Usage (from crates/xv6-mbc/upstream/):
#   make -f ../adapters/Makefile.mbc-userland init
#   make -f ../adapters/Makefile.mbc-userland sh
#   make -f ../adapters/Makefile.mbc-userland ramdisk
#
# Mirrors Makefile.mbc's pattern (kernel side) but with two differences:
#   1. Output goes to target/ as <prog>.mbc + <prog>.rv2mbc.
#   2. Linker script is upstream user/user.ld (already present).
#   3. Each program links against ulib.o + printf.o + umalloc.o + usys.o
#      (the usys.S is generated from usys.pl).
#
# Status (Phase 1.3): scaffold. The actual builds require:
#   * Phase 1.4 filesystem syscall stubs (open/read/write/dup/wait/exec).
#   * Phase 1.4 mkfs host tool (already vendored at upstream/mkfs/mkfs.c).
#   * Phase 1.4 ramdisk image emission + upc-bootctl --ramdisk flag.
# See `references/phase13-step8-userland-build-notes.md` for the carry-over.

K = kernel
U = user
A = ../adapters
T = target

TOOLPREFIX = riscv64-unknown-elf-
CC = $(TOOLPREFIX)gcc
LD = $(TOOLPREFIX)ld
OBJCOPY = $(TOOLPREFIX)objcopy
OBJDUMP = $(TOOLPREFIX)objdump

# Same RV32I + zicsr + zmmul flags as kernel side. -ffixed-x18..x31 keeps
# the C compiler off MBC-unavailable registers (s2-s11 / t3-t6).
GCC_INCLUDE = $(shell $(CC) -print-file-name=include)
CFLAGS = -march=rv32i_zicsr_zmmul -mabi=ilp32e -nostdlib -nostdinc -static -ffreestanding \
         -fno-builtin -O2 \
         -ffixed-x16 -ffixed-x17 -ffixed-x18 -ffixed-x19 \
         -ffixed-x20 -ffixed-x21 -ffixed-x22 -ffixed-x23 \
         -ffixed-x24 -ffixed-x25 -ffixed-x26 -ffixed-x27 \
         -ffixed-x28 -ffixed-x29 -ffixed-x30 -ffixed-x31 \
         -I. -isystem $(GCC_INCLUDE)
ASFLAGS = -march=rv32i_zicsr_zmmul -mabi=ilp32e

LDFLAGS = -z max-page-size=4096 -melf32lriscv

# Generate usys.S from usys.pl (xv6 convention).
$U/usys.S: $U/usys.pl
	perl $U/usys.pl > $U/usys.S

# Userland support library objects, shared by every user program.
# Includes adapters/libgcc_stubs.o because freestanding RV32 lacks
# libgcc's 64-bit divide helpers (__umoddi3 / __udivdi3) that printf.c
# transitively pulls in. The kernel side hit the same gap; reusing the
# same stub file.
USER_LIB_OBJS = \
  $U/ulib.o \
  $U/usys.o \
  $U/printf.o \
  $U/umalloc.o \
  $A/libgcc_stubs.o

# Generic compile rule (same as Makefile.mbc).
%.o: %.c
	$(CC) $(CFLAGS) -c -o $@ $<

%.o: %.S
	$(CC) $(CFLAGS) -c -o $@ $<

# Per-program ELF link rule: $T/<prog>.elf depends on $U/<prog>.o + the
# shared USER_LIB_OBJS. Pattern rule keeps the Makefile small as the
# userland grows (init, sh, ls, cat, echo, wc, ln, mkdir, kill, rm, grep
# all build from one rule).
$T/%.elf: $A/crt0_mbc.o $U/%.o $(USER_LIB_OBJS) $U/user.ld
	mkdir -p $T
	$(LD) $(LDFLAGS) -T $U/user.ld -o $@ $A/crt0_mbc.o $U/$*.o $(USER_LIB_OBJS)

# Track 2 Phase 2.2 (ADR-081): replaced coreutils are OURS. Each artifact
# keeps its original name — that is the PROGRAM_TABLE basename sh resolves
# at exec time — but links from our u<prog>.c source. The MIT xv6 sources
# stay in the vendored tree, unwired. (Explicit rules override the pattern
# rule above.)
$T/echo.elf: $A/crt0_mbc.o $U/uecho.o $(USER_LIB_OBJS) $U/user.ld
	mkdir -p $T
	$(LD) $(LDFLAGS) -T $U/user.ld -o $@ $A/crt0_mbc.o $U/uecho.o $(USER_LIB_OBJS)

$T/cat.elf: $A/crt0_mbc.o $U/ucat.o $(USER_LIB_OBJS) $U/user.ld
	mkdir -p $T
	$(LD) $(LDFLAGS) -T $U/user.ld -o $@ $A/crt0_mbc.o $U/ucat.o $(USER_LIB_OBJS)

$T/wc.elf: $A/crt0_mbc.o $U/uwc.o $(USER_LIB_OBJS) $U/user.ld
	mkdir -p $T
	$(LD) $(LDFLAGS) -T $U/user.ld -o $@ $A/crt0_mbc.o $U/uwc.o $(USER_LIB_OBJS)

$T/ls.elf: $A/crt0_mbc.o $U/uls.o $(USER_LIB_OBJS) $U/user.ld
	mkdir -p $T
	$(LD) $(LDFLAGS) -T $U/user.ld -o $@ $A/crt0_mbc.o $U/uls.o $(USER_LIB_OBJS)

# Phase 2.2 finale: sh itself is OURS. Last MIT program out of the exec set.
$T/sh.elf: $A/crt0_mbc.o $U/ush.o $(USER_LIB_OBJS) $U/user.ld
	mkdir -p $T
	$(LD) $(LDFLAGS) -T $U/user.ld -o $@ $A/crt0_mbc.o $U/ush.o $(USER_LIB_OBJS)

# Translate ELF → MBC + .rv2mbc + .data sidecars, then the .rv2mbc.sha256
# sidecar upc-bootctl checks the .rv2mbc against (S-ASCEND-2 Item 5).
$T/%.mbc: $T/%.elf
	../../monad-mbc/target/release/rv32i-to-mbc $< -o $@
	set -e; h=$$(sha256sum $T/$*.rv2mbc); echo "$${h%% *}" > $T/$*.rv2mbc.sha256

# A tree built before the sidecar existed gets it without a retranslation.
$T/%.rv2mbc.sha256: $T/%.mbc
	set -e; h=$$(sha256sum $T/$*.rv2mbc); echo "$${h%% *}" > $@

sidecars = $(patsubst %.mbc,%.rv2mbc.sha256,$(1))

# Public phony targets — one per supported user program.
init:  $T/init.mbc
# Track 2 Phase 2.1 (ADR-081): our own PID 1. Boots via
#   upc-bootctl boot ... --userland target/uinit.mbc
# NOT part of fs.img — it replaces the resident init, not the userland set.
uinit: $T/uinit.mbc
sh:    $T/sh.mbc
ls:    $T/ls.mbc
cat:   $T/cat.mbc
echo:  $T/echo.mbc
wc:    $T/wc.mbc
ln:    $T/ln.mbc
mkdir: $T/mkdir.mbc
kill:  $T/kill.mbc
rm:    $T/rm.mbc
grep:  $T/grep.mbc
# Phase 1.2 Gate 2 isolation proof (ADR-074) — run as the userland directly:
#   upc-bootctl boot ... --userland target/gate2.mbc
gate2: $T/gate2.mbc
# EVOLUTION-1 getpid probes (built by the %.elf pattern rule; named here so
# they are findable): init calls getpid; a forked child calls getpid
# (S-ASCEND-2 Phase 1). Run as the userland directly.
getpidprobe: $T/getpidprobe.mbc
getpidfork: $T/getpidfork.mbc
# S-ASCEND-2 Phase 3 looped-fork gate (a for-loop around fork + wait).
forkloop: $T/forkloop.mbc
# S-ASCEND-2 Phase 7: open("console") by name, write through that fd.
devprobe: $T/devprobe.mbc
# S26 Step 51: xv6 usertests extracted as standalone probes (not gated;
# headers say what each adapts). Run as the userland directly.
ut_exitwait: $T/ut_exitwait.mbc
ut_twochildren: $T/ut_twochildren.mbc
ut_forktest: $T/ut_forktest.mbc
ut_reparent2: $T/ut_reparent2.mbc
# EVOLUTION-1 Stage 2 rung 0 (ADR-109): slot reuse and live slots.
getpidloop: $T/getpidloop.mbc
getpidmulti: $T/getpidmulti.mbc
getpidx: $T/getpidx.mbc
# EVOLUTION-1 Stage 2 rung 2 research (uptime/pause).
uptimeprobe: $T/uptimeprobe.mbc
# Every program the regression harness boots as the userland. Not part of
# USERLAND_PROGS: those are copied into fs.img, and the `ls` golden lists it.
# The ut_* probes ride here to be built and sidecarred; scripts/upc-regression.sh gates them (S26).
GATE_PROGS = $T/uinit.mbc $T/gate2.mbc $T/gate_nway.mbc $T/forkloop.mbc $T/devprobe.mbc $T/getpidfork.mbc \
             $T/ut_exitwait.mbc $T/ut_twochildren.mbc $T/ut_forktest.mbc $T/ut_reparent2.mbc \
             $T/getpidloop.mbc $T/getpidmulti.mbc $T/getpidx.mbc \
             $T/uptimeprobe.mbc
gates: $(GATE_PROGS) $(call sidecars,$(GATE_PROGS))

# Phase 1.2 Gate 4 — N-way CONCURRENT isolation falsification test (ADR-074
# scoped) — run as the userland directly:
#   upc-bootctl boot ... --userland target/gate_nway.mbc
gate_nway: $T/gate_nway.mbc

# Default userland set for the Phase 1.5 shell+5cmds gate
# (ASCEND-LINUX battle plan §1.5). init + sh + 5 commands.
USERLAND_PROGS = $T/init.mbc $T/sh.mbc $T/ls.mbc $T/cat.mbc $T/echo.mbc $T/wc.mbc
userland: $(USERLAND_PROGS) $(call sidecars,$(USERLAND_PROGS))

# Host-native mkfs (x86-64) — rebuilds automatically when mkfs.c changes
# (e.g. the Epic 1.3.1 subdirectory support).
mkfs/mkfs: mkfs/mkfs.c
	gcc -I. -o mkfs/mkfs mkfs/mkfs.c

# Build the xv6-format ramdisk image embedding the default userland.
# mkfs asserts on '/' in bare input filenames; we cd into target/ so the
# basenames are bare. xv6 looks for `/init` (no extension) via namei,
# so strip the .mbc suffix by creating extensionless copies before mkfs.
# A single "dir/name" level IS allowed (Epic 1.3.1 subdir support in mkfs).
# Gate-D demo fixture: a host-authored ASCII file embedded in fs.img so
# `cat README` proves the FS reader walked a real inode (anti-memorization
# control — the exact bytes below cannot be regurgitated by the guest).
$T/fs.img: $(USERLAND_PROGS) mkfs/mkfs
	cd $T && for f in $(notdir $(USERLAND_PROGS)); do cp $$f $${f%.mbc}; done
	printf '%s\n' \
	  'Unheaded UPC -- Phase 1.7 Gate D filesystem reader.' \
	  'If you can read this line, cat() walked a real xv6 inode off' \
	  'fs.img through the eBPF FS walker: superblock -> inode -> data' \
	  'block -> user buffer. ls sees, cat speaks, echo answers.' \
	  'Proof token: 0xGA7ED-D15C-READER. Peace and love.' > $T/README
	@# BIGFILE: >12 KiB so its tail lives in single-indirect blocks (xv6
	@# NDIRECT=12 * 1024 = 12288 B of direct data). The end-marker sits past
	@# that boundary, so `cat BIGFILE` printing it proves read(5) walked the
	@# indirect block, not just the 12 direct pointers (Epic 1.3.1).
	{ for i in $$(seq 1 220); do \
	    printf 'indirect-block filler line %03d ----------------------------------\n' $$i; \
	  done; \
	  printf 'INDIRECT-READ-OK 0xBEEF-PAST-12KIB end of BIGFILE\n'; } > $T/BIGFILE
	@# NOTE lives in sub/ so `cat sub/NOTE` proves open() descended a real
	@# T_DIR dirent (multi-component path walk, Epic 1.3.1) instead of
	@# resolving against the root scan alone.
	mkdir -p $T/sub
	printf '%s\n' \
	  'If you can read this line, open() walked sub -> NOTE across two' \
	  'directory levels inside the eBPF FS walker: root dirent -> T_DIR' \
	  'inode -> sub dirent -> file inode.' \
	  'Proof token: SUBDIR-WALK-OK 0x5UBD1R-PA7H. Peace and love.' > $T/sub/NOTE
	cd $T && ../mkfs/mkfs fs.img init sh ls cat echo wc README BIGFILE sub/NOTE

ramdisk: $T/fs.img $(call sidecars,$(USERLAND_PROGS))

# Each $T/<prog>.* glob also removes that program's .rv2mbc.sha256. No
# $T/*.sha256 glob: the kernel's xv6-mbc.rv2mbc.sha256 lives in $T too.
clean:
	rm -f $U/*.o $U/usys.S
	rm -rf $T/init.* $T/uinit.* $T/sh.* $T/ls.* $T/cat.* $T/echo.* \
	       $T/wc.* $T/ln.* $T/mkdir.* $T/kill.* $T/rm.* $T/grep.* \
	       $T/gate2.* $T/gate_nway.* $T/getpidprobe.* $T/getpidfork.* $T/forkloop.* $T/devprobe.* \
	       $T/ut_exitwait.* $T/ut_twochildren.* $T/ut_forktest.* $T/ut_reparent2.* \
	       $T/getpidloop.* $T/getpidmulti.* $T/getpidx.* $T/uptimeprobe.* \
	       $T/fs.img $T/README $T/BIGFILE $T/sub

.PHONY: clean init uinit sh ls cat echo wc ln mkdir kill rm grep gate2 gate_nway getpidprobe getpidfork forkloop devprobe ut_exitwait ut_twochildren ut_forktest ut_reparent2 getpidloop getpidmulti getpidx uptimeprobe gates userland ramdisk

# Keep .elf intermediates around for debugging.
.SECONDARY: $T/init.elf $T/uinit.elf $T/sh.elf $T/ls.elf $T/cat.elf $T/echo.elf $T/wc.elf
