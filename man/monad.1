.TH MONAD 1 "2026-10-29" "unheaded b06c570c" "Unheaded Kingdom"
.SH NAME
monad \- Serve the Monad HTTP API.
.SH SYNOPSIS
.B monad
[\fIOPTION\fR]...
.SH DESCRIPTION
Serve the Monad HTTP API.
.SH OPTIONS
.TP
.B \-\-debug
Enable debug logging
.TP
.B \-\-json
Output logs in JSON format
.TP
.B \-\-listen \fISTRING\fR
HTTP listen address (default :19004)
.TP
.B \-\-wotan \fISTRING\fR
Wotan HTTP address (host:port); default WOTAN_ADDR, then localhost:18000
.TP
.B \-h, \-\-help
display this help and exit
.TP
.B \-V, \-\-version
output version information and exit
.SH EXAMPLES
.EX
monad
monad \-\-listen :19004
.EE
.SH SEE ALSO
.BR unheaded (1)
